#!/usr/bin/env python3
"""fleet: the home machine's control CLI for the Hostinger VPS fleet.

The Hermes agent on the home machine runs this tool in its terminal, and you can
use it by hand too. Every VPS is reached over SSH, normally through Tailscale.
Standard library only; runs on Windows, Linux and macOS with Python 3.9+.

Everyday
  fleet status [TARGETS] [--json]          worker, queue, disk and provider state
  fleet health [--quiet|--changes-only]    problems only (scheduled checks use this)
  fleet dispatch JOB.json [...] [--to T]   queue jobs on their channel's VPS
  fleet dispatch --prompt "..." --channel C [--to T] [--first]
  fleet jobs [TARGETS] [--state S] [--json]
  fleet logs NODE JOB_ID [-f]              a job's provider log
  fleet cancel NODE JOB_ID                 cancel a queued or running job
  fleet retry NODE JOB_ID [--to T]         queue a copy of a finished or failed job
  fleet handover FROM TO [JOB_ID ...]      move queued jobs to another VPS (only when you ask)
  fleet pull [TARGETS] [--quiet]           download finished jobs into results_dir
  fleet check NODE JOB_ID                  look at a finished job's video again
  fleet report [--hours 24]                the daily report: what was made, what went wrong
  fleet plan show|slots|import|approve|reject|edit|remove|run
                                           the week plan: topics you approve, queued on time
  fleet ideas [add|edit|move|remove]       the ideas list: notes and features for later, best first
  fleet trends [look|go N|drop N|watch|key]
                                           the trend looker: what is rising on YouTube in each
                                           channel's niche; "go N" makes a pitch next on its VPS
  fleet publish NODE JOB_ID --to youtube[,tiktok,instagram]
                                           a YouTube private draft, the TikTok inbox, or (with
                                           --now) an Instagram Reel; --login PLATFORM first
  fleet pause|resume TARGETS               stop or restart taking new jobs
  fleet schedule [show|set|open|close] [TARGETS] [24/7] [--hours 08:00-23:00] [--days mon-fri]
           [--off DAYS] [--cycle 3h/1h] [--gap 45m] [--random 4/day] [--cap 3] [--for 2h]
                                           when each VPS may start jobs; it trumps everything
  fleet studio [--tailnet]                 watch every VPS at work in your browser

Setup and maintenance
  fleet init [--no-hermes]                 set up this home machine (installers call it)
  fleet hermes-cron [--deliver telegram]   create the scheduled Hermes jobs
  fleet doctor                             check this home machine
  fleet list | ping [TARGETS] | ssh-config
  fleet bootstrap NODE [--public]          first-time VPS setup (runs as root)
  fleet lockdown NODE [--undo]             close (or reopen) public SSH
  fleet provider install|check NAME [TARGETS] [--version V] [--smoke]
  fleet secrets push NAME [TARGETS]        copy provider credentials to VPSs
  fleet sync [TARGETS]                     push the repo's vps/ code, restart workers
  fleet restart [TARGETS]                  restart the worker service
  fleet reboot NODE [--force]              reboot a VPS (refuses while jobs run)
  fleet exec TARGETS [--root] -- CMD...    run a shell command
  fleet forget-host NODE                   drop a rebuilt VPS's old SSH host key

TARGETS is "all" (default), a node name such as vps1, or a list: vps1,vps3.
Config: $FLEET_CONFIG or ~/.config/fleet/fleet.ini
"""
from __future__ import annotations

import argparse
import base64
import concurrent.futures as cf
import configparser
import contextlib
import glob
import hashlib
import io
import json
import os
import random
import re
import shlex
import shutil
import socket
import stat
import string
import subprocess
import sys
import tarfile
import threading
import time
from dataclasses import dataclass, field
from datetime import datetime, timedelta, timezone
from pathlib import Path
from urllib.parse import parse_qs, quote, unquote, urlencode, urlparse

VERSION = "1.9.0"
IS_WINDOWS = os.name == "nt"
REPO_ROOT = Path(__file__).resolve().parent.parent.parent
HOME = Path.home()
DEFAULT_CONFIG = Path(os.environ.get("FLEET_CONFIG", str(HOME / ".config" / "fleet" / "fleet.ini"))).expanduser()
STATE_DIR = Path(os.environ.get("FLEET_STATE_DIR", str(HOME / ".config" / "fleet" / "state"))).expanduser()
ID_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$")
NODE_RE = re.compile(r"^[a-z0-9][a-z0-9-]{0,62}$")
NAME_RE = re.compile(r"^[a-z0-9][a-z0-9-]{0,62}$")
MODEL_RE = re.compile(r"^[A-Za-z0-9._:\[\]-]{0,100}$")
ENV_KEY_RE = re.compile(r"^[A-Za-z_][A-Za-z0-9_]*$")
EFFORTS = {"", "low", "medium", "high", "xhigh", "max", "ultracode"}
PERMISSION_MODES = {"", "bypassPermissions", "dontAsk", "acceptEdits"}
TOKEN_WARN_DAYS = 330  # `claude setup-token` tokens last one year
HERMES_PROFILE = "director"  # the Hermes profile that directs the fleet: `hermes -p director`
LIMIT_ALERT_HOURS = 6  # usage-limit holds longer than this (weekly limits) are health problems


class FleetError(Exception):
    pass


# --------------------------------------------------------------------------- config

@dataclass
class Node:
    name: str
    host: str
    public_ip: str = ""
    user: str = "fleet"
    port: int = 22
    hostinger_account: str = ""
    providers: list = field(default_factory=lambda: ["claude"])
    sessions: int = 1
    channels: str = "all"
    enabled: bool = True


@dataclass
class Config:
    path: Path
    remote_root: str
    results_dir: Path
    secrets_dir: Path
    ssh_key: Path
    connect_timeout: int
    transport: str
    nodes: dict
    timezone: str = ""  # [defaults] timezone: the zone `fleet schedule` times are in
    trends_budget: int = 2000  # [defaults] trends_budget: YouTube quota units a day for the trend looker


def _expand(v: str) -> Path:
    return Path(os.path.expandvars(str(v))).expanduser()


def load_config(path: Path = DEFAULT_CONFIG) -> Config:
    if not path.exists():
        raise FleetError(f"no config at {path}. Run `fleet init` (the installers do) or copy home/fleet.ini.example there.")
    cp = configparser.ConfigParser(inline_comment_prefixes=(";", "#"), interpolation=None)
    cp.read(path, encoding="utf-8")
    d = cp["defaults"] if cp.has_section("defaults") else {}
    nodes = {}
    for sec in cp.sections():
        if sec == "defaults":
            continue
        if not NODE_RE.match(sec):
            raise FleetError(f"node name [{sec}] in {path} must be a lowercase hostname like vps1")
        s = cp[sec]
        try:
            nodes[sec] = Node(
                name=sec,
                host=(s.get("host", sec) or sec).strip(),
                public_ip=s.get("public_ip", "").strip(),
                user=s.get("user", d.get("user", "fleet")).strip(),
                port=int(s.get("port", d.get("port", "22"))),
                hostinger_account=s.get("hostinger_account", "").strip(),
                providers=[p.strip() for p in s.get("providers", "claude").split(",") if p.strip()],
                sessions=max(1, int(s.get("sessions", "1"))),
                channels=s.get("channels", "all").strip(),
                enabled=s.getboolean("enabled", True),
            )
        except ValueError as e:
            raise FleetError(f"bad value in [{sec}] of {path}: {e}") from None
    try:
        budget = int(d.get("trends_budget", "").strip() or "2000")
        if budget < 0:
            raise ValueError("it cannot be below 0")
    except ValueError as e:
        raise FleetError(f"bad trends_budget in [defaults] of {path}: {e}. It is the YouTube quota units "
                         "a day the trend looker may use, like 2000") from None
    return Config(
        path=path,
        remote_root=d.get("remote_root", "/home/fleet/fleet"),
        results_dir=_expand(d.get("results_dir", "~/fleet-results")),
        secrets_dir=_expand(d.get("secrets_dir", "~/.config/fleet/secrets")),
        ssh_key=_expand(d.get("ssh_key", "~/.ssh/fleet_ed25519")),
        connect_timeout=int(d.get("connect_timeout", "10")),
        transport=os.environ.get("FLEET_TRANSPORT", d.get("transport", "ssh")),
        nodes=nodes,
        timezone=d.get("timezone", "").strip(),
        trends_budget=budget,
    )


def resolve_targets(cfg: Config, spec, include_disabled: bool = False) -> list:
    if not spec or spec == "all":
        out = [n for n in cfg.nodes.values() if n.enabled or include_disabled]
        if not out:
            raise FleetError("no enabled nodes in the inventory")
        return out
    out = []
    for name in str(spec).split(","):
        name = name.strip()
        if name not in cfg.nodes:
            raise FleetError(f"unknown node '{name}' (known: {', '.join(cfg.nodes) or 'none'})")
        out.append(cfg.nodes[name])
    return out


def channel_key(name) -> str:
    """How channel names are compared: "Space Facts", "space-facts" and "SPACE_FACTS" are one channel."""
    s = str(name).strip().casefold()
    return re.sub(r"[\W_]+", "-", s).strip("-") or s


def channel_names(n: Node) -> list:
    """The channels a VPS makes videos for, as fleet.ini lists them. "all" means any channel."""
    return [c.strip() for c in n.channels.split(",") if c.strip()]


def serves(n: Node, channel: str) -> bool:
    keys = {channel_key(c) for c in channel_names(n)}
    return channel_key(channel) in keys or "all" in keys


def channel_home(pool: list, channel: str):
    """Where a channel's jobs go, as (nodes, dedicated): the VPSs whose `channels` list
    names it (dedicated), else the VPSs with `channels = all`."""
    key = channel_key(channel)
    own = [n for n in pool if key in {channel_key(c) for c in channel_names(n)}]
    if own:
        return own, True
    return [n for n in pool if "all" in {channel_key(c) for c in channel_names(n)}], False


def dedicated_channels(n: Node) -> list:
    return [c for c in channel_names(n) if channel_key(c) != "all"]


# --------------------------------------------------------------------------- transport

def ssh_binary() -> str:
    if IS_WINDOWS:
        # Prefer Windows' own OpenSSH over Git's copy so behaviour is predictable.
        win = Path(os.environ.get("SystemRoot", r"C:\Windows")) / "System32" / "OpenSSH" / "ssh.exe"
        if win.exists():
            return str(win)
    found = shutil.which("ssh")
    if not found:
        raise FleetError("ssh not found. Windows: Settings > System > Optional features > OpenSSH Client.")
    return found


def ssh_options(cfg: Config, node: Node) -> list:
    opts = [
        "-o", "BatchMode=yes",
        "-o", f"ConnectTimeout={cfg.connect_timeout}",
        "-o", "StrictHostKeyChecking=accept-new",
        "-o", "ServerAliveInterval=30",
        "-o", "ServerAliveCountMax=4",
        "-p", str(node.port),
    ]
    if not IS_WINDOWS:  # Windows OpenSSH has no connection multiplexing
        control = HOME / ".ssh" / "cm"
        control.mkdir(parents=True, exist_ok=True, mode=0o700)
        opts += ["-o", "ControlMaster=auto", "-o", f"ControlPath={control}/%C", "-o", "ControlPersist=120"]
    if cfg.ssh_key.exists():
        opts += ["-i", str(cfg.ssh_key), "-o", "IdentitiesOnly=yes"]
    return opts


def wrap_remote(command: str) -> str:
    """Encode a shell script so it survives any local quoting rules (cmd.exe,
    PowerShell, list2cmdline) and runs in a login bash on the VPS. Only
    [A-Za-z0-9+/=] travel inside the payload; stdin stays free for data."""
    b64 = base64.b64encode(command.encode("utf-8")).decode("ascii")
    return (f"f=$(mktemp /tmp/fleet-cmd.XXXXXX) && printf %s {b64} | base64 -d > $f && "
            f"bash -l $f; rc=$?; rm -f $f; exit $rc")


def remote(cfg: Config, node: Node, command: str, *, stdin: bytes = None, user: str = None,
           host: str = None, timeout=300, capture: bool = True, stdout=None) -> subprocess.CompletedProcess:
    """Run a bash script on a node (local transport exists for tests)."""
    if cfg.transport == "local":
        env = dict(os.environ, FLEET_ROOT=root_of(cfg, node), FLEET_NODE=node.name)
        argv = ["bash", "-c", command]
    else:
        env = None
        argv = [ssh_binary()] + ssh_options(cfg, node) + [f"{user or node.user}@{host or node.host}",
                                                           wrap_remote(command)]
    out = stdout if stdout is not None else (subprocess.PIPE if capture else None)
    err = subprocess.PIPE if capture else None
    try:
        return subprocess.run(argv, input=stdin, env=env, timeout=timeout, stdout=out, stderr=err,
                              stdin=None if stdin is not None else subprocess.DEVNULL)
    except subprocess.TimeoutExpired:
        return subprocess.CompletedProcess(argv, 124, b"", b"timed out")
    except FileNotFoundError as e:
        raise FleetError(f"cannot run {argv[0]}: {e}") from None


def root_of(cfg: Config, node: Node) -> str:
    return cfg.remote_root.replace("{node}", node.name)


def worker(cfg: Config, node: Node) -> str:
    return shlex.quote(f"{root_of(cfg, node)}/app/worker/fleet-worker")


def parallel(nodes: list, fn, max_workers: int = 8) -> dict:
    out = {}
    with cf.ThreadPoolExecutor(max_workers=max_workers) as ex:
        futs = {ex.submit(fn, n): n.name for n in nodes}
        for f in cf.as_completed(futs):
            try:
                out[futs[f]] = f.result()
            except Exception as e:  # report per node, never crash the whole run
                out[futs[f]] = e
    return {n.name: out[n.name] for n in nodes}


def text(b) -> str:
    return (b or b"").decode("utf-8", "replace").strip()


def last_json(b, default=None):
    """The worker prints one JSON document on its last line; anything a login
    shell printed before it is ignored."""
    for line in reversed(text(b).splitlines()):
        line = line.strip()
        if line:
            try:
                return json.loads(line)
            except ValueError:
                break
    if default is not None:
        return default
    raise ValueError("no JSON in output")


def tar_dir(src: Path) -> bytes:
    """Pack a folder for a VPS. Text files are normalised to LF so a Windows
    checkout with CRLF line endings still produces runnable bash scripts."""
    buf = io.BytesIO()
    with tarfile.open(fileobj=buf, mode="w:gz") as tf:
        for p in sorted(src.rglob("*")):
            rel = p.relative_to(src).as_posix()
            if p.name.endswith(".env") or "__pycache__" in rel or p.name.startswith(".DS_Store"):
                continue
            ti = tarfile.TarInfo(rel)
            ti.mtime = int(p.stat().st_mtime)
            ti.uid = ti.gid = 0
            if p.is_dir():
                ti.type, ti.mode = tarfile.DIRTYPE, 0o755
                tf.addfile(ti)
                continue
            if not p.is_file():
                continue
            data = p.read_bytes()
            if b"\0" not in data[:8192]:
                data = data.replace(b"\r\n", b"\n")
            executable = data.startswith(b"#!") or p.suffix == ".sh" or (p.stat().st_mode & 0o111)
            ti.mode = 0o755 if executable else 0o644
            ti.size = len(data)
            tf.addfile(ti, io.BytesIO(data))
    return buf.getvalue()


def now_iso() -> str:
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def print_table(rows) -> None:
    widths = [max(len(str(r[i])) for r in rows) for i in range(len(rows[0]))]
    for r in rows:
        print("  ".join(str(c).ljust(w) for c, w in zip(r, widths)).rstrip())


def private_file(path: Path) -> bool:
    if IS_WINDOWS:  # NTFS ACLs: `fleet init` restricts the folder to your user
        return True
    return not (path.stat().st_mode & (stat.S_IRWXG | stat.S_IRWXO))


# --------------------------------------------------------------------------- status & health

def fetch_status(cfg: Config, n: Node) -> dict:
    r = remote(cfg, n, f"{worker(cfg, n)} status --json", timeout=60)
    if r.returncode != 0:
        return {"node": n.name, "reachable": False, "error": text(r.stderr)[-300:] or f"exit {r.returncode}"}
    try:
        st = last_json(r.stdout)
        if not isinstance(st, dict) or "queue" not in st:
            raise ValueError
    except ValueError:
        return {"node": n.name, "reachable": False, "error": "worker returned no status (run `fleet sync`)"}
    st["reachable"] = True
    st["node"] = n.name
    return st


def cmd_status(cfg: Config, a) -> int:
    nodes = resolve_targets(cfg, a.targets)
    res = parallel(nodes, lambda n: fetch_status(cfg, n))
    if a.json:
        print(json.dumps(list(res.values()), indent=2, default=str))
        return 0
    rows = [("NODE", "SERVICE", "QUEUED", "RUNNING", "DONE", "FAILED", "UNPULLED", "DISK FREE", "LOAD", "PROVIDERS")]
    for name, st in res.items():
        if isinstance(st, Exception) or not st.get("reachable"):
            err = st if isinstance(st, Exception) else st.get("error")
            rows.append((name, "UNREACHABLE", "-", "-", "-", "-", "-", "-", "-", str(err).replace("\n", " ")[:70]))
            continue
        q = st["queue"]
        wanted = cfg.nodes[name].providers
        reports = {p.get("provider"): p for p in st.get("providers", [])}
        prov = " ".join(f"{w}:{provider_word(reports.get(w))}" for w in wanted) or "none"
        if st.get("reboot_required"):
            prov += " (reboot pending)"
        service = st.get("service", "?") + (" PAUSED" if st.get("paused") else "")
        if active_limit(st):
            service += f" LIMIT until {short_time(st['limit'].get('until'))}"
        sch = schedule_hold(st)
        if sch:
            service += f" OFF DUTY until {short_time(sch['until'])}" if sch.get("until") else " OFF DUTY"
        rows.append((name, service, q["inbox"], f"{q['running']}/{st.get('max_parallel', '?')}",
                     q["done"], q["failed"], q["unpulled"], f"{st.get('disk_free_gb')} GB ({st.get('disk_free_pct')}%)",
                     st.get("load1"), prov))
    print_table(rows)
    return 0


def active_limit(st) -> dict:
    """The node's usage-limit hold ({provider, kind, message, until, ...}) while it lasts, else {}."""
    lim = st.get("limit") if isinstance(st, dict) else None
    if isinstance(lim, dict) and number(lim.get("until"), 0) > time.time():
        return lim
    return {}


def short_time(epoch) -> str:
    """A reset time as the owner reads it: local time, with the date when it is not today."""
    t = datetime.fromtimestamp(number(epoch, 0))
    return t.strftime("%H:%M" if t.date() == datetime.now().date() else "%a %d %b %H:%M")


def number(v, default: float) -> float:
    """A number from a worker status field, or the default when it is missing or odd."""
    if isinstance(v, bool):
        return default
    try:
        return float(v)
    except (TypeError, ValueError):
        return default


def provider_word(rep) -> str:
    if not rep or not rep.get("installed"):
        return "not-installed"
    return "ok" if rep.get("ok") else "BAD"


HEALTH_DEFAULTS = argparse.Namespace(min_disk_pct=15, max_backlog=25)


def health_problems(cfg: Config, a=HEALTH_DEFAULTS, statuses=None) -> dict:
    nodes = resolve_targets(cfg, None)
    res = statuses if statuses is not None else parallel(nodes, lambda n: fetch_status(cfg, n))
    problems = {}
    for name, st in res.items():
        if isinstance(st, Exception):
            problems[f"{name}:check"] = f"{name}: health check crashed: {st}"
            continue
        if not st.get("reachable"):
            problems[f"{name}:unreachable"] = f"{name}: unreachable ({st.get('error', '')[:160]})"
            continue
        hb = st.get("heartbeat_age_s")
        if st.get("service") not in ("active", "unknown"):
            problems[f"{name}:service"] = f"{name}: fleet-worker service is {st.get('service')} (fleet restart {name})"
        elif isinstance(hb, int) and (hb < 0 or hb > 180):
            problems[f"{name}:heartbeat"] = (f"{name}: the worker loop is not running "
                                             f"(no heartbeat {'yet' if hb < 0 else f'for {hb}s'}; fleet restart {name})")
        if st.get("paused"):
            problems[f"{name}:paused"] = f"{name}: paused, not starting new jobs (fleet resume {name})"
        if st.get("low_disk") or number(st.get("disk_free_pct"), 100) < a.min_disk_pct:
            stop = ", new jobs are on hold" if st.get("low_disk") else ""
            problems[f"{name}:disk"] = (f"{name}: low disk, {st.get('disk_free_gb')} GB free "
                                        f"({st.get('disk_free_pct')}%){stop}; run fleet pull, then see the disk-full runbook")
        reports = {p.get("provider"): p for p in st.get("providers", [])}
        for prov in cfg.nodes[name].providers:
            rp = reports.get(prov)
            if not rp or not rp.get("installed"):
                problems[f"{name}:provider:{prov}"] = f"{name}: {prov} is not installed (fleet provider install {prov} {name})"
            elif not rp.get("ok"):
                problems[f"{name}:provider:{prov}"] = f"{name}: {prov} not ok: {rp.get('error')}"
            elif rp.get("auth") == "oauth-token" and (rp.get("credential_age_days") or 0) >= TOKEN_WARN_DAYS:
                problems[f"{name}:token-age:{prov}"] = (
                    f"{name}: the {prov} subscription token was pushed {rp['credential_age_days']} days ago and "
                    f"expires after a year; make a new one (see the rotate-credentials runbook)")
        if number(st["queue"].get("inbox"), 0) > a.max_backlog:
            problems[f"{name}:backlog"] = f"{name}: {st['queue']['inbox']} jobs waiting in the queue"
        if st.get("reboot_required"):
            problems[f"{name}:reboot"] = f"{name}: security updates need a reboot (fleet reboot {name} when idle)"
        lim = active_limit(st)
        if lim and number(lim.get("until"), 0) - number(lim.get("since"), 0) > LIMIT_ALERT_HOURS * 3600:
            own = dedicated_channels(cfg.nodes[name])
            meanwhile = (f"new {', '.join(own)} jobs wait there too, unless you move them with fleet handover"
                         if own else "fleet dispatch sends new jobs to other VPSs meanwhile")
            problems[f"{name}:limit"] = (
                f"{name}: {lim.get('provider', 'provider')} usage limit reached ({lim.get('message', '')}); "
                f"its queue waits until {short_time(lim.get('until'))} and then continues by itself ({meanwhile})")
        sch = st.get("schedule") if isinstance(st.get("schedule"), dict) else {}
        if sch.get("error"):
            problems[f"{name}:schedule"] = (f"{name}: its schedule could not be read ({sch['error']}), so no new job "
                                            f"starts there; set it again (fleet schedule show {name})")
        elif sch.get("open") is False and not sch.get("until") and number(st["queue"].get("inbox"), 0):
            problems[f"{name}:schedule"] = (f"{name}: {st['queue']['inbox']} job(s) wait, but its schedule has no work "
                                            f"time in the next 60 days ({sch.get('reason')}; fleet schedule show {name})")
        stuck = int(number(st.get("stuck_handovers"), 0))
        if stuck:
            problems[f"{name}:handover"] = (
                f"{name}: {stuck} job(s) stopped halfway through a handover; run the same fleet handover "
                f"again to finish it (fleet jobs {name} --state outgoing shows where they were going)")
    return problems


def cmd_health(cfg: Config, a) -> int:
    problems = health_problems(cfg, a)
    if not a.changes_only:
        if problems:
            print(f"Fleet health: {len(problems)} problem(s)\n- " + "\n- ".join(problems.values()))
            return 2
        if not a.quiet:
            print(f"Fleet health: all {len(resolve_targets(cfg, None))} nodes OK")
        return 0
    # --changes-only: alert on new and resolved problems, remind about open ones.
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    sf = STATE_DIR / "health.json"
    try:
        prev = json.loads(sf.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        prev = {"open": {}, "last_alert": 0}
    opened = {k: v for k, v in problems.items() if k not in prev.get("open", {})}
    resolved = {k: v for k, v in prev.get("open", {}).items() if k not in problems}
    now = time.time()
    remind = bool(problems) and now - prev.get("last_alert", 0) >= a.remind_hours * 3600
    lines = []
    if opened or remind:
        lines.append(f"Fleet health: {len(problems)} open problem(s)")
        lines += [("NEW  " if k in opened else "STILL ") + v for k, v in problems.items()]
    if resolved:
        lines.append("Resolved:" if lines else "Fleet health: resolved")
        lines += ["OK   " + v for v in resolved.values()]
    state = {"open": problems, "last_alert": now if lines else prev.get("last_alert", 0), "checked": now}
    sf.write_text(json.dumps(state, indent=2), encoding="utf-8")
    if lines:
        print("\n".join(lines))
    return 0


# --------------------------------------------------------------------------- jobs

def make_job_id(channel: str) -> str:
    slug = re.sub(r"[^a-z0-9]+", "-", channel.lower()).strip("-")[:40] or "job"
    rnd = "".join(random.choices(string.ascii_lowercase + string.digits, k=5))
    return f"{datetime.now(timezone.utc).strftime('%Y%m%d-%H%M%S')}-{slug}-{rnd}"


def validate_job(job: dict, where: str = "job") -> dict:
    def bad(msg):
        raise FleetError(f"{where}: {msg}")
    if not isinstance(job, dict):
        bad("must be a JSON object")
    if not isinstance(job.get("prompt"), str) or not job["prompt"].strip():
        bad("needs a non-empty \"prompt\"")
    job.setdefault("provider", "claude")
    job.setdefault("channel", "general")
    if not NAME_RE.match(str(job["provider"])):
        bad(f"invalid provider {job['provider']!r}")
    if not isinstance(job["channel"], str) or not job["channel"].strip():
        bad("\"channel\" must be a non-empty string")
    if "id" in job and not ID_RE.match(str(job["id"])):
        bad(f"invalid id {job['id']!r} (letters, digits, . _ - only)")
    for key, lo, hi in (("max_turns", 1, 10000), ("timeout_minutes", 1, 1440), ("max_retries", 0, 5)):
        if key in job and (not isinstance(job[key], int) or isinstance(job[key], bool) or not lo <= job[key] <= hi):
            bad(f"\"{key}\" must be a whole number from {lo} to {hi}")
    if "max_budget_usd" in job and (not isinstance(job["max_budget_usd"], (int, float)) or job["max_budget_usd"] <= 0):
        bad("\"max_budget_usd\" must be a positive number")
    if not MODEL_RE.match(str(job.get("model", ""))):
        bad(f"invalid model {job.get('model')!r}")
    if str(job.get("effort", "")) not in EFFORTS:
        bad(f"\"effort\" must be one of {', '.join(sorted(e for e in EFFORTS if e))}")
    if str(job.get("permission_mode", "")) not in PERMISSION_MODES:
        bad(f"\"permission_mode\" must be one of {', '.join(sorted(m for m in PERMISSION_MODES if m))}")
    for key in ("title", "channel"):
        if key in job and (not isinstance(job[key], str) or len(job[key]) > 200):
            bad(f"\"{key}\" must be text of at most 200 characters")
    if "template" in job and not NAME_RE.match(str(job["template"])):
        bad(f"invalid template {job['template']!r}")
    tools = job.get("allowed_tools")
    if tools is not None and not (isinstance(tools, str) or (isinstance(tools, list) and all(isinstance(t, str) for t in tools))):
        bad("\"allowed_tools\" must be a string or a list of strings")
    if "checks" in job and job["checks"] is not False and not isinstance(job["checks"], dict):
        bad("\"checks\" must be false or an object like {\"min_seconds\": 45, \"vertical\": true}")
    files = job.get("files", [])
    if not isinstance(files, list):
        bad("\"files\" must be a list")
    for f in files:
        p = f.get("path", "") if isinstance(f, dict) else ""
        if not p or p.startswith(("/", "\\")) or ".." in Path(p).parts or ":" in p:
            bad(f"unsafe or missing file path {p!r} (use a relative path inside the workspace)")
        if not isinstance(f.get("content"), str):
            bad(f"file {p!r} needs string \"content\"")
        if f.get("encoding", "utf-8") not in ("utf-8", "base64"):
            bad(f"file {p!r}: encoding must be utf-8 or base64")
    return job


def expand_job_files(paths: list) -> list:
    """Expand ~ and wildcards such as ~/fleet-jobs/*.json. Bash does it before `fleet`
    starts, but PowerShell and cmd pass them through unchanged."""
    out = []
    for fp in map(os.path.expanduser, paths):
        if any(ch in fp for ch in "*?[") and not Path(fp).exists():
            matches = sorted(glob.glob(fp))
            if not matches:
                raise FleetError(f"{fp}: no file matches")
            out += matches
        else:
            out.append(fp)
    return out


def load_jobs(a) -> list:
    jobs = []
    if a.job_files:
        for fp in expand_job_files(a.job_files):
            p = Path(fp)
            try:
                job = json.loads(p.read_text(encoding="utf-8-sig"))
                if isinstance(job, dict) and "prompt_file" in job and "prompt" not in job:
                    job["prompt"] = (p.parent / job.pop("prompt_file")).read_text(encoding="utf-8-sig")
            except (OSError, ValueError) as e:
                raise FleetError(f"{p}: {e}") from None
            jobs.append((str(p), job))
    elif a.prompt:
        jobs.append(("--prompt", {"prompt": a.prompt}))
    else:
        raise FleetError("give one or more job files, or --prompt \"...\"")
    out = []
    for where, job in jobs:
        if isinstance(job, dict):
            if a.channel:
                job["channel"] = a.channel
            if a.provider:
                job["provider"] = a.provider
        out.append(validate_job(job, where))
    return out


# The worker starts the inbox's oldest file first. A job that a usage limit stopped goes back
# dated 2000-01-01 00:00:00 UTC (946684800), so it goes on first; a job sent with --first is
# dated one second later, so it starts next, before every other job in the queue.
FIRST_MTIME = 946684801


def upload_job(cfg: Config, n: Node, job: dict, first: bool = False) -> None:
    root, jid = shlex.quote(root_of(cfg, n)), job["id"]
    cmd = (f"set -e; r={root}; id={jid}\n"
           f"if [ -e \"$r/work/$id\" ] || ls \"$r\"/jobs/*/\"$id\".json >/dev/null 2>&1; then\n"
           f"  echo \"job id $id already exists on {n.name}\" >&2; exit 3; fi\n"
           f"mkdir -p \"$r/jobs/inbox\"\n"
           f"cat > \"$r/jobs/inbox/.$id.tmp\"\n"
           + (f"touch -d '@{FIRST_MTIME}' \"$r/jobs/inbox/.$id.tmp\" || true\n" if first else "")
           + "mv \"$r/jobs/inbox/.$id.tmp\" \"$r/jobs/inbox/$id.json\"\n")
    r = remote(cfg, n, cmd, stdin=json.dumps(job, indent=2).encode("utf-8"), timeout=60)
    if r.returncode != 0:
        raise FleetError(f"{n.name}: could not queue {jid}: {text(r.stderr) or 'exit ' + str(r.returncode)}")


def cmd_dispatch(cfg: Config, a) -> int:
    return dispatch_jobs(cfg, load_jobs(a), a.to or "auto", a.dry_run, a.json, first=a.first)


LIMIT_WORDS = "at its usage limit"


def node_readiness(st, provider: str):
    """None when the node can start a job for this provider right now, else why not."""
    if not isinstance(st, dict) or not st.get("reachable"):
        return "unreachable"
    if st.get("service") not in ("active", "unknown"):
        return f"its worker service is {st.get('service')}"
    if st.get("paused"):
        return "paused"
    if st.get("low_disk"):
        return "low on disk"
    rep = {p.get("provider"): p for p in st.get("providers", [])}.get(provider)
    if not rep or not rep.get("installed"):
        return f"{provider} is not installed"
    if not rep.get("ok"):
        return f"{provider} is not ok ({rep.get('error')})"
    lim = active_limit(st)
    if lim:
        return f"{LIMIT_WORDS} until {short_time(lim.get('until'))}"
    sch = schedule_hold(st)
    if sch:
        return f"{SCHEDULE_WORDS} ({sch.get('reason') or 'off duty'})"
    return None


def free_at(st) -> float:
    """When a waiting node can start a job: after its usage limit and its schedule's hold."""
    sch = schedule_hold(st)
    if sch and not sch.get("until"):
        return float("inf")
    return max(number(active_limit(st).get("until"), 0), number(sch.get("until"), 0))


def provider_broken(why, provider: str) -> bool:
    """True when node_readiness says the provider itself cannot run jobs there: such a
    job would not wait in the queue, it would fail."""
    return bool(why) and why.startswith(f"{provider} is not")


def dispatch_jobs(cfg: Config, jobs: list, spec: str, dry_run: bool, as_json: bool, first: bool = False) -> int:
    """auto: the VPS that makes videos for the job's channel (`channels` in
    fleet.ini; the least busy one when several do). The job waits there when that
    VPS is busy, paused or at its usage limit: work never moves to another VPS by
    itself, only with `fleet handover`. It is refused when the provider there is not
    installed or has no credentials, because it would only fail. A channel that no
    VPS names goes to the least busy ready VPS with `channels = all`. all: a copy on
    every VPS. A node list: the least busy ready node in the list (or, if none is
    ready, it still queues there and warns, because you asked for those nodes). first: each
    job starts before the others in its VPS's queue."""
    explicit = spec not in ("auto", "all")
    pool = resolve_targets(cfg, spec if explicit else None)
    status = {} if dry_run else parallel(pool, lambda n: fetch_status(cfg, n))
    loads = {}
    for n in pool:
        st = status.get(n.name)
        if isinstance(st, dict) and st.get("reachable"):
            q = st["queue"]
            busy = number(q.get("inbox"), 0) + number(q.get("running"), 0)
            loads[n.name] = [busy, max(1, int(number(st.get("max_parallel"), n.sessions)))]
    queued, rc = [], 0
    for job in jobs:
        prov, ch = job["provider"], job["channel"]
        label = job.get("id") or job.get("title") or ch
        home, dedicated = (pool, False) if spec != "auto" else channel_home(pool, ch)
        if not home:
            print(f"fleet: {label}: no VPS makes videos for channel '{ch}'. Add the channel to `channels` of "
                  f"its VPS in {cfg.path}, or name a VPS with --to", file=sys.stderr)
            rc = 1
            continue
        candidates = [n for n in home if prov in n.providers]
        if not candidates:
            where = (f"channel '{ch}' is made on {', '.join(n.name for n in home)}, which does not offer"
                     if dedicated else "no enabled node in the inventory offers")
            print(f"fleet: {label}: {where} provider '{prov}'", file=sys.stderr)
            rc = 1
            continue
        base_id = job.get("id") or make_job_id(ch)
        if dry_run:
            targets = candidates if spec == "all" else candidates[:1]
        elif spec == "all":
            targets = [n for n in candidates if n.name in loads]
            for n in candidates:
                if n.name not in loads:
                    print(f"fleet: {n.name} is unreachable; no copy of {label} was queued there", file=sys.stderr)
                    rc = 1
        else:
            reachable = [n for n in candidates if n.name in loads]
            ready = [n for n in reachable if node_readiness(status.get(n.name), prov) is None]
            # A channel's own VPS keeps the channel's jobs while it is busy, paused or at its
            # limit. A job sent to a VPS whose provider is broken would only fail.
            waits = [n for n in reachable if not provider_broken(node_readiness(status.get(n.name), prov), prov)]
            pickable = ready or (reachable if explicit else waits if dedicated else [])
            if not pickable:
                # Every shared VPS waits for a usage limit or its schedule: queue where the wait ends first.
                waiting = [n for n in reachable
                           if (node_readiness(status.get(n.name), prov) or "").startswith((LIMIT_WORDS, SCHEDULE_WORDS))]
                if waiting:
                    pickable = [min(waiting, key=lambda n: free_at(status.get(n.name)))]
            if not pickable:
                why = "; ".join(f"{n.name} {node_readiness(status.get(n.name), prov)}" for n in candidates)
                whose = f"channel '{ch}' is made on {', '.join(n.name for n in candidates)}, and " if dedicated else ""
                print(f"fleet: {label}: {whose}no VPS can take a {prov} job right now ({why}). Run `fleet health`.",
                      file=sys.stderr)
                rc = 1
                continue
            best = min(pickable, key=lambda n: (loads[n.name][0] / loads[n.name][1], n.name))
            loads[best.name][0] += 1
            targets = [best]
        for n in targets:
            j = dict(job, id=base_id if len(targets) == 1 else f"{base_id}-{n.name}", node=n.name,
                     submitted_at=now_iso())
            if dry_run:
                print(json.dumps(j, indent=2))
                continue
            why = node_readiness(status.get(n.name), prov)
            if provider_broken(why, prov):
                print(f"warning: {n.name}: {why}; {j['id']} fails if that is not fixed before it starts",
                      file=sys.stderr)
            elif why:
                until = ("the limit resets" if why.startswith(LIMIT_WORDS) else
                         "its schedule lets it start" if why.startswith(SCHEDULE_WORDS) else "that is fixed")
                print(f"warning: {n.name}: {why}; {j['id']} waits in its queue until {until}", file=sys.stderr)
            if explicit and not serves(n, ch):
                print(f"note: {n.name} does not make videos for channel '{ch}' (its channels: "
                      f"{n.channels or 'none'}); the job goes there because you named it", file=sys.stderr)
            try:
                upload_job(cfg, n, j, first)
            except FleetError as e:
                print(f"fleet: {e}", file=sys.stderr)
                rc = 1
                continue
            queued.append({"node": n.name, "id": j["id"], "channel": j["channel"]})
            if not as_json:
                print(f"queued {j['id']} on {n.name} (channel {j['channel']}, provider {j['provider']})"
                      + (", first in its queue" if first else ""))
    if as_json:
        print(json.dumps(queued))
    return rc


def fetch_jobs(cfg: Config, nodes: list, state: str = "") -> tuple:
    """(every job on these nodes, each with its node's name; the nodes that did not answer)."""
    opt = f" --state {shlex.quote(state)}" if state else ""
    res = parallel(nodes, lambda n: remote(cfg, n, f"{worker(cfg, n)} jobs --json{opt}", timeout=60))
    all_jobs, silent = [], []
    for name, r in res.items():
        if isinstance(r, Exception) or r.returncode != 0:
            silent.append(name)
            continue
        for j in last_json(r.stdout, []):
            if isinstance(j, dict) and "id" in j:
                j["node"] = name
                all_jobs.append(j)
    return all_jobs, silent


def cmd_jobs(cfg: Config, a) -> int:
    all_jobs, silent = fetch_jobs(cfg, resolve_targets(cfg, a.targets), a.state or "")
    for name in silent:
        print(f"{name}: unreachable", file=sys.stderr)
    rc = 1 if silent else 0
    if a.json:
        print(json.dumps(all_jobs, indent=2))
        return rc
    rows = [("NODE", "STATE", "ID", "CHANNEL", "STARTED", "FINISHED", "NOTE")]
    for j in all_jobs:
        note = " ".join(x for x in (j.get("reason") or "", check_line(j.get("check")),
                                    "(pulled)" if j.get("pulled") else "") if x)
        rows.append((j["node"], j["state"], j["id"], j.get("channel") or "-", j.get("started_at") or "-",
                     j.get("finished_at") or "-", note))
    if len(rows) > 1:
        print_table(rows)
    else:
        print("no jobs")
    return rc


def one_node(cfg: Config, name: str) -> Node:
    nodes = resolve_targets(cfg, name, include_disabled=True)
    if len(nodes) != 1:
        raise FleetError("name exactly one node")
    return nodes[0]


def cmd_logs(cfg: Config, a) -> int:
    n = one_node(cfg, a.node)
    if not ID_RE.match(a.job_id):
        raise FleetError("invalid job id")
    follow = " -f" if a.follow else ""
    return remote(cfg, n, f"{worker(cfg, n)} logs {a.job_id}{follow}", capture=False, timeout=None).returncode


def cmd_cancel(cfg: Config, a) -> int:
    n = one_node(cfg, a.node)
    if not ID_RE.match(a.job_id):
        raise FleetError("invalid job id")
    r = remote(cfg, n, f"{worker(cfg, n)} cancel {a.job_id}")
    print(text(r.stdout) or text(r.stderr))
    return r.returncode


def cmd_retry(cfg: Config, a) -> int:
    n = one_node(cfg, a.node)
    if not ID_RE.match(a.job_id):
        raise FleetError("invalid job id")
    r = remote(cfg, n, f"cat {shlex.quote(root_of(cfg, n))}/work/{a.job_id}/job.json", timeout=60)
    if r.returncode != 0:
        raise FleetError(f"{n.name}: no workspace for job {a.job_id} (it may have been cleaned up)")
    try:
        job = json.loads(text(r.stdout))
    except ValueError:
        raise FleetError(f"{n.name}: job {a.job_id} has an unreadable job.json") from None
    for k in ("node", "submitted_at", "id"):
        job.pop(k, None)
    m = re.match(r"^(.*)-r(\d+)$", a.job_id)
    base, k = (m.group(1), int(m.group(2)) + 1) if m else (a.job_id, 1)
    job["id"] = f"{base[:120]}-r{k}"
    job["retry_of"] = a.job_id
    for key in ("handed_over_from", "handed_over_at", "handover"):
        job.pop(key, None)
    return dispatch_jobs(cfg, [validate_job(job, a.job_id)], a.to or n.name, False, False)


def receive_handover(cfg: Config, n: Node, job: dict) -> str:
    """Queue a handed-over job on n. Answers "queued", "already" when an earlier try
    that broke halfway delivered it, or "taken" when n has another job with that id."""
    root, jid = shlex.quote(root_of(cfg, n)), job["id"]
    frm, token = shlex.quote(job["handed_over_from"]), shlex.quote(job["handed_over_at"])
    cmd = (f"set -e; r={root}; id={jid}\n"
           f"for f in \"$r\"/jobs/*/\"$id\".json; do\n"
           f"  [ -e \"$f\" ] || continue\n"
           f"  if jq -e --arg f {frm} --arg t {token} '.handed_over_from == $f and .handed_over_at == $t' \"$f\" "
           f">/dev/null 2>&1; then echo already; else echo taken; fi\n"
           f"  exit 0\n"
           f"done\n"
           f"if [ -e \"$r/work/$id\" ]; then echo taken; exit 0; fi\n"
           f"mkdir -p \"$r/jobs/inbox\"\n"
           f"cat > \"$r/jobs/inbox/.$id.tmp\"\n"
           f"mv \"$r/jobs/inbox/.$id.tmp\" \"$r/jobs/inbox/$id.json\"\n"
           f"echo queued\n")
    r = remote(cfg, n, cmd, stdin=json.dumps(job, indent=2).encode("utf-8"), timeout=60)
    said = (text(r.stdout).splitlines() or [""])[-1].strip()
    if r.returncode != 0 or said not in ("queued", "already", "taken"):
        raise FleetError(text(r.stderr)[-300:] or f"exit {r.returncode}")
    return said


def hand_over(cfg: Config, frm: Node, to: Node, jid: str) -> str:
    """Move one queued job from frm to to and say what happened. It keeps its id
    unless to already has a job by that name. Raises FleetError when the job stays."""
    w = worker(cfg, frm)
    r = remote(cfg, frm, f"{w} release {jid} {to.name}", timeout=60)
    if r.returncode != 0:
        raise FleetError(f"{jid} stays on {frm.name}: {text(r.stderr) or 'exit ' + str(r.returncode)}")
    try:
        job = last_json(r.stdout)
        ho = job.pop("handover")
        token = str(ho["at"])
    except (ValueError, KeyError, TypeError, AttributeError):
        remote(cfg, frm, f"{w} unrelease {jid}", timeout=60)
        raise FleetError(f"{jid} stays on {frm.name}: its job file could not be read") from None
    j = dict(job, node=to.name, handed_over_from=frm.name, handed_over_at=token)
    base = re.sub(r"-h\d+$", "", jid)[:120]
    try:
        for k in range(10):
            j["id"] = jid if k == 0 else f"{base}-h{k}"
            said = receive_handover(cfg, to, j)
            if said != "taken":
                break
        else:
            raise FleetError(f"it already has jobs called {jid} and {base}-h1 to -h9")
    except FleetError as e:
        u = remote(cfg, frm, f"{w} unrelease {jid}", timeout=60)
        back = "" if u.returncode == 0 else (f". {frm.name} could not put it back in its queue either: run the same "
                                             f"fleet handover again (fleet health reminds you)")
        raise FleetError(f"{jid} stays on {frm.name}: could not queue it on {to.name}: {e}{back}") from None
    renamed = f" as {j['id']} ({to.name} already had a job called {jid})" if j["id"] != jid else ""
    line = f"moved {jid} (channel {j.get('channel')}) from {frm.name} to {to.name}{renamed}"
    if ho.get("started"):
        line += (f"\n    it had started on {frm.name}, so it starts over on {to.name}; "
                 f"what it made on {frm.name} comes home with the next fleet pull")
    r = remote(cfg, frm, f"{w} released {jid}", timeout=60)
    if r.returncode != 0:
        raise FleetError(f"{jid} is queued on {to.name}{renamed}, but {frm.name} did not confirm. Run the same "
                         f"fleet handover again to finish (the job cannot run twice meanwhile)")
    return line


def cmd_handover(cfg: Config, a) -> int:
    """Move queued jobs from one VPS to another. Only the owner decides this: nothing
    else ever moves work between VPSs."""
    frm, to = one_node(cfg, a.from_node), one_node(cfg, a.to_node)
    if frm.name == to.name:
        raise FleetError("FROM and TO are the same VPS")
    for jid in a.job_ids:
        if not ID_RE.match(jid):
            raise FleetError(f"invalid job id {jid!r}")
    r = remote(cfg, frm, f"{worker(cfg, frm)} jobs --json", timeout=60)
    if r.returncode != 0:
        raise FleetError(f"{frm.name} is unreachable, so nothing was moved: {text(r.stderr)[-200:]}")
    jobs = {j.get("id"): j for j in last_json(r.stdout, []) if isinstance(j, dict) and ID_RE.match(str(j.get("id")))}
    queued = [i for i, j in jobs.items() if j.get("state") in ("inbox", "outgoing")]
    rc, movable = 0, []
    for jid in a.job_ids or queued:
        j = jobs.get(jid)
        state = (j or {}).get("state")
        if state in ("inbox", "outgoing"):
            if (j.get("provider") or "claude") in to.providers:
                movable.append(j)
                continue
            print(f"fleet: {jid} stays on {frm.name}: {to.name} does not offer provider '{j.get('provider')}'",
                  file=sys.stderr)
        elif state == "running":
            print(f"fleet: {jid} is running on {frm.name}, so it stays there. To run it on {to.name} instead: "
                  f"fleet cancel {frm.name} {jid}, then fleet retry {frm.name} {jid} --to {to.name}", file=sys.stderr)
        elif state:
            print(f"fleet: {jid} is not queued on {frm.name} (it is {state}); "
                  f"fleet retry {frm.name} {jid} --to {to.name} runs a copy there", file=sys.stderr)
        else:
            print(f"fleet: {frm.name} has no job {jid}", file=sys.stderr)
        rc = 1
    if not a.job_ids:
        running = [i for i, j in jobs.items() if j.get("state") == "running"]
        if running:
            print(f"note: running jobs stay on {frm.name}: {', '.join(running)}", file=sys.stderr)
    if not movable:
        if not a.job_ids:
            print(f"nothing to hand over: {frm.name} has no queued jobs")
        return rc
    if a.dry_run:
        for j in movable:
            print(f"would move {j['id']} (channel {j.get('channel')}) from {frm.name} to {to.name}")
        return rc
    st = fetch_status(cfg, to)
    if not st.get("reachable"):
        raise FleetError(f"{to.name} is unreachable, so nothing was moved ({str(st.get('error', ''))[:200]})")
    broken = {}
    for prov in sorted({j.get("provider") or "claude" for j in movable}):
        why = node_readiness(st, prov)
        if provider_broken(why, prov):
            broken[prov] = why
        elif why:
            print(f"warning: {to.name}: {why}; the jobs wait in its queue there", file=sys.stderr)
    moved = []
    for j in movable:
        why = broken.get(j.get("provider") or "claude")
        if why:
            print(f"fleet: {j['id']} stays on {frm.name}: on {to.name}, {why}, so it would fail there. "
                  f"Fix that first (fleet health)", file=sys.stderr)
            rc = 1
            continue
        try:
            print(hand_over(cfg, frm, to, j["id"]))
            moved.append(j)
        except FleetError as e:
            print(f"fleet: {e}", file=sys.stderr)
            rc = 1
    enabled = [n for n in cfg.nodes.values() if n.enabled]
    other = sorted({j["channel"] for j in moved if isinstance(j.get("channel"), str)
                    and to.name not in [n.name for n in channel_home(enabled, j["channel"])[0]]})
    if other:
        print(f"note: only these jobs moved. New {', '.join(other)} jobs still go to the VPS that fleet.ini "
              f"names for {'that channel' if len(other) == 1 else 'those channels'}.")
    return rc


def cmd_pause(cfg: Config, a, resume: bool = False) -> int:
    nodes = resolve_targets(cfg, a.targets)
    reason = shlex.quote(a.reason) if not resume and a.reason else ""
    verb = "resume" if resume else f"pause {reason}".rstrip()
    res = parallel(nodes, lambda n: remote(cfg, n, f"{worker(cfg, n)} {verb}", timeout=60))
    rc = 0
    for name, r in res.items():
        ok = not isinstance(r, Exception) and r.returncode == 0
        print(text(r.stdout) if ok else f"{name}: FAILED {r if isinstance(r, Exception) else text(r.stderr)}")
        rc = rc or (0 if ok else 1)
    return rc


def cmd_resume(cfg: Config, a) -> int:
    return cmd_pause(cfg, a, resume=True)


# --------------------------------------------------------------------------- schedules

# Each VPS keeps its own schedule (schedule.json, read by app/worker/fleet-schedule): it
# decides alone, also while this PC is off, and it trumps everything else: no job starts
# outside it, whoever queued it. Running jobs always finish.
SCHEDULE_WORDS = "held by its schedule"  # how node_readiness says it
ALWAYS_WORDS = ("24/7", "always")
CLOCK_RE = re.compile(r"^(\d{1,2})(?::(\d{2}))?$")
DAY_RE = re.compile(r"^\d{4}-\d{2}-\d{2}$")
ZONE_RE = re.compile(r"^(UTC|[+-]\d{2}:\d{2}|[A-Za-z_]+(?:/[A-Za-z0-9_+-]+)+)$")


def parse_minutes(v, what: str) -> int:
    """45m, 2h, 1h30, 1.5h or 90 (minutes) as minutes; 0, off and none are 0."""
    s = str(v).strip().lower().replace(" ", "")
    if s in ("0", "off", "none", "no"):
        return 0
    m = re.match(r"^(?:(\d+(?:\.\d+)?)h)?(?:(\d+)(?:m|min)?)?$", s)
    if not s or not m or not (m.group(1) or m.group(2)):
        raise FleetError(f"{what}: {v!r} is not a length of time like 45m, 2h or 1h30")
    return int(round(float(m.group(1) or 0) * 60)) + int(m.group(2) or 0)


def parse_count(v, what: str) -> int:
    """3, 3/day or "3 a day" as 3; 0, off and none are 0."""
    s = str(v).strip().lower()
    if s in ("0", "off", "none", "no"):
        return 0
    m = re.match(r"^(\d+)\s*(?:/\s*day|a\s*day|per\s*day)?$", s)
    if not m:
        raise FleetError(f"{what}: {v!r} is not a number like 4 or 4/day")
    return int(m.group(1))


def parse_clock(v: str, end: bool = False) -> str:
    m = CLOCK_RE.match(v.strip())
    h, mm = (int(m.group(1)), int(m.group(2) or 0)) if m else (99, 0)
    if mm > 59 or h > 24 or (h == 24 and (mm or not end)):
        raise FleetError(f"--hours: {v!r} is not a time like 08:00")
    return f"{h:02d}:{mm:02d}"


def parse_hours(v: str):
    """08:00-12:00,14:00-23:00 (or 8-12, 14-23) as windows; all means all day (None)."""
    s = v.strip().lower()
    if s in ("all", "all day", "24h", "24/7", "any", "none", "off"):
        return None
    wins = []
    for part in re.split(r"\s*[,;]\s*|\s+and\s+", s):
        if not part:
            continue
        m = re.match(r"^([\d:]+)\s*(?:-|to)\s*([\d:]+)$", part)
        if not m:
            raise FleetError(f"--hours: {part!r} is not a work window like 08:00-23:00")
        wins.append([parse_clock(m.group(1)), parse_clock(m.group(2), end=True)])
    if not wins:
        raise FleetError("--hours needs a window like 08:00-23:00")
    return None if wins == [["00:00", "24:00"]] else wins


def day_index(word: str) -> int:
    w = word.strip().lower()[:3]
    if w not in WEEKDAYS:
        raise FleetError(f"--days: {word!r} is not a day (mon, tue, wed, thu, fri, sat, sun)")
    return WEEKDAYS.index(w)


def parse_days(v: str):
    """mon-fri, weekdays, weekends, sat,sun or fri-mon as a list of days; all is None."""
    s = v.strip().lower()
    if s in ("all", "daily", "every day", "everyday", "any"):
        return None
    if s in ("weekdays", "weekend", "weekends"):
        return list(WEEKDAYS[:5] if s == "weekdays" else WEEKDAYS[5:])
    got = set()
    for part in re.split(r"[,\s]+", s):
        if not part:
            continue
        a, _, b = part.partition("-")
        k, last = day_index(a), day_index(b or a)
        got.add(k)
        while k != last:
            k = (k + 1) % 7
            got.add(k)
    return [d for i, d in enumerate(WEEKDAYS) if i in got]


def parse_off(v: str):
    """2026-12-24..2026-12-26,2027-01-01 (or today, tomorrow) as ranges; none clears them."""
    s = v.strip().lower()
    if s in ("", "none", "no", "off", "clear"):
        return None

    def one(w):
        today = datetime.now().date()
        if w in ("today", "tomorrow"):
            return (today + timedelta(days=w == "tomorrow")).isoformat()
        try:
            if DAY_RE.match(w):
                return datetime.strptime(w, "%Y-%m-%d").date().isoformat()
        except ValueError:
            pass
        raise FleetError(f"--off: {w!r} is not a day like 2026-12-24 (or today, tomorrow)")

    out = []
    for part in re.split(r"[,\s]+", s):
        if part:
            a, _, b = part.partition("..")
            out.append([one(a), one(b or a)])
    return out


def parse_cycle(v: str):
    """3h/1h (work three hours, rest one) as [180, 60]; off is None."""
    s = v.strip().lower()
    if s in ("off", "none", "no", "0"):
        return None
    work, sep, rest = s.partition("/")
    if not sep:
        raise FleetError(f"--cycle: {v!r} is not work/rest like 3h/1h")
    return [parse_minutes(work, "--cycle"), parse_minutes(rest, "--cycle")]


def pc_zone() -> str:
    """This PC's time zone: a name where the system says it (Linux, macOS, or $TZ), else
    the offset from UTC that the clock has now (Windows), like +01:00."""
    tz = os.environ.get("TZ", "").strip().lstrip(":")
    if tz == "UTC" or (ZONE_RE.match(tz) and "/" in tz):
        return tz
    if not IS_WINDOWS:
        real = os.path.realpath("/etc/localtime")
        if "/zoneinfo/" in real:
            name = re.sub(r"^(posix|right)/", "", real.split("/zoneinfo/", 1)[1])
            if ZONE_RE.match(name):
                return name
    mins = int((datetime.now().astimezone().utcoffset() or timedelta(0)).total_seconds()) // 60
    return f"{'+' if mins >= 0 else '-'}{abs(mins) // 60:02d}:{abs(mins) % 60:02d}"


def zone_words(tz) -> str:
    return "UTC" + tz if re.match(r"^[+-]\d{2}:\d{2}$", str(tz or "")) else str(tz or "UTC")


def schedule_changes(cfg: Config, a, reset: bool) -> dict:
    ch = {"reset": True} if reset else {}
    if a.hours is not None:
        ch["hours"] = parse_hours(a.hours)
    if a.days is not None:
        ch["days"] = parse_days(a.days)
    if a.off is not None:
        ch["off"] = parse_off(a.off)
    if a.cycle is not None:
        ch["cycle"] = parse_cycle(a.cycle)
    if a.gap is not None:
        ch["gap"] = parse_minutes(a.gap, "--gap") or None
    if a.random is not None:
        n = parse_count(a.random, "--random")
        ch["random"] = [n, parse_minutes(a.min_gap if a.min_gap is not None else "30m", "--min-gap")] if n else None
    elif a.min_gap is not None:
        raise FleetError("--min-gap goes with --random, for example: --random 4/day --min-gap 1h")
    if a.cap is not None:
        ch["cap"] = parse_count(a.cap, "--cap") or None
    tz = a.tz or cfg.timezone
    if tz:
        if not ZONE_RE.match(tz):
            raise FleetError(f"time zone {tz!r}: use a name like Europe/Paris, UTC or an offset like +01:00")
        ch["tz"] = tz
    if not ch:
        raise FleetError("say what to change: 24/7, --hours, --days, --off, --cycle, --gap, --random, --cap or --tz "
                         "(fleet schedule --help)")
    ch["tz_default"] = pc_zone()  # used when the VPS has no time zone for the schedule yet
    return ch


def fetch_schedule(cfg: Config, n: Node):
    r = remote(cfg, n, f"{worker(cfg, n)} schedule show --json", timeout=60)
    if r.returncode != 0:
        raise FleetError(text(r.stderr)[-300:] or f"exit {r.returncode}")
    return last_json(r.stdout)


def send_schedule(cfg: Config, n: Node, changes: dict):
    r = remote(cfg, n, f"{worker(cfg, n)} schedule set", stdin=json.dumps(changes).encode("utf-8"), timeout=60)
    if r.returncode != 0:
        raise FleetError(text(r.stderr).replace("fleet-schedule: ", "")[-300:] or f"exit {r.returncode}")
    return last_json(r.stdout)


def schedule_lines(name: str, n: Node, st) -> list:
    chans = ", ".join(dedicated_channels(n)) or "any channel"
    if st is None:
        return [f"{name} ({chans}): works 24/7"]
    if st.get("error"):
        return [f"{name} ({chans}): {st.get('reason')}. Set it again, or: fleet schedule set {name} 24/7"]
    out = [f"{name} ({chans}): {st.get('summary')}. Times in {zone_words(st.get('tz'))}."]
    out.append(f"  now: {st.get('note') or st.get('reason') or ''}")
    w = st.get("workday") or {}
    if w.get("work"):
        line = f"  {'today' if w.get('today') else w.get('weekday')}: work time {', '.join(w['work'])}"
        if w.get("picks"):
            line += "; random starts " + ", ".join(
                p["at"] + ("" if p.get("state") == "ahead" else f" ({p.get('state')})") for p in w["picks"])
        out.append(line + f"; {w.get('started', 0)} started")
    if (st.get("config") or {}).get("tz_guess") and re.match(r"^[+-]\d{2}:\d{2}$", str(st.get("tz") or "")):
        out.append(f"  (UTC{st['tz']} is your PC's offset when it was set. To follow summer time, add "
                   f"timezone = Area/City under [defaults] in fleet.ini and set the schedule again.)")
    return out


def cmd_schedule(cfg: Config, a) -> int:
    words = [w.strip() for w in a.args if w.strip()]
    reset = any(w.lower() in ALWAYS_WORDS for w in words)
    names = [x for w in words if w.lower() not in ALWAYS_WORDS for x in w.split(",") if x]
    if reset and a.action != "set":
        raise FleetError("24/7 goes with set: fleet schedule set vps1 24/7")
    if not names and a.action != "show":
        raise FleetError(f"name the VPSs (or all), for example: fleet schedule {a.action} vps1")
    nodes = resolve_targets(cfg, None if not names or "all" in names else ",".join(names))
    if a.action == "show":
        res = parallel(nodes, lambda n: fetch_schedule(cfg, n))
    else:
        if a.action == "set":
            changes = schedule_changes(cfg, a, reset)
        elif a.action == "open":
            mins = parse_minutes(a.for_ or "1h", "--for")
            if not 0 < mins <= 7 * 1440:
                raise FleetError("--for: from a minute to 7 days, like 2h")
            changes = {"open_for": mins}
        else:
            changes = {"open_for": 0}
        res = parallel(nodes, lambda n: send_schedule(cfg, n, changes))
    if a.json:
        print(json.dumps([{"node": k, "schedule": None if isinstance(v, Exception) else v,
                           "error": str(v) if isinstance(v, Exception) else None} for k, v in res.items()],
                         indent=2))
    rc = 0
    for name, st in res.items():
        if isinstance(st, Exception):
            print(f"{name}: FAILED {st}", file=sys.stderr)
            rc = 1
        elif not a.json:
            print("\n".join(schedule_lines(name, cfg.nodes[name], st)))
    return rc


def schedule_hold(st) -> dict:
    """The node's schedule while it keeps the node from starting jobs, else {}."""
    sch = st.get("schedule") if isinstance(st, dict) else None
    return sch if isinstance(sch, dict) and sch.get("open") is False else {}


_index_lock = threading.Lock()
PULL_PARTS = ("output", "logs", "result.json", "status.json", "job.json")


def fetch_workspace(cfg: Config, n: Node, jid: str, dest: Path) -> None:
    wd = f"{root_of(cfg, n)}/work/{jid}"
    use_rsync = os.environ.get("FLEET_PULL_METHOD", "auto") != "tar" and shutil.which("rsync")
    if cfg.transport == "ssh" and not IS_WINDOWS and use_rsync:
        rsh = " ".join(shlex.quote(x) for x in [ssh_binary()] + ssh_options(cfg, n))
        filters = [f"--include=/{p}" + ("/***" if "." not in p else "") for p in PULL_PARTS] + ["--exclude=*"]
        r = subprocess.run(["rsync", "-a", "--partial", "--timeout=300", "-e", rsh, *filters,
                            f"{n.user}@{n.host}:{wd}/", f"{dest}/"],
                           capture_output=True, stdin=subprocess.DEVNULL)
        if r.returncode != 0:
            raise FleetError(text(r.stderr)[-300:] or f"rsync exit {r.returncode}")
        return
    part = dest.parent / f".{jid}.tar.gz.part"
    cmd = f"cd {shlex.quote(wd)} && tar -czf - $(ls -d {' '.join(PULL_PARTS)} 2>/dev/null)"
    with part.open("wb") as fh:
        r = remote(cfg, n, cmd, stdout=fh, timeout=4 * 3600)
    try:
        if r.returncode != 0:
            raise FleetError(text(r.stderr)[-300:] or f"exit {r.returncode}")
        with tarfile.open(part, mode="r:gz") as tf:
            safe = [m for m in tf.getmembers()
                    if not m.name.startswith("/") and ".." not in Path(m.name).parts and (m.isfile() or m.isdir())]
            if hasattr(tarfile, "data_filter"):
                tf.extractall(dest, members=safe, filter="data")
            else:
                tf.extractall(dest, members=safe)
    finally:
        part.unlink(missing_ok=True)


def pull_node(cfg: Config, n: Node) -> list:
    r = remote(cfg, n, f"{worker(cfg, n)} finished --json", timeout=60)
    if r.returncode != 0:
        raise FleetError(f"unreachable: {text(r.stderr)[-200:]}")
    pulled = []
    for j in last_json(r.stdout, []):
        jid = j.get("id", "")
        if not ID_RE.match(jid):
            continue
        dest = cfg.results_dir / n.name / jid
        dest.mkdir(parents=True, exist_ok=True)
        j["node"], j["path"] = n.name, str(dest)
        try:
            fetch_workspace(cfg, n, jid, dest)
        except FleetError as e:
            j["pull_error"] = str(e)
            pulled.append(j)
            continue
        remote(cfg, n, f"{worker(cfg, n)} mark-pulled {jid}", timeout=60)
        summary = dest / "output" / "SUMMARY.txt"
        j["summary"] = summary.read_text(encoding="utf-8", errors="replace")[:600] if summary.exists() else ""
        with _index_lock, (cfg.results_dir / "index.jsonl").open("a", encoding="utf-8") as idx:
            idx.write(json.dumps(dict(j, pulled_at=now_iso())) + "\n")
        pulled.append(j)
    return pulled


def cmd_pull(cfg: Config, a) -> int:
    cfg.results_dir.mkdir(parents=True, exist_ok=True)
    nodes = resolve_targets(cfg, a.targets)
    res = parallel(nodes, lambda n: pull_node(cfg, n), max_workers=5)
    lines, errors = [], []
    for name, r in res.items():
        if isinstance(r, Exception):
            errors.append(f"{name}: {r}")
            continue
        for j in r:
            status = {"failed": "FAILED", "moved": "MOVED"}.get(j.get("state"), "done")
            reason = f" ({j['reason']})" if j.get("reason") else ""
            err = f"\n    could not download: {j['pull_error']}" if j.get("pull_error") else ""
            summary = " ".join(j.get("summary", "").split())[:300]
            if status == "FAILED" and not summary and j.get("log_tail"):
                summary = "log: " + " | ".join(j["log_tail"].splitlines())[:300]
            chk = j.get("check") if isinstance(j.get("check"), dict) else {}
            if chk.get("ok") is False:
                verdict = "CHECK: " + "; ".join(str(x) for x in chk.get("problems") or [])[:400]
            else:
                verdict = check_line(chk)
            lines.append(f"[{status}] {name}/{j['id']}  channel: {j.get('channel')}{reason}{err}\n"
                         f"    {j['path']}" + (f"\n    {summary}" if summary else "")
                         + (f"\n    {verdict}" if verdict else ""))
    if lines:
        print(f"Pulled {len(lines)} finished job(s) into {cfg.results_dir}:")
        print("\n".join(lines))
    elif not a.quiet:
        print("nothing new to pull")
    if errors and not a.quiet:  # scheduled pulls stay quiet: `fleet health` reports unreachable nodes
        print("\n".join(errors), file=sys.stderr)
    return 1 if errors and not a.quiet else 0


# --------------------------------------------------------------------------- video checks and the report

def check_line(chk) -> str:
    """What fleet-check said about a job's video, in a few words ("" when it did not run)."""
    if not isinstance(chk, dict):
        return ""
    probs = [str(p) for p in chk.get("problems") or []]
    if chk.get("ok") is True:
        return "video ok"
    if chk.get("ok") is False:
        more = f" (+{len(probs) - 1} more)" if len(probs) > 1 else ""
        return f"CHECK: {probs[0] if probs else 'problems found'}{more}"
    return f"not checked: {chk['skipped']}" if chk.get("skipped") else ""


def describe_check(v: dict) -> list:
    """fleet-check's verdict as lines for a person."""
    facts = v.get("facts") if isinstance(v.get("facts"), dict) else {}
    probs = [str(p) for p in v.get("problems") or []]
    if v.get("ok") is True:
        lines = ["the video looks right"]
    elif v.get("ok") is False:
        lines = [f"{len(probs)} problem(s):"] + [f"  - {p}" for p in probs]
    else:
        lines = [f"not checked: {v.get('skipped') or 'no verdict'}"]
    bits = []
    if isinstance(facts.get("seconds"), (int, float)):
        bits.append(f"{facts['seconds']:.0f} s")
    if facts.get("width") and facts.get("height"):
        bits.append(f"{facts['width']}x{facts['height']}")
    for key, unit in (("fps", " fps"), ("megabytes", " MB")):
        if isinstance(facts.get(key), (int, float)):
            bits.append(f"{facts[key]:g}{unit}")
    codecs = "+".join(str(facts[k]) for k in ("video_codec", "audio_codec") if facts.get(k))
    if codecs:
        bits.append(codecs)
    if isinstance(facts.get("loudest_db"), (int, float)):
        bits.append(f"loudest moment {facts['loudest_db']:.0f} dB")
    if v.get("video"):
        lines.append(f"  {v['video']}" + (f": {', '.join(bits)}" if bits else ""))
    for key in ("thumbnail", "title"):
        if facts.get(key):
            lines.append(f"  {key}: {facts[key]}")
    return lines


def cmd_check(cfg: Config, a) -> int:
    n = one_node(cfg, a.node)
    if not ID_RE.match(a.job_id):
        raise FleetError("invalid job id")
    r = remote(cfg, n, f"{worker(cfg, n)} check {a.job_id}", timeout=1200)
    if r.returncode != 0:
        raise FleetError(f"{n.name}: {text(r.stderr)[-300:] or f'exit {r.returncode}'}")
    v = last_json(r.stdout, {})
    if not isinstance(v, dict) or "ok" not in v:
        raise FleetError(f"{n.name}: the check printed no verdict (run `fleet sync`)")
    local = cfg.results_dir / n.name / a.job_id
    if local.is_dir():  # already pulled: keep the new verdict with the results too
        (local / "logs").mkdir(parents=True, exist_ok=True)
        write_file(local / "logs" / "check.json", json.dumps(v) + "\n")
    if a.json:
        print(json.dumps(v, indent=2))
    else:
        lines = describe_check(v)
        print(f"{n.name}/{a.job_id}: {lines[0]}")
        print("\n".join(lines[1:]))
    return 2 if v.get("ok") is False else 0


def parse_stamp(s):
    """A worker time stamp such as 2026-11-24T09:00:00Z as epoch seconds, or None."""
    try:
        return datetime.strptime(str(s), "%Y-%m-%dT%H:%M:%SZ").replace(tzinfo=timezone.utc).timestamp()
    except ValueError:
        return None


def job_label(j: dict) -> str:
    t = j.get("title")
    return f"\"{t}\" ({j['id']})" if t else j["id"]


def report_data(cfg: Config, hours: float) -> dict:
    """What the daily report says, as data."""
    nodes = resolve_targets(cfg, None)
    since = time.time() - hours * 3600
    statuses = parallel(nodes, lambda n: fetch_status(cfg, n))
    jobs, silent = fetch_jobs(cfg, nodes)
    recent = [j for j in jobs if (parse_stamp(j.get("finished_at")) or 0) >= since]
    per_node = []
    for n in nodes:
        st = statuses.get(n.name)
        mine = [j for j in jobs if j["node"] == n.name]
        done = [j for j in recent if j["node"] == n.name and j["state"] == "done"]
        own = dedicated_channels(n)
        per_node.append({
            "node": n.name,
            "channels": own or (["any channel"] if "all" in {channel_key(c) for c in channel_names(n)} else []),
            "reachable": isinstance(st, dict) and bool(st.get("reachable")) and n.name not in silent,
            "made": len(done),
            "made_ok": sum(1 for j in done if (j.get("check") or {}).get("ok") is True),
            "failed": sum(1 for j in recent if j["node"] == n.name and j["state"] == "failed"),
            "running": sum(1 for j in mine if j["state"] == "running"),
            "queued": sum(1 for j in mine if j["state"] in ("inbox", "outgoing")),
            "limit_until": active_limit(st).get("until") if isinstance(st, dict) else None,
            "off_duty": schedule_hold(st).get("reason") or None,
        })
    with_problems = [j for j in recent if j["state"] == "done" and (j.get("check") or {}).get("ok") is False]
    failed = [j for j in recent if j["state"] == "failed"]
    needs = list(health_problems(cfg, HEALTH_DEFAULTS, statuses).values())
    plan = plan_summary(cfg, since)
    if plan.get("error"):
        needs.append(f"Week plan: {plan['error']}")
    if plan.get("drafts"):
        late = f" ({len(plan['late_drafts'])} of them are late)" if plan.get("late_drafts") else ""
        needs.append(f"Week plan: {len(plan['drafts'])} topic(s) wait for your yes{late}. Answer \"approve all\" "
                     f"or \"approve {compact_ids(plan['drafts'])}\"; see them with: fleet plan show")
    for i in plan.get("not_queued", [])[:5]:
        needs.append(f"Week plan: {plan_line(i)} could not be queued: {i.get('error')}")
    needs += publish_needs(cfg)
    trends = trends_summary(cfg, since)
    if trends.get("error"):
        needs.append(f"Trend looker: {trends['error']}")
    for x in trends.get("waiting", [])[:5]:
        needs.append(f"Trend looker: pitch {x['n']} for {x['channel']} waits for your answer: \"{x['title']}\". "
                     f"Say \"go {x['n']}\" or \"drop {x['n']}\"")
    needs += [f"Trend looker: {e}" for e in trends.get("problems", [])]
    return {"hours": hours, "nodes": per_node, "problems": with_problems, "failed": failed, "needs": needs,
            "plan": {k: len(v) for k, v in plan.items() if isinstance(v, list)},
            "published": publish_summary(cfg, since),
            "trends": {k: len(v) if isinstance(v, list) else v for k, v in trends.items() if k != "problems"}}


def report_text(d: dict) -> str:
    lines = [f"Fleet report for {datetime.now().strftime('%a %d %b')}, the last {d['hours']:g} hours"]
    for n in d["nodes"]:
        chans = ", ".join(n["channels"]) or "no channel"
        if not n["reachable"]:
            lines.append(f"{n['node']} ({chans}): did not answer")
            continue
        parts = [f"{n['made']} video(s) made"]
        parts += [f"{n['failed']} failed"] if n["failed"] else []
        parts += [f"{n['running']} running"] if n["running"] else []
        parts += [f"{n['queued']} queued"] if n["queued"] else []
        if n.get("limit_until"):
            parts.append(f"usage limit until {short_time(n['limit_until'])}")
        if n.get("off_duty"):
            parts.append(n["off_duty"])
        lines.append(f"{n['node']} ({chans}): {', '.join(parts)}")
    if d["problems"]:
        lines.append("Videos with problems:")
        for j in d["problems"][:8]:
            probs = "; ".join(str(p) for p in (j.get("check") or {}).get("problems") or [])
            lines.append(f"- {j['node']} {job_label(j)}: {probs[:240]}. Again: fleet retry {j['node']} {j['id']}")
        if len(d["problems"]) > 8:
            lines.append(f"- and {len(d['problems']) - 8} more (fleet jobs)")
    if d["failed"]:
        lines.append("Failed:")
        for j in d["failed"][:8]:
            lines.append(f"- {j['node']} {job_label(j)}: {j.get('reason') or 'failed'}. "
                         f"Again: fleet retry {j['node']} {j['id']}")
        if len(d["failed"]) > 8:
            lines.append(f"- and {len(d['failed']) - 8} more (fleet jobs --state failed)")
    plan = d.get("plan") or {}
    if plan.get("queued") or plan.get("approved_ahead"):
        lines.append(f"Week plan: {plan.get('queued', 0)} video(s) queued, {plan.get('approved_ahead', 0)} approved "
                     f"and waiting for their day")
    sent = d.get("published") or {}
    if sent:
        words = {"youtube": "YouTube draft(s)", "tiktok": "TikTok inbox upload(s)", "instagram": "Instagram Reel(s)"}
        lines.append("Published: " + ", ".join(f"{n} {words.get(k, k)}" for k, n in sorted(sent.items())))
    t = d.get("trends") or {}
    if t and not t.get("error"):
        if not t.get("key"):
            lines.append("Trend looker: off until it has a YouTube API key (fleet trends key)")
        elif t.get("looks") or t.get("pitched"):
            lines.append(f"Trend looker: {t.get('looks', 0)} look(s), {t.get('pitched', 0)} pitch(es), "
                         f"{t.get('went', 0)} sent to a VPS")
        elif d["hours"] >= 24:
            lines.append("Trend looker: no look in that time. Is its Hermes job there? (fleet hermes-cron)")
    if d["needs"]:
        lines.append("Needs you:")
        lines += [f"- {x}" for x in d["needs"][:12]]
    elif not d["problems"] and not d["failed"]:
        lines.append("Nothing needs you.")
    return "\n".join(lines)


def cmd_report(cfg: Config, a) -> int:
    d = report_data(cfg, a.hours)
    print(json.dumps(d, indent=2, default=str) if a.json else report_text(d))
    return 0


# --------------------------------------------------------------------------- the week plan

WEEKDAYS = ("mon", "tue", "wed", "thu", "fri", "sat", "sun")
TIME_RE = re.compile(r"^([01]\d|2[0-3]):[0-5]\d$")
PLAN_KEEP_DAYS = 60  # queued and rejected items older than this leave plan.json
PLAN_FIELDS = re.compile(r"\{(title|brief|day|channel)\}")
DEFAULT_PLAN_JOB = {
    "prompt": (
        "Make one video for the channel \"{channel}\" on the topic in ./topic.md: \"{title}\". "
        "Write the script first (./output/script.md), then produce the video with the tools on this machine "
        "(ffmpeg, ImageMagick, Python). Deliverables, all in ./output/: video.mp4, thumbnail.png (1280x720), "
        "script.md, and metadata.json with title, description and tags. Nobody can answer questions during "
        "the run: make reasonable choices and list them in your final summary."),
    "timeout_minutes": 180,
    "max_turns": 300,
    "max_retries": 1,
}


def plan_file(cfg: Config) -> Path:
    return cfg.path.parent / "plan.json"


def channels_dir(cfg: Config) -> Path:
    return cfg.path.parent / "channels"


def channel_file(cfg: Config, channel: str):
    """The channel's own job file (channels/<channel>.json next to fleet.ini), or None."""
    p = channels_dir(cfg) / f"{channel_key(channel)}.json"
    if not p.exists():
        return None
    try:
        d = json.loads(p.read_text(encoding="utf-8-sig"))
        if isinstance(d, dict) and "prompt_file" in d and "prompt" not in d:
            d["prompt"] = (p.parent / d.pop("prompt_file")).read_text(encoding="utf-8-sig")
    except (OSError, ValueError) as e:
        raise FleetError(f"{p}: {e}") from None
    if not isinstance(d, dict):
        raise FleetError(f"{p} should hold one JSON object, like a job file")
    return d


def plan_channels(cfg: Config) -> list:
    """The channels the week plan covers: the ones a VPS makes (`channels` in fleet.ini),
    and the ones with a file in channels/."""
    names = {}
    for n in cfg.nodes.values():
        if n.enabled:
            for c in dedicated_channels(n):
                names.setdefault(channel_key(c), c)
    if channels_dir(cfg).is_dir():
        for p in sorted(channels_dir(cfg).glob("*.json")):
            try:
                c = json.loads(p.read_text(encoding="utf-8-sig")).get("channel")
            except (OSError, ValueError, AttributeError):
                c = None
            names.setdefault(channel_key(c if isinstance(c, str) and c.strip() else p.stem),
                             c if isinstance(c, str) and c.strip() else p.stem)
    return sorted(names.values(), key=str.casefold)


def channel_schedule(cfg: Config, channel: str) -> tuple:
    """(weekdays as 0 for Monday to 6 for Sunday, the time as HH:MM, ideas for topics) from
    the "plan" part of the channel's file: every day at 09:00 when it has none."""
    base = channel_file(cfg, channel) or {}
    plan = base.get("plan") if isinstance(base.get("plan"), dict) else {}
    days = plan.get("days", "daily")
    if isinstance(days, str):
        days = {"daily": WEEKDAYS, "weekdays": WEEKDAYS[:5], "weekends": WEEKDAYS[5:]}.get(
            days.strip().lower(), days.split(","))
    wanted = {str(x).strip().lower()[:3] for x in days} if isinstance(days, (list, tuple)) else set()
    t = str(plan.get("time", "09:00"))
    if not TIME_RE.match(t):
        raise FleetError(f"{channels_dir(cfg) / (channel_key(channel) + '.json')}: plan time must be HH:MM, not {t!r}")
    ideas = plan.get("ideas", "")
    return [k for k, d in enumerate(WEEKDAYS) if d in wanted], t, ideas if isinstance(ideas, str) else ""


def week_range(which: str) -> tuple:
    """The days of this week (from today to Sunday) or of next week (Monday to Sunday)."""
    today = datetime.now().date()
    monday = today - timedelta(days=today.weekday())
    if which == "next":
        return monday + timedelta(days=7), monday + timedelta(days=13)
    return today, monday + timedelta(days=6)


def load_plan(cfg: Config) -> dict:
    p = plan_file(cfg)
    if not p.exists():
        return {"version": 1, "next_id": 1, "items": []}
    try:
        d = json.loads(p.read_text(encoding="utf-8"))
    except (OSError, ValueError) as e:
        raise FleetError(f"{p} cannot be read ({e}); fix it or move it away") from None
    if not isinstance(d, dict) or not isinstance(d.get("items"), list):
        raise FleetError(f"{p} is not a week plan")
    d["items"] = [i for i in d["items"] if isinstance(i, dict) and isinstance(i.get("id"), int)]
    d["next_id"] = max([int(number(d.get("next_id"), 1))] + [i["id"] + 1 for i in d["items"]])
    return d


def save_plan(cfg: Config, plan: dict) -> None:
    keep = (datetime.now().date() - timedelta(days=PLAN_KEEP_DAYS)).isoformat()
    plan["items"] = [i for i in plan["items"] if i.get("status") in ("draft", "approved") or i.get("day", "") >= keep]
    p = plan_file(cfg)
    tmp = p.with_name(p.name + ".tmp")
    write_file(tmp, json.dumps(plan, indent=2, ensure_ascii=False) + "\n")
    os.replace(tmp, p)


@contextlib.contextmanager
def file_lock(lock: Path, what: str):
    """Hold a lock file next to fleet.ini, for a file that two runs could change at once."""
    lock.parent.mkdir(parents=True, exist_ok=True)
    deadline = time.time() + 120
    while True:
        try:
            os.close(os.open(str(lock), os.O_CREAT | os.O_EXCL | os.O_WRONLY))
            break
        except FileExistsError:
            try:
                if time.time() - lock.stat().st_mtime > 900:  # left behind by a crash
                    lock.unlink()
                    continue
            except OSError:
                pass
            if time.time() > deadline:
                raise FleetError(f"{what} is busy ({lock} exists); try again in a minute") from None
            time.sleep(0.25)
    try:
        yield
    finally:
        try:
            lock.unlink()
        except OSError:
            pass


def plan_locked(cfg: Config):
    """Hold the week plan's lock: the hourly run and an answer from Telegram can come at once."""
    return file_lock(plan_file(cfg).with_name("plan.lock"), "the week plan")


def plan_due(i: dict) -> datetime:
    try:
        return datetime.strptime(f"{i.get('day')} {i.get('time') or '09:00'}", "%Y-%m-%d %H:%M")
    except ValueError:
        return datetime.max


def plan_line(i: dict) -> str:
    when = plan_due(i)
    day = when.strftime("%a %d %b %H:%M") if when != datetime.max else str(i.get("day"))
    return f"#{i['id']} {day} {i.get('channel')}: \"{i.get('title')}\""


def compact_ids(items: list) -> str:
    """[3, 4, 5, 7] -> "3-5,7" """
    ids, out = sorted({i["id"] for i in items}), []
    for k in ids:
        if out and k == out[-1][1] + 1:
            out[-1][1] = k
        else:
            out.append([k, k])
    return ",".join(f"{a}-{b}" if b > a else f"{a}" for a, b in out)


def plan_ids(specs: list, plan: dict) -> list:
    """Plan numbers from "12", "12,14", "#12", "12-15" or "all" (every draft)."""
    out = []
    for spec in specs:
        for part in re.split(r"[\s,]+", str(spec)):
            part = part.strip().lstrip("#")
            if not part:
                continue
            if part.lower() == "all":
                out += [i["id"] for i in plan["items"] if i.get("status") == "draft"]
            elif re.match(r"^\d+-\d+$", part):
                lo, hi = sorted(map(int, part.split("-")))
                if hi - lo > 1000:
                    raise FleetError(f"{part}: too many at once")
                out += range(lo, hi + 1)
            elif part.isdigit():
                out.append(int(part))
            else:
                raise FleetError(f"{part!r} is not a plan number (use 12, 12,14, 12-15 or all)")
    return list(dict.fromkeys(out))


def plan_item(cfg: Config, raw, where: str) -> dict:
    """A checked plan item {channel, day, time, title, brief} from what Hermes or the owner gave."""
    def bad(msg):
        raise FleetError(f"{where}: {msg}")
    if not isinstance(raw, dict):
        bad("each item must be an object with channel, day, title and brief")
    ch = raw.get("channel")
    if not isinstance(ch, str) or not ch.strip() or len(ch) > 200:
        bad("needs a \"channel\"")
    known = {channel_key(c): c for c in plan_channels(cfg)}
    if channel_key(ch) not in known and not channel_home([n for n in cfg.nodes.values() if n.enabled], ch)[0]:
        bad(f"no VPS makes videos for channel {ch!r} (the channels: {', '.join(known.values()) or 'none yet'})")
    ch = known.get(channel_key(ch), ch.strip())
    try:
        day = datetime.strptime(str(raw.get("day")), "%Y-%m-%d").date()
    except ValueError:
        bad(f"\"day\" must be a date like 2026-12-01, not {raw.get('day')!r}")
    if day < datetime.now().date():
        bad(f"{day.isoformat()} is in the past")
    t = str(raw.get("time") or channel_schedule(cfg, ch)[1])
    if not TIME_RE.match(t):
        bad(f"\"time\" must be HH:MM like 09:00, not {t!r}")
    title, brief = raw.get("title"), raw.get("brief") or ""
    if not isinstance(title, str) or not title.strip() or len(title) > 200:
        bad("needs a \"title\" of at most 200 characters")
    if not isinstance(brief, str) or len(brief) > 4000:
        bad("\"brief\" must be text of at most 4000 characters")
    return {"channel": ch, "day": day.isoformat(), "time": t, "title": title.strip(), "brief": brief.strip()}


def topic_job(cfg: Config, channel: str, title: str, brief: str, day: str, more: str = "") -> dict:
    """A video on one topic for a channel: the channel's own job file (channels/<channel>.json),
    or the default, with {title}, {brief}, {day} and {channel} filled in, and the topic in
    topic.md with `more` after it. The caller gives it an id and validates it."""
    job = json.loads(json.dumps(channel_file(cfg, channel) or {}))  # a deep copy
    for key in ("plan", "publish", "id", "node", "submitted_at"):
        job.pop(key, None)
    if not (isinstance(job.get("prompt"), str) and job["prompt"].strip()):
        job["prompt"] = DEFAULT_PLAN_JOB["prompt"]  # a channel file may hold only its days and time
    for key, value in DEFAULT_PLAN_JOB.items():
        job.setdefault(key, value)
    values = {"title": title, "brief": brief or "", "day": day, "channel": channel}
    fill = lambda t: PLAN_FIELDS.sub(lambda m: values[m.group(1)], t)  # noqa: E731 - one pass, no repeats
    prompt = job.get("prompt") if isinstance(job.get("prompt"), str) else ""
    if "{title}" not in prompt:
        prompt = (prompt.rstrip() + "\n\n" if prompt.strip() else "") + "The topic of this video is in ./topic.md: \"{title}\"."
    job["prompt"] = fill(prompt)
    files = [f for f in job.get("files") or [] if isinstance(f, dict)]
    for f in files:
        if f.get("encoding", "utf-8") == "utf-8" and isinstance(f.get("content"), str):
            f["content"] = fill(f["content"])
    topic = next((f for f in files if f.get("path") == "topic.md"), None)
    if topic is None:
        topic = {"path": "topic.md", "content": fill("# {title}\n\nChannel: {channel}\nDay: {day}\n\n{brief}\n")}
        files.append(topic)
    if more and topic.get("encoding", "utf-8") == "utf-8" and isinstance(topic.get("content"), str):
        topic["content"] = topic["content"].rstrip("\n") + "\n\n" + more.strip() + "\n"
    job.update(files=files, channel=channel, title=title)
    return job


def plan_job(cfg: Config, i: dict) -> dict:
    """The job for a plan item: its topic, on the channel's own job file."""
    job = topic_job(cfg, i["channel"], i["title"], i.get("brief") or "", i["day"])
    job.update(plan_id=i["id"], id=i.get("job_id") or make_job_id(i["channel"]))
    return validate_job(job, f"plan item #{i['id']} ({channels_dir(cfg) / (channel_key(i['channel']) + '.json')})")


def plan_show(cfg: Config, a) -> int:
    items = load_plan(cfg)["items"]
    if a.week in ("this", "next"):
        lo, hi = (d.isoformat() for d in week_range(a.week))
        items = [i for i in items if lo <= i.get("day", "") <= hi]
    elif a.week != "all":
        today = datetime.now().date().isoformat()
        items = [i for i in items if i.get("day", "") >= today or i.get("status") in ("draft", "approved")]
    if a.status:
        items = [i for i in items if i.get("status") == a.status]
    if a.channel:
        items = [i for i in items if channel_key(i.get("channel", "")) == channel_key(a.channel)]
    items.sort(key=lambda i: (plan_due(i), str(i.get("channel")).casefold(), i["id"]))
    if a.json:
        print(json.dumps(items, indent=2, ensure_ascii=False))
        return 0
    if not items:
        print("nothing planned" + (f" for {a.week} week" if a.week in ("this", "next") else ""))
        return 0
    day = None
    for i in items:
        when = plan_due(i)
        if when.date() != day:
            day = when.date()
            print(when.strftime("%A %d %B") if when != datetime.max else str(i.get("day")))
        note = {"queued": f" (queued on {i.get('node')} as {i.get('job_id')})"}.get(i.get("status"), "")
        if i.get("error") and i.get("status") == "approved":
            note = f" (not queued yet: {i['error'][:120]})"
        print(f"  #{i['id']} {i.get('time')} {i.get('channel')}: \"{i.get('title')}\" [{i.get('status')}]{note}")
    drafts = [i for i in items if i.get("status") == "draft"]
    if drafts:
        print(f"\n{len(drafts)} topic(s) wait for the owner's yes: fleet plan approve {compact_ids(drafts)} (or all)")
    return 0


def plan_slots(cfg: Config, a) -> int:
    which = a.week if a.week in ("this", "next") else "next"
    lo, hi = week_range(which)
    taken = {(channel_key(i.get("channel", "")), i.get("day")) for i in load_plan(cfg)["items"]
             if i.get("status") != "rejected"}
    now, slots = datetime.now(), []
    for ch in plan_channels(cfg):
        if a.channel and channel_key(ch) != channel_key(a.channel):
            continue
        days, t, ideas = channel_schedule(cfg, ch)
        d = lo
        while d <= hi:
            when = datetime.strptime(f"{d.isoformat()} {t}", "%Y-%m-%d %H:%M")
            if d.weekday() in days and (channel_key(ch), d.isoformat()) not in taken and when > now:
                slots.append({"channel": ch, "day": d.isoformat(), "weekday": d.strftime("%a"), "time": t,
                              "ideas": ideas})
            d += timedelta(days=1)
    if a.json:
        print(json.dumps(slots, indent=2, ensure_ascii=False))
        return 0
    if not slots:
        print(f"no open slots {which} week" + ("" if plan_channels(cfg) else
              f": no channels yet (set `channels` for each VPS in {cfg.path})"))
        return 0
    for s in slots:
        print(f"{s['weekday']} {s['day']} {s['time']}  {s['channel']}" + (f"  (ideas: {s['ideas'][:100]})" if s["ideas"] else ""))
    print("\nFill them with: fleet plan import FILE.json (a JSON list of {\"channel\", \"day\", \"title\", \"brief\"})")
    return 0


def plan_add_items(cfg: Config, new: list) -> int:
    added, skipped = [], []
    with plan_locked(cfg):
        plan = load_plan(cfg)
        for it in new:
            dup = next((i for i in plan["items"] if i.get("status") != "rejected" and i.get("day") == it["day"]
                        and i.get("time") == it["time"] and channel_key(i.get("channel", "")) == channel_key(it["channel"])),
                       None)
            if dup:
                skipped.append((it, dup))
                continue
            it.update(id=plan["next_id"], status="draft", created_at=now_iso())
            plan["next_id"] += 1
            plan["items"].append(it)
            added.append(it)
        save_plan(cfg, plan)
    for it in added:
        print(f"added {plan_line(it)} [draft]")
    for it, dup in skipped:
        print(f"skipped {it['channel']} {it['day']} {it['time']}: already planned as #{dup['id']} \"{dup.get('title')}\"")
    if added:
        print(f"\n{len(added)} topic(s) wait for the owner's yes: fleet plan approve {compact_ids(added)}")
    return 0


def plan_import(cfg: Config, a) -> int:
    if len(a.args) != 1:
        raise FleetError("usage: fleet plan import FILE.json   (or - to read standard input)")
    src = a.args[0]
    try:
        raw = sys.stdin.read() if src == "-" else Path(os.path.expanduser(src)).read_text(encoding="utf-8-sig")
        data = json.loads(raw)
    except (OSError, ValueError) as e:
        raise FleetError(f"{src}: {e}") from None
    if isinstance(data, dict) and isinstance(data.get("items"), list):
        data = data["items"]
    if not isinstance(data, list) or not data:
        raise FleetError(f"{src}: should hold a JSON list of {{\"channel\", \"day\", \"title\", \"brief\"}}")
    return plan_add_items(cfg, [plan_item(cfg, x, f"{src} item {k + 1}") for k, x in enumerate(data)])


def plan_add(cfg: Config, a) -> int:
    raw = {"channel": a.channel, "day": a.day, "time": a.time, "title": a.title, "brief": a.brief}
    return plan_add_items(cfg, [plan_item(cfg, raw, "fleet plan add")])


def plan_set_status(cfg: Config, a, new: str) -> int:
    done, notes = [], []
    with plan_locked(cfg):
        plan = load_plan(cfg)
        ids = plan_ids(a.args, plan)
        if not ids:
            raise FleetError(f"name the plan numbers: fleet plan {a.action} 12 13, 12-15" +
                             (" or all" if new == "approved" else ""))
        by_id = {i["id"]: i for i in plan["items"]}
        for k in ids:
            i = by_id.get(k)
            if i is None:
                notes.append(f"#{k}: no such plan item")
            elif i.get("status") == "queued":
                notes.append(f"#{k} is already queued on {i.get('node')} as {i.get('job_id')}")
            elif i.get("status") == new:
                notes.append(f"#{k} is already {new}")
            else:
                i["status"], i[f"{new}_at"] = new, now_iso()
                i.pop("error", None)
                done.append(i)
        save_plan(cfg, plan)
    for i in done:
        print(f"{new} {plan_line(i)}")
    if notes:
        print("\n".join(notes))
    if new == "approved" and done:
        print("Each one is queued on its channel's VPS at its time (the hourly fleet-plan job does it).")
    return 0 if done or not notes else 1


def plan_edit(cfg: Config, a) -> int:
    if len(a.args) != 1 or not str(a.args[0]).lstrip("#").isdigit():
        raise FleetError("usage: fleet plan edit NUMBER [--title T] [--brief B] [--day YYYY-MM-DD] [--time HH:MM] [--channel C]")
    k = int(str(a.args[0]).lstrip("#"))
    with plan_locked(cfg):
        plan = load_plan(cfg)
        i = next((x for x in plan["items"] if x["id"] == k), None)
        if i is None:
            raise FleetError(f"#{k}: no such plan item")
        if i.get("status") == "queued":
            raise FleetError(f"#{k} is already queued on {i.get('node')} as {i.get('job_id')}: change that job instead")
        changed = dict(i, **{key: getattr(a, key) for key in ("channel", "day", "time", "title", "brief")
                             if getattr(a, key) is not None})
        i.update(plan_item(cfg, changed, f"#{k}"), edited_at=now_iso())
        save_plan(cfg, plan)
    print(f"changed {plan_line(i)} [{i.get('status')}]")
    return 0


def plan_remove(cfg: Config, a) -> int:
    with plan_locked(cfg):
        plan = load_plan(cfg)
        ids = set(plan_ids(a.args, plan))
        gone = [i for i in plan["items"] if i["id"] in ids and i.get("status") != "queued"]
        kept = [i for i in plan["items"] if i["id"] in ids and i.get("status") == "queued"]
        plan["items"] = [i for i in plan["items"] if i not in gone]
        save_plan(cfg, plan)
    for i in gone:
        print(f"removed {plan_line(i)}")
    for i in kept:
        print(f"kept #{i['id']}: it is already queued on {i.get('node')} as {i.get('job_id')}")
    return 0 if gone or not ids else 1


def plan_run(cfg: Config, a) -> int:
    """Queue the approved items whose time has come, on their channel's VPS."""
    lines, now = [], datetime.now()
    with plan_locked(cfg):
        plan = load_plan(cfg)
        due = [i for i in plan["items"] if i.get("status") == "approved" and plan_due(i) <= now]
        for i in due:  # the job id is kept before the job is sent: a run that stops half way cannot queue it twice
            i.setdefault("job_id", make_job_id(i["channel"]))
        if due and not a.dry_run:
            save_plan(cfg, plan)
        ready = []
        for i in due:
            try:
                ready.append((i, plan_job(cfg, i)))
            except FleetError as e:
                i["error"], i["tries"] = str(e)[:300], i.get("tries", 0) + 1
                lines.append(f"NOT QUEUED {plan_line(i)}: {e}")
        if a.dry_run:
            for _, job in ready:
                print(json.dumps(job, indent=2, ensure_ascii=False))
            return 0
        if ready:
            out, err = io.StringIO(), io.StringIO()
            with contextlib.redirect_stdout(out), contextlib.redirect_stderr(err):
                dispatch_jobs(cfg, [job for _, job in ready], "auto", False, True)
            queued = {q["id"]: q for q in last_json(out.getvalue().encode("utf-8"), [])}
            said = [x.strip() for x in err.getvalue().splitlines() if x.strip()]
            for i, job in ready:
                about = "; ".join(x for x in said if job["id"] in x)
                q = queued.get(job["id"])
                again = re.search(rf"job id {re.escape(job['id'])} already exists on ([a-z0-9-]+)", about)
                if not q and again:  # an earlier run sent it, then stopped before it could say so
                    q, about = {"id": job["id"], "node": again.group(1)}, ""
                if q:
                    i.update(status="queued", queued_at=now_iso(), job_id=q["id"], node=q["node"])
                    i.pop("error", None)
                    lines.append(f"queued {plan_line(i)} on {q['node']} as {q['id']}" + (f" ({about})" if about else ""))
                    continue
                i["error"], i["tries"] = (about or "; ".join(said) or "it was not queued")[:300], i.get("tries", 0) + 1
                if not a.quiet or i["tries"] == 1 or i["tries"] % 6 == 0:  # not every hour while a VPS is down
                    lines.append(f"NOT QUEUED {plan_line(i)}: {i['error']}. It is tried again every hour.")
        save_plan(cfg, plan)
    if lines:
        print("Week plan:\n" + "\n".join(lines) if a.quiet else "\n".join(lines))
    elif not a.quiet:
        print("nothing is due yet")
    return 0


def plan_summary(cfg: Config, since: float) -> dict:
    """The week plan's part of the daily report."""
    try:
        items = load_plan(cfg)["items"]
    except FleetError as e:
        return {"error": str(e)}
    now = datetime.now()
    drafts = [i for i in items if i.get("status") == "draft"]
    return {
        "drafts": drafts,
        "late_drafts": [i for i in drafts if plan_due(i) <= now],
        "approved_ahead": [i for i in items if i.get("status") == "approved" and plan_due(i) > now],
        "not_queued": [i for i in items if i.get("status") == "approved" and i.get("error")],
        "queued": [i for i in items if i.get("status") == "queued" and (parse_stamp(i.get("queued_at")) or 0) >= since],
    }


def cmd_plan(cfg: Config, a) -> int:
    if a.action == "add":
        missing = [f"--{k}" for k in ("channel", "day", "title") if not getattr(a, k)]
        if missing:
            raise FleetError(f"fleet plan add needs {', '.join(missing)}")
    actions = {"show": plan_show, "slots": plan_slots, "add": plan_add, "import": plan_import, "edit": plan_edit,
               "remove": plan_remove, "run": plan_run,
               "approve": lambda c, x: plan_set_status(c, x, "approved"),
               "reject": lambda c, x: plan_set_status(c, x, "rejected")}
    return actions[a.action](cfg, a)


# --------------------------------------------------------------------------- ideas

# The ideas list (ideas.json next to fleet.ini): notes and features to build later, best first.
# The studio's pitch room reads it out on the pixel lot. Until the owner changes it, it holds
# these starter ideas: (title, note, status).
IDEA_STATUSES = ("idea", "next", "building", "built")
IDEA_TITLE_MAX, IDEA_NOTE_MAX = 80, 1000
STARTER_IDEAS = (
    ("Post everywhere", "Each short also goes to Facebook Reels and Pinterest, through their official APIs. "
                        "Same video, more reach.", "idea"),
    ("Go multilingual", "A dubbed copy of each video in Spanish, Portuguese or Hindi, with translated captions, "
                        "for extra channels.", "idea"),
    ("Answer comments early", "In a video's first hours, Hermes drafts replies on Telegram for you to send, and "
                              "keeps viewers' questions as new topics.", "idea"),
    ("Titles people search for", "Before it names a video, Hermes checks what people search for and the videos "
                                 "it would compete with.", "idea"),
    ("Remake the hits", "When a video takes off, the Sunday plan suggests a part 2 or a new angle.", "idea"),
    ("Affiliate links", "Matching links from your own list go in each description, with the disclosure line.", "idea"),
    ("Run series", "Recurring formats like \"Part 3\" or \"Day 12 of...\", planned in the week plan, so viewers "
                   "come back.", "idea"),
    ("Trend looker", "The zeppelin over the lot. Three times a day it looks at what is rising on YouTube in each "
                     "channel's niche, Hermes pitches a video on it, and \"go\" makes it next in that channel's "
                     "queue.", "built"),
)


def ideas_file(cfg: Config) -> Path:
    return cfg.path.parent / "ideas.json"


def load_ideas(cfg: Config) -> dict:
    """The ideas list, best first: the starter ideas until the owner changes it."""
    p = ideas_file(cfg)
    if not p.exists():
        return {"version": 1, "starter": True,
                "ideas": [{"title": t, "note": n, "status": st, "added": ""} for t, n, st in STARTER_IDEAS]}
    try:
        d = json.loads(p.read_text(encoding="utf-8-sig"))
    except (OSError, ValueError) as e:
        raise FleetError(f"{p} cannot be read ({e}); fix it or move it away") from None
    if not isinstance(d, dict) or not isinstance(d.get("ideas"), list):
        raise FleetError(f"{p} is not an ideas list")
    d["ideas"] = [dict(i, title=str(i["title"]).strip(), note=str(i.get("note") or "").strip(),
                       status=i.get("status") if i.get("status") in IDEA_STATUSES else "idea")
                  for i in d["ideas"] if isinstance(i, dict) and str(i.get("title") or "").strip()]
    return d


def save_ideas(cfg: Config, d: dict) -> None:
    d.pop("starter", None)
    p = ideas_file(cfg)
    tmp = p.with_name(p.name + ".tmp")
    write_file(tmp, json.dumps(d, indent=2, ensure_ascii=False) + "\n")
    os.replace(tmp, p)


def ideas_locked(cfg: Config):
    """Hold the ideas list's lock: Hermes and the owner can change it at once."""
    return file_lock(ideas_file(cfg).with_name("ideas.lock"), "the ideas list")


def idea_number(v, d: dict) -> int:
    s, n = str(v).strip().lstrip("#"), len(d["ideas"])
    if not n:
        raise FleetError("the ideas list is empty")
    if not s.isdigit() or not 1 <= int(s) <= n:
        raise FleetError(f"{v!r} is not an idea number: fleet ideas shows them, 1 to {n}")
    return int(s)


def idea_text(title, note) -> tuple:
    title, note = " ".join(str(title or "").split()), str(note or "").strip()
    if not title:
        raise FleetError('an idea needs a title: fleet ideas add "Trend looker" --note "what it does"')
    if len(title) > IDEA_TITLE_MAX:
        raise FleetError(f"keep the title short ({IDEA_TITLE_MAX} characters at most) and put the rest in --note")
    if len(note) > IDEA_NOTE_MAX:
        raise FleetError(f"the note has {len(note)} characters; {IDEA_NOTE_MAX} at most")
    return title, note


def idea_line(k: int, i: dict) -> str:
    return f"{k}. {i['title']}" + ("" if i["status"] == "idea" else f" [{i['status']}]")


def ideas_list(cfg: Config, a) -> int:
    d = load_ideas(cfg)
    if a.json:
        print(json.dumps([dict(i, n=k) for k, i in enumerate(d["ideas"], 1)], indent=2, ensure_ascii=False))
        return 0
    if not d["ideas"]:
        print('no ideas yet: fleet ideas add "Title" --note "what it does"')
        return 0
    for k, i in enumerate(d["ideas"], 1):
        print(idea_line(k, i))
        if i["note"]:
            print(f"   {i['note']}")
    if d.get("starter"):
        print("\nThese are the starter ideas. Change them with fleet ideas add, edit, move and remove.")
    return 0


def ideas_add(cfg: Config, a) -> int:
    title, note = idea_text(" ".join(a.args), a.note)
    with ideas_locked(cfg):
        d = load_ideas(cfg)
        n = len(d["ideas"])
        at = n + 1 if a.at is None else a.at
        if not 1 <= at <= n + 1:
            raise FleetError(f"--at must be 1 to {n + 1}")
        i = {"title": title, "note": note, "status": a.status or "idea", "added": datetime.now().date().isoformat()}
        d["ideas"].insert(at - 1, i)
        save_ideas(cfg, d)
    print(f"added {idea_line(at, i)}")
    return 0


def ideas_edit(cfg: Config, a) -> int:
    if len(a.args) != 1:
        raise FleetError("usage: fleet ideas edit NUMBER [--title T] [--note N] [--status idea|next|building|built]")
    if a.title is None and a.note is None and a.status is None:
        raise FleetError("say what changes: --title, --note or --status")
    with ideas_locked(cfg):
        d = load_ideas(cfg)
        k = idea_number(a.args[0], d)
        i = d["ideas"][k - 1]
        title, note = idea_text(i["title"] if a.title is None else a.title, i["note"] if a.note is None else a.note)
        was = i["status"]
        i.update(title=title, note=note, status=a.status or was, edited=datetime.now().date().isoformat())
        if i["status"] == "built" and was != "built":  # built ideas wait at the end of the list
            d["ideas"].append(d["ideas"].pop(k - 1))
            k = len(d["ideas"])
        save_ideas(cfg, d)
    print(f"changed {idea_line(k, i)}")
    return 0


def ideas_move(cfg: Config, a) -> int:
    args, to = list(a.args), a.to
    if to is None and len(args) == 2:
        to = args.pop()
    if len(args) != 1 or to is None:
        raise FleetError("usage: fleet ideas move NUMBER --to NUMBER")
    with ideas_locked(cfg):
        d = load_ideas(cfg)
        k, m = idea_number(args[0], d), idea_number(to, d)
        i = d["ideas"].pop(k - 1)
        d["ideas"].insert(m - 1, i)
        save_ideas(cfg, d)
    print(f"moved {i['title']} from {k} to {m}")
    return 0


def ideas_remove(cfg: Config, a) -> int:
    specs = [x for arg in a.args for x in str(arg).split(",") if x.strip()]
    if not specs:
        raise FleetError("name the idea numbers: fleet ideas remove 3 (or 3,5)")
    with ideas_locked(cfg):
        d = load_ideas(cfg)
        ks = sorted({idea_number(x, d) for x in specs})
        gone = [(k, d["ideas"][k - 1]) for k in ks]
        for k in reversed(ks):
            d["ideas"].pop(k - 1)
        save_ideas(cfg, d)
    for k, i in gone:
        print(f"removed {idea_line(k, i)}")
    return 0


def cmd_ideas(cfg: Config, a) -> int:
    return {"list": ideas_list, "add": ideas_add, "edit": ideas_edit, "move": ideas_move,
            "remove": ideas_remove}[a.action](cfg, a)


def studio_ideas(cfg: Config) -> dict:
    """The ideas list as the studio shows it, or what is wrong with ideas.json."""
    try:
        d = load_ideas(cfg)
    except FleetError as e:
        return {"ideas": [], "ideas_error": str(e)[:300]}
    return {"ideas": [{"title": i["title"], "note": i["note"], "status": i["status"]} for i in d["ideas"]],
            "ideas_starter": bool(d.get("starter"))}


# --------------------------------------------------------------------------- publishing

PUBLISH_PLATFORMS = ("youtube", "tiktok", "instagram")
PUBLISH_API = {  # FLEET_PUBLISH_FAKE_API points them all at one local server, for the tests
    "google_auth": "https://accounts.google.com/o/oauth2/v2/auth",
    "google_token": "https://oauth2.googleapis.com/token",
    "youtube_upload": "https://www.googleapis.com/upload/youtube/v3",
    "youtube_data": "https://www.googleapis.com/youtube/v3",  # the trend looker: public data, with an API key
    "tiktok_auth": "https://www.tiktok.com/v2/auth/authorize/",
    "tiktok_api": "https://open.tiktokapis.com/v2",
    "instagram_api": "https://graph.instagram.com/v25.0",
    "instagram_root": "https://graph.instagram.com",
}
YOUTUBE_SCOPE = "https://www.googleapis.com/auth/youtube.upload"
TIKTOK_SCOPES = "user.info.basic,video.upload"
TIKTOK_PORT = 8741          # the TikTok app's redirect URI: http://127.0.0.1:8741/callback/
YOUTUBE_CHUNK = 8 * 2**20   # resumable upload pieces: a multiple of 256 KiB
TIKTOK_CHUNK = 10_000_000   # TikTok wants pieces of 5 to 64 MB; a smaller video goes whole
INSTAGRAM_WAIT = 300        # Meta: check a container once a minute, for no more than 5 minutes
VIDEO_MIME = {".mp4": "video/mp4", ".m4v": "video/mp4", ".mov": "video/quicktime", ".webm": "video/webm"}
THUMB_STEMS = ("thumbnail", "thumb", "cover", "poster")


def api(key: str) -> str:
    fake = os.environ.get("FLEET_PUBLISH_FAKE_API", "")
    return f"{fake.rstrip('/')}/{key}" if fake else PUBLISH_API[key]


def poll_seconds(default: float) -> float:
    return number(os.environ.get("FLEET_PUBLISH_POLL_SECONDS"), default)


def random_token(n: int = 32) -> str:
    return base64.urlsafe_b64encode(os.urandom(n)).rstrip(b"=").decode("ascii")


def api_message(body: bytes) -> str:
    """The reason in a platform's error answer, short."""
    try:
        d = json.loads(body or b"{}")
    except ValueError:
        return text(body)[:200] or "no details"
    err = d.get("error") if isinstance(d, dict) else None
    if isinstance(err, dict):
        return str(err.get("message") or err.get("error_user_msg") or err.get("code") or err)[:300]
    if isinstance(d, dict) and (d.get("error_description") or err):
        return str(d.get("error_description") or err)[:300]
    return text(body)[:200]


def http_call(method: str, url: str, *, headers=None, data=None, form=None, js=None, ok=(200, 201),
              timeout: int = 120) -> tuple:
    """(status, headers with lower-case names, body). Any other status is a FleetError."""
    import http.client
    import urllib.error
    import urllib.request
    hdrs = dict(headers or {})
    if form is not None:
        data = urlencode(form).encode("utf-8")
        hdrs.setdefault("Content-Type", "application/x-www-form-urlencoded")
    elif js is not None:
        data = json.dumps(js).encode("utf-8")
        hdrs.setdefault("Content-Type", "application/json; charset=UTF-8")
    req = urllib.request.Request(url, data=data, method=method, headers=hdrs)
    where = url.split("?")[0]
    try:
        with urllib.request.urlopen(req, timeout=timeout) as r:
            status, rh, body = r.status, r.headers, r.read()
    except urllib.error.HTTPError as e:
        status, rh, body = e.code, e.headers, e.read()
    except (urllib.error.URLError, OSError, ValueError, http.client.HTTPException) as e:
        raise FleetError(f"{method} {where}: {getattr(e, 'reason', e)}") from None
    if status not in ok:
        raise FleetError(f"{method} {where}: HTTP {status}: {api_message(body)}")
    return status, {k.lower(): v for k, v in (rh or {}).items()}, body


def read_json(path: Path, default=None):
    try:
        return json.loads(path.read_text(encoding="utf-8-sig"))
    except (OSError, ValueError):
        return default


def publish_dir(cfg: Config) -> Path:
    return cfg.secrets_dir / "publish"


def account_file(cfg: Config, platform: str, channel: str) -> Path:
    return publish_dir(cfg) / f"{platform}-{channel_key(channel)}.json"


def save_private(cfg: Config, path: Path, data: dict) -> None:
    fresh = not publish_dir(cfg).is_dir()
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(path.name + ".tmp")
    write_file(tmp, json.dumps(data, indent=2) + "\n")
    if not IS_WINDOWS:
        os.chmod(tmp, 0o600)
    os.replace(tmp, path)
    if fresh or not IS_WINDOWS:
        restrict_dir(path.parent)


def app_keys(cfg: Config, platform: str) -> dict:
    """The owner's own app on the platform: {client_id/client_key, client_secret}."""
    d = publish_dir(cfg)
    if platform == "youtube":
        p = d / "youtube-client.json"
        raw = read_json(p, {})
        c = (raw.get("installed") or raw.get("web") or raw) if isinstance(raw, dict) else {}
        if not (isinstance(c, dict) and c.get("client_id") and c.get("client_secret")):
            if not d.is_dir():  # ready for the file, and private like the rest of the secrets
                d.mkdir(parents=True, exist_ok=True)
                restrict_dir(d)
            raise FleetError(f"no Google app yet: save its OAuth client file (a Desktop app) as {p}. "
                             "docs/operations/publishing.md shows the steps")
        return c
    p = d / "tiktok-app.json"
    if not p.exists():
        save_private(cfg, p, {"client_key": "", "client_secret": ""})
    c = read_json(p, {})
    if not (isinstance(c, dict) and c.get("client_key") and c.get("client_secret")):
        raise FleetError(f"fill in your TikTok app's client key and secret in {p}. "
                         "docs/operations/publishing.md shows the steps")
    return c


def pkce() -> tuple:
    """(verifier, base64url SHA-256 challenge as RFC 7636 has it)"""
    verifier = random_token(48)
    digest = hashlib.sha256(verifier.encode("ascii")).digest()
    return verifier, base64.urlsafe_b64encode(digest).rstrip(b"=").decode("ascii")


def browser_sign_in(make_url, state: str, port: int = 0, path: str = "/", timeout: int = 600) -> tuple:
    """Open the platform's sign-in page and wait until it sends the browser back to this
    computer (http://127.0.0.1:PORT/PATH). Returns (code, the redirect address)."""
    import webbrowser
    from http.server import BaseHTTPRequestHandler, HTTPServer
    got = {}

    class Back(BaseHTTPRequestHandler):
        def do_GET(self):
            u = urlparse(self.path)
            q = {k: v[0] for k, v in parse_qs(u.query).items()}
            if u.path.rstrip("/") != path.rstrip("/") or not ("code" in q or "error" in q):
                self.send_response(404)
                self.end_headers()
                return
            got.update(q)
            good = "code" in q and q.get("state") == state
            msg = ("Signed in. You can close this tab and go back to the terminal." if good else
                   "The sign-in did not work. Go back to the terminal to see why.")
            body = f"<!doctype html><meta charset=utf-8><title>fleet</title><p>{msg}</p>".encode()
            self.send_response(200)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)

        def log_message(self, *args):
            pass

    try:
        srv = HTTPServer(("127.0.0.1", port), Back)
    except OSError as e:
        raise FleetError(f"cannot wait for the sign-in on port {port} ({e}); close what uses it or pass --port") from None
    redirect = f"http://127.0.0.1:{srv.server_address[1]}{path}"
    url = make_url(redirect)
    print(f"Opening the sign-in page in your browser. If it does not open, copy this link into it:\n  {url}")
    webbrowser.open(url)
    srv.timeout = 1
    deadline = time.time() + timeout
    try:
        while not got and time.time() < deadline:
            srv.handle_request()
    finally:
        srv.server_close()
    if not got:
        raise FleetError("the sign-in page did not answer within 10 minutes; run the command again")
    if got.get("error"):
        raise FleetError(f"the sign-in was refused: {got.get('error_description') or got['error']}")
    if got.get("state") != state:
        raise FleetError("the answer did not come from this sign-in; run the command again")
    return got["code"], redirect


def yes_no(answer, question: str) -> bool:
    if answer is None:
        if not sys.stdin.isatty():
            raise FleetError(f"{question} Answer with --made-for-kids yes or --made-for-kids no")
        answer = input(f"{question} (yes/no): ")
    a = str(answer).strip().lower()
    if a in ("y", "yes", "true", "1"):
        return True
    if a in ("n", "no", "false", "0"):
        return False
    raise FleetError(f"{question} Answer yes or no, not {answer!r}")


def login_youtube(cfg: Config, a, channel: str) -> dict:
    app = app_keys(cfg, "youtube")
    kids = yes_no(a.made_for_kids, f"Are the videos of {channel} made for kids (YouTube asks, by law)?")
    verifier, challenge = pkce()
    state = random_token(16)
    code, redirect = browser_sign_in(lambda r: api("google_auth") + "?" + urlencode({
        "client_id": app["client_id"], "redirect_uri": r, "response_type": "code", "scope": YOUTUBE_SCOPE,
        "code_challenge": challenge, "code_challenge_method": "S256", "state": state,
        "access_type": "offline", "prompt": "consent"}), state, a.port or 0)
    _, _, body = http_call("POST", api("google_token"), form={
        "code": code, "client_id": app["client_id"], "client_secret": app["client_secret"], "redirect_uri": redirect,
        "grant_type": "authorization_code", "code_verifier": verifier})
    tok = json.loads(body)
    if not tok.get("refresh_token"):
        raise FleetError("Google gave no lasting sign-in (refresh token); remove the app's access at "
                         "myaccount.google.com/permissions and sign in again")
    return {"refresh_token": tok["refresh_token"], "access_token": tok.get("access_token"),
            "expires_at": time.time() + number(tok.get("expires_in"), 0), "made_for_kids": kids,
            "synthetic_media": not a.no_ai_label}


def login_tiktok(cfg: Config, a, channel: str) -> dict:
    app = app_keys(cfg, "tiktok")
    verifier = random_token(48)
    challenge = hashlib.sha256(verifier.encode("ascii")).hexdigest()  # TikTok's desktop kit wants hex
    state = random_token(16)
    code, redirect = browser_sign_in(lambda r: api("tiktok_auth") + "?" + urlencode({
        "client_key": app["client_key"], "scope": TIKTOK_SCOPES, "response_type": "code", "redirect_uri": r,
        "state": state, "code_challenge": challenge, "code_challenge_method": "S256"}),
        state, a.port or TIKTOK_PORT, "/callback/")
    _, _, body = http_call("POST", api("tiktok_api") + "/oauth/token/", form={
        "client_key": app["client_key"], "client_secret": app["client_secret"], "code": code,
        "grant_type": "authorization_code", "redirect_uri": redirect, "code_verifier": verifier})
    tok = json.loads(body)
    if not tok.get("access_token"):
        raise FleetError(f"TikTok did not sign you in: {api_message(body)}")
    if "video.upload" not in str(tok.get("scope", "")):
        print("note: TikTok did not grant video.upload; uploads work once TikTok approves your app for it",
              file=sys.stderr)
    return tiktok_tokens(tok, {"open_id": tok.get("open_id")})


def tiktok_tokens(tok: dict, acct: dict) -> dict:
    now = time.time()
    acct.update(access_token=tok["access_token"], expires_at=now + number(tok.get("expires_in"), 0),
                refresh_token=tok.get("refresh_token") or acct.get("refresh_token"), scope=tok.get("scope"))
    if tok.get("refresh_expires_in"):
        acct["refresh_expires_at"] = now + number(tok["refresh_expires_in"], 0)
    return acct


def login_instagram(cfg: Config, a, channel: str) -> dict:
    import getpass
    print("Paste the access token from your Meta app (Instagram > API setup with Instagram login > Generate\n"
          "token). It is not shown while you paste it.")
    token = getpass.getpass("Instagram access token: ").strip()
    if not token:
        raise FleetError("no token given")
    try:
        _, _, body = http_call("GET", api("instagram_api") + "/me?" + urlencode(
            {"fields": "user_id,username", "access_token": token}))
        me = json.loads(body)
    except FleetError as e:
        if not a.ig_user_id:
            raise FleetError(f"Instagram did not accept the token: {e}") from None
        me = {}
    user_id = a.ig_user_id or me.get("user_id") or me.get("id")
    if not user_id:
        raise FleetError("Instagram did not say which account the token is for; pass --ig-user-id")
    return {"access_token": token, "user_id": str(user_id), "username": me.get("username"),
            "refreshed_at": time.time()}


def google_access(cfg: Config, path: Path, acct: dict) -> str:
    if acct.get("access_token") and number(acct.get("expires_at"), 0) > time.time() + 300:
        return acct["access_token"]
    app = app_keys(cfg, "youtube")
    try:
        _, _, body = http_call("POST", api("google_token"), form={
            "client_id": app["client_id"], "client_secret": app["client_secret"],
            "refresh_token": acct.get("refresh_token", ""), "grant_type": "refresh_token"})
    except FleetError as e:
        raise FleetError(f"{e}. Sign in again: fleet publish --login youtube --channel \"{acct.get('channel')}\" "
                         "(a Google app left in Testing signs you out after 7 days)") from None
    tok = json.loads(body)
    acct.update(access_token=tok["access_token"], expires_at=time.time() + number(tok.get("expires_in"), 3600))
    save_private(cfg, path, acct)
    return acct["access_token"]


def tiktok_access(cfg: Config, path: Path, acct: dict) -> str:
    if acct.get("access_token") and number(acct.get("expires_at"), 0) > time.time() + 300:
        return acct["access_token"]
    app = app_keys(cfg, "tiktok")
    _, _, body = http_call("POST", api("tiktok_api") + "/oauth/token/", form={
        "client_key": app["client_key"], "client_secret": app["client_secret"], "grant_type": "refresh_token",
        "refresh_token": acct.get("refresh_token", "")})
    tok = json.loads(body)
    if not tok.get("access_token"):
        raise FleetError(f"TikTok signed you out ({api_message(body)}). Sign in again: "
                         f"fleet publish --login tiktok --channel \"{acct.get('channel')}\"")
    save_private(cfg, path, tiktok_tokens(tok, acct))
    return acct["access_token"]


def instagram_access(cfg: Config, path: Path, acct: dict) -> str:
    """The token, made new when it is over a day old (a token not renewed in 60 days ends)."""
    age = time.time() - number(acct.get("refreshed_at"), 0)
    if age > 86400:
        try:
            _, _, body = http_call("GET", api("instagram_root") + "/refresh_access_token?" + urlencode(
                {"grant_type": "ig_refresh_token", "access_token": acct.get("access_token", "")}))
            acct.update(access_token=json.loads(body)["access_token"], refreshed_at=time.time())
            save_private(cfg, path, acct)
        except (FleetError, KeyError, ValueError) as e:
            if age > 59 * 86400:
                raise FleetError(f"the Instagram token has ended ({e}). Make a new one and run: fleet publish "
                                 f"--login instagram --channel \"{acct.get('channel')}\"") from None
            print(f"note: could not renew the Instagram token ({e}); it still works for now", file=sys.stderr)
    return acct["access_token"]


def pulled_video(cfg: Config, node: str, jid: str) -> dict:
    """What the job made, from its copy on this computer."""
    if not NAME_RE.match(node) or not ID_RE.match(jid):
        raise FleetError("name the VPS and the job id, as fleet jobs prints them")
    d = cfg.results_dir / node / jid
    if not (d / "output").is_dir():
        raise FleetError(f"{node}/{jid} is not on this computer yet: run fleet pull {node} first")
    job = read_json(d / "job.json", {})
    check = read_json(d / "logs" / "check.json")
    meta = read_json(d / "output" / "metadata.json")
    video = None
    named = check.get("video") if isinstance(check, dict) else None
    if isinstance(named, str) and (d / named).is_file() and not Path(named).is_absolute() and ".." not in Path(named).parts:
        video = d / named
    if video is None:
        found = [rel for rel, _ in media_files(d / "output") if rel.suffix.lower() in VIDEO_MIME]
        if found:
            rel = max(found, key=lambda r: (r.parent == Path(".") and r.stem.lower() == "video",
                                            any(w in r.stem.lower() for w in ("final", "video")),
                                            (d / "output" / r).stat().st_size))
            video = d / "output" / rel
    if video is None or video.stat().st_size == 0:
        raise FleetError(f"{node}/{jid} has no video in {d / 'output'}")
    thumb = next((d / "output" / f"{s}{e}" for s in THUMB_STEMS for e in (".png", ".jpg", ".jpeg")
                  if (d / "output" / f"{s}{e}").is_file()), None)
    if not isinstance(meta, dict) or not isinstance(meta.get("title"), str) or not meta["title"].strip():
        raise FleetError(f"{node}/{jid}: output/metadata.json has no title (the job should write title, "
                         "description and tags there)")
    return {"node": node, "id": jid, "dir": d, "video": video, "thumbnail": thumb, "meta": meta,
            "check": check if isinstance(check, dict) else None,
            "channel": job.get("channel") if isinstance(job, dict) else None}


def caption(meta: dict, limit: int = 2200) -> str:
    """The words under a TikTok or Instagram post: the metadata's caption, else its title,
    description and tags as hashtags."""
    if isinstance(meta.get("caption"), str) and meta["caption"].strip():
        return meta["caption"].strip()[:limit]
    tags = [re.sub(r"[^\w]", "", str(t)) for t in meta.get("tags") or [] if isinstance(t, str)]
    tags = " ".join(f"#{t}" for t in tags[:8] if t)
    parts = [meta.get("title", "").strip(), str(meta.get("description") or "").strip(), tags]
    return "\n\n".join(p for p in parts if p)[:limit]


def resumable_put(url: str, video: Path, size: int, mime: str, token: str) -> dict:
    """Send the video to a YouTube upload session, piece by piece; after a broken connection,
    ask the session how much it has and go on from there."""
    offset, tries = 0, 0
    with video.open("rb") as fh:
        while True:
            fh.seek(offset)
            part = fh.read(YOUTUBE_CHUNK)
            hdrs = {"Authorization": f"Bearer {token}", "Content-Type": mime,
                    "Content-Range": f"bytes {offset}-{offset + len(part) - 1}/{size}"}
            try:
                st, rh, body = http_call("PUT", url, headers=hdrs, data=part, ok=(200, 201, 308), timeout=900)
            except FleetError:
                tries += 1
                if tries > 5:
                    raise
                time.sleep(min(60, 2 ** tries) * poll_seconds(1))
                st, rh, body = http_call("PUT", url, headers={"Authorization": f"Bearer {token}",
                                                              "Content-Range": f"bytes */{size}"},
                                         data=b"", ok=(200, 201, 308))
            if st in (200, 201):
                return json.loads(body)
            m = re.search(r"-(\d+)$", rh.get("range", ""))
            offset = int(m.group(1)) + 1 if m else 0


def publish_youtube(cfg: Config, path: Path, acct: dict, v: dict, a, at) -> dict:
    meta, video = v["meta"], v["video"]
    kids = meta.get("made_for_kids", acct.get("made_for_kids"))
    if not isinstance(kids, bool):
        raise FleetError(f"say whether {acct.get('channel')} is made for kids: sign in again with "
                         "fleet publish --login youtube --made-for-kids yes|no")
    token = google_access(cfg, path, acct)
    snippet = {"title": meta["title"].strip()[:100], "description": str(meta.get("description") or "")[:5000]}
    if isinstance(meta.get("tags"), list):
        snippet["tags"] = [str(t) for t in meta["tags"]]
    if meta.get("category_id"):
        snippet["categoryId"] = str(meta["category_id"])
    status = {"privacyStatus": "private", "selfDeclaredMadeForKids": kids,
              "containsSyntheticMedia": bool(meta.get("synthetic_media", acct.get("synthetic_media", True)))}
    if at:
        status["publishAt"] = at
    size, mime = video.stat().st_size, VIDEO_MIME.get(video.suffix.lower(), "video/mp4")
    _, rh, _ = http_call("POST", api("youtube_upload") + "/videos?uploadType=resumable&part=snippet,status",
                         headers={"Authorization": f"Bearer {token}", "X-Upload-Content-Length": str(size),
                                  "X-Upload-Content-Type": mime}, js={"snippet": snippet, "status": status})
    if not rh.get("location"):
        raise FleetError("YouTube opened no upload session")
    vid = resumable_put(rh["location"], video, size, mime, token).get("id")
    if not vid:
        raise FleetError("YouTube took the upload but gave no video id")
    out = {"video_id": vid, "privacy": "private", "studio_url": f"https://studio.youtube.com/video/{vid}/edit"}
    if at:
        out["publish_at"] = at
    if v.get("thumbnail"):
        thumb = v["thumbnail"]
        try:
            http_call("POST", api("youtube_upload") + f"/thumbnails/set?videoId={quote(vid)}",
                      headers={"Authorization": f"Bearer {token}",
                               "Content-Type": "image/png" if thumb.suffix.lower() == ".png" else "image/jpeg"},
                      data=thumb.read_bytes())
            out["thumbnail"] = "set"
        except FleetError as e:
            out["thumbnail"] = f"not set ({e}); custom thumbnails need a verified YouTube channel"
    return out


def tiktok_data(body: bytes) -> dict:
    d = json.loads(body or b"{}")
    err = d.get("error") or {}
    if isinstance(err, dict) and err.get("code") not in (None, "ok"):
        raise FleetError(f"TikTok: {err.get('message') or err.get('code')}")
    return d.get("data") or {}


def publish_tiktok(cfg: Config, path: Path, acct: dict, v: dict, a, at) -> dict:
    token = tiktok_access(cfg, path, acct)
    video = v["video"]
    size = video.stat().st_size
    if not size:
        raise FleetError(f"{video} is empty")
    # TikTok's chunks: 5 to 64 MB, the last one up to 128 MB; a smaller file goes in one piece.
    chunk = TIKTOK_CHUNK if size > TIKTOK_CHUNK else size
    count = size // chunk
    auth = {"Authorization": f"Bearer {token}"}
    _, _, body = http_call("POST", api("tiktok_api") + "/post/publish/inbox/video/init/", headers=auth, js={
        "source_info": {"source": "FILE_UPLOAD", "video_size": size, "chunk_size": chunk,
                        "total_chunk_count": count}})
    data = tiktok_data(body)
    if not data.get("publish_id") or not data.get("upload_url"):
        raise FleetError("TikTok opened no upload")
    mime = VIDEO_MIME.get(video.suffix.lower(), "video/mp4")
    with video.open("rb") as fh:
        for k in range(count):
            first = k * chunk
            last = size - 1 if k == count - 1 else first + chunk - 1  # the last piece takes the rest
            fh.seek(first)
            http_call("PUT", data["upload_url"], data=fh.read(last - first + 1), ok=(200, 201, 206), timeout=900,
                      headers={"Content-Type": mime, "Content-Range": f"bytes {first}-{last}/{size}"})
    out = {"publish_id": data["publish_id"], "caption": caption(v["meta"])}
    deadline = time.time() + 300
    while True:
        _, _, body = http_call("POST", api("tiktok_api") + "/post/publish/status/fetch/", headers=auth,
                               js={"publish_id": data["publish_id"]})
        st = tiktok_data(body)
        out["status"] = st.get("status") or "PROCESSING_UPLOAD"
        if out["status"] == "FAILED":
            raise FleetError(f"TikTok could not take the video: {st.get('fail_reason') or 'no reason given'}")
        if out["status"] in ("SEND_TO_USER_INBOX", "PUBLISH_COMPLETE") or time.time() > deadline:
            return out
        time.sleep(poll_seconds(5))


@contextlib.contextmanager
def shared_publicly(video: Path):
    """A public https link to the video for the few minutes Instagram needs to fetch it,
    with Tailscale Funnel; it is switched off again at the end."""
    ts = tailscale_binary()
    if not ts:
        raise FleetError("Instagram fetches the video from a public link: install Tailscale and turn on Funnel "
                         "(docs/operations/publishing.md), or give --video-url")
    _, name = tailscale_self()
    if not name:
        raise FleetError("this computer has no Tailscale name: turn on MagicDNS for your tailnet")
    flags = ["--https=443", f"--set-path=/fleet-{random_token(18)}.mp4"]
    print("Sharing the video on a secret public link (Tailscale Funnel) while Instagram fetches it...")
    try:
        r = subprocess.run([ts, "funnel", "--bg", *flags, str(video.resolve())], stdin=subprocess.DEVNULL,
                           timeout=600)
    except (OSError, subprocess.TimeoutExpired) as e:
        raise FleetError(f"Tailscale Funnel did not start ({e})") from None
    if r.returncode != 0:
        raise FleetError("Tailscale Funnel did not start (see above); docs/operations/publishing.md shows how to "
                         "turn it on, or give --video-url")
    try:
        yield f"https://{name}{flags[1].split('=', 1)[1]}"
    finally:
        subprocess.run([ts, "funnel", *flags, "off"], stdin=subprocess.DEVNULL, capture_output=True, timeout=120)


def publish_instagram(cfg: Config, path: Path, acct: dict, v: dict, a, at) -> dict:
    token = instagram_access(cfg, path, acct)
    base, user = api("instagram_api"), quote(str(acct.get("user_id", "")))

    def post(url):
        _, _, body = http_call("POST", f"{base}/{user}/media", form={
            "media_type": "REELS", "video_url": url, "caption": caption(v["meta"]), "access_token": token})
        container = json.loads(body).get("id")
        if not container:
            raise FleetError("Instagram made no container for the video")
        deadline = time.time() + INSTAGRAM_WAIT
        while True:
            time.sleep(poll_seconds(60))
            _, _, body = http_call("GET", f"{base}/{quote(str(container))}?" + urlencode(
                {"fields": "status_code", "access_token": token}))
            code = json.loads(body).get("status_code")
            if code == "FINISHED":
                break
            if code in ("ERROR", "EXPIRED") or time.time() > deadline:
                raise FleetError(f"Instagram could not take the video ({code or 'no answer'} after "
                                 f"{INSTAGRAM_WAIT // 60} minutes); nothing was posted")
        _, _, body = http_call("POST", f"{base}/{user}/media_publish",
                               form={"creation_id": container, "access_token": token})
        return {"media_id": json.loads(body).get("id"), "container_id": container}

    if a.video_url:
        if not a.video_url.startswith("https://"):
            raise FleetError("--video-url must be a public https:// link")
        return post(a.video_url)
    with shared_publicly(v["video"]) as url:
        return post(url)


PUBLISHERS = {"youtube": publish_youtube, "tiktok": publish_tiktok, "instagram": publish_instagram}


def publish_at(value):
    """--at "2026-12-01 18:00" (this computer's time) as the UTC time YouTube wants."""
    if not value:
        return None
    try:
        local = datetime.strptime(value.strip().replace("T", " "), "%Y-%m-%d %H:%M")
    except ValueError:
        raise FleetError(f"--at wants a time like \"2026-12-01 18:00\" (your computer's time), not {value!r}") from None
    if local <= datetime.now() + timedelta(minutes=15):
        raise FleetError("--at must be at least 15 minutes from now")
    return local.astimezone(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def publish_words(platform: str, r: dict) -> str:
    if r.get("error"):
        return f"{platform}: NOT DONE: {r['error']}"
    if platform == "youtube":
        when = (f"it goes public by itself on {short_time(parse_stamp(r['publish_at']))}" if r.get("publish_at")
                else "it stays private until you publish it in YouTube Studio")
        return f"youtube: uploaded as a private draft, {when}: {r['studio_url']} (thumbnail {r.get('thumbnail', 'none')})"
    if platform == "tiktok":
        state = ("is in your TikTok inbox: open TikTok, tap the notification, check it and post it"
                 if r.get("status") in ("SEND_TO_USER_INBOX", "PUBLISH_COMPLETE") else
                 f"is still being processed by TikTok ({r.get('status')}); it reaches your TikTok inbox soon")
        return f"tiktok: the video {state}. Caption to paste:\n{r.get('caption', '')}"
    return f"instagram: posted as a Reel (media {r.get('media_id')})"


def publish_accounts(cfg: Config) -> int:
    d = publish_dir(cfg)
    rows = [("PLATFORM", "CHANNEL", "ACCOUNT", "SIGNED IN", "NOTE")]
    for p in sorted(d.glob("*-*.json")) if d.is_dir() else []:
        acct = read_json(p, {})
        if not isinstance(acct, dict) or acct.get("platform") not in PUBLISH_PLATFORMS:
            continue
        note = ""
        if acct["platform"] == "youtube":
            note = (f"made for kids: {'yes' if acct.get('made_for_kids') else 'no'}, AI label: "
                    f"{'yes' if acct.get('synthetic_media', True) else 'no'}")
        elif acct["platform"] == "tiktok" and acct.get("refresh_expires_at"):
            note = f"sign in again before {datetime.fromtimestamp(acct['refresh_expires_at']).strftime('%d %b %Y')}"
        elif acct["platform"] == "instagram":
            note = f"token renewed {int((time.time() - number(acct.get('refreshed_at'), 0)) / 86400)} day(s) ago"
        rows.append((acct["platform"], acct.get("channel", "?"), acct.get("username") or acct.get("open_id") or "-",
                     str(acct.get("connected_at", "?"))[:10], note))
    if len(rows) == 1:
        print(f"no accounts yet: fleet publish --login youtube|tiktok|instagram --channel \"<channel>\" "
              f"(they are kept in {d})")
        return 0
    print_table(rows)
    return 0


def publish_needs(cfg: Config) -> list:
    """Sign-ins that end soon, for the daily report."""
    d, out = publish_dir(cfg), []
    for p in sorted(d.glob("*-*.json")) if d.is_dir() else []:
        acct = read_json(p, {})
        if not isinstance(acct, dict):
            continue
        who = f"{acct.get('platform')} for {acct.get('channel')}"
        if acct.get("platform") == "instagram" and time.time() - number(acct.get("refreshed_at"), time.time()) > 45 * 86400:
            out.append(f"Publishing: the {who} token ends within 15 days unless a post renews it; "
                       f"make a new one with fleet publish --login instagram --channel \"{acct.get('channel')}\"")
        if acct.get("platform") == "tiktok" and number(acct.get("refresh_expires_at"), 1e12) - time.time() < 30 * 86400:
            out.append(f"Publishing: the {who} sign-in ends within 30 days; "
                       f"fleet publish --login tiktok --channel \"{acct.get('channel')}\"")
    return out


def publish_login(cfg: Config, a) -> int:
    platform = a.login.strip().lower()
    if platform not in PUBLISH_PLATFORMS:
        raise FleetError(f"--login takes one of {', '.join(PUBLISH_PLATFORMS)}")
    if not a.channel:
        raise FleetError("add --channel \"<channel>\": each channel has its own accounts")
    known = {channel_key(c): c for c in plan_channels(cfg)}
    channel = known.get(channel_key(a.channel), a.channel.strip())
    acct = {"youtube": login_youtube, "tiktok": login_tiktok, "instagram": login_instagram}[platform](cfg, a, channel)
    acct.update(platform=platform, channel=channel, connected_at=now_iso())
    path = account_file(cfg, platform, channel)
    save_private(cfg, path, acct)
    print(f"Signed in: {platform} for {channel} (kept in {path})")
    return 0


def cmd_publish(cfg: Config, a) -> int:
    if a.accounts:
        return publish_accounts(cfg)
    if a.login:
        return publish_login(cfg, a)
    if not (a.node and a.job_id and a.to):
        raise FleetError("usage: fleet publish NODE JOB_ID --to youtube,tiktok,instagram [--at \"YYYY-MM-DD HH:MM\"]")
    wanted = list(dict.fromkeys(p.strip().lower() for p in a.to.split(",") if p.strip()))
    odd = [p for p in wanted if p not in PUBLISH_PLATFORMS]
    if odd or not wanted:
        raise FleetError(f"--to takes youtube, tiktok and instagram, not {', '.join(odd) or 'nothing'}")
    if "instagram" in wanted and not a.now:
        raise FleetError("Instagram has no drafts: the Reel is public at once. Add --now when that is what you want")
    at = publish_at(a.at)
    if at and wanted != ["youtube"]:
        print("note: --at is for YouTube; the others are sent now", file=sys.stderr)
    v = pulled_video(cfg, a.node, a.job_id)
    channel = a.channel or v["channel"]
    if not channel:
        raise FleetError("the job names no channel: add --channel \"<channel>\"")
    chk = v["check"]
    if chk and chk.get("ok") is False and not a.anyway:
        raise FleetError("the video check found problems: " + "; ".join(map(str, chk.get("problems") or [])) +
                         f". Make it again (fleet retry {a.node} {a.job_id}), or add --anyway")
    accounts = {}
    for p in wanted:
        path = account_file(cfg, p, channel)
        acct = read_json(path)
        if not isinstance(acct, dict):
            raise FleetError(f"no {p} account for {channel} yet: fleet publish --login {p} --channel \"{channel}\"")
        accounts[p] = (path, acct)
    if a.dry_run:
        print(f"would send {v['video']} ({v['video'].stat().st_size / 1e6:.1f} MB) for {channel}:")
        print(f"  title: {v['meta']['title']}")
        for p in wanted:
            print(f"  {p}: " + {"youtube": f"a private draft{' that goes public on ' + a.at if at else ''}",
                               "tiktok": "an upload to the TikTok inbox, posted by you in the app",
                               "instagram": "a public Reel, at once"}[p])
        if not chk:
            print("  note: this video has no check verdict (fleet check)")
        return 0
    done, rc = {}, 0
    for p in wanted:
        path, acct = accounts[p]
        try:
            done[p] = PUBLISHERS[p](cfg, path, acct, v, a, at)
        except FleetError as e:
            done[p], rc = {"error": str(e)}, 1
        if not a.json:
            print(publish_words(p, done[p]))
    record = read_json(v["dir"] / "publish.json", {})
    record = record if isinstance(record, dict) else {}
    with (cfg.results_dir / "publish.jsonl").open("a", encoding="utf-8") as log:
        for p, r in done.items():
            entry = dict(r, at=now_iso(), channel=channel)
            if not r.get("error"):
                record[p] = entry
            log.write(json.dumps(dict(entry, platform=p, node=a.node, id=a.job_id, title=v["meta"]["title"])) + "\n")
    write_file(v["dir"] / "publish.json", json.dumps(record, indent=2) + "\n")
    if a.json:
        print(json.dumps(done, indent=2))
    return rc


def publish_summary(cfg: Config, since: float) -> dict:
    """How many videos went to each platform since then, from results_dir/publish.jsonl."""
    log, counts = cfg.results_dir / "publish.jsonl", {}
    if log.exists():
        for line in log.read_text(encoding="utf-8", errors="replace").splitlines()[-3000:]:
            e = None
            try:
                e = json.loads(line)
            except ValueError:
                pass
            if isinstance(e, dict) and not e.get("error") and (parse_stamp(e.get("at")) or 0) >= since:
                counts[str(e.get("platform"))] = counts.get(str(e.get("platform")), 0) + 1
    return counts


# --------------------------------------------------------------------------- the trend looker

# The trend looker is the zeppelin over the studio's lot. It runs on this computer, beside
# Hermes, never on a VPS. Three times a day Hermes' fleet-trends job runs `fleet trends look
# --wake`: one YouTube search per channel for the videos of the last two days in the channel's
# niche, most watched first, and their views an hour. When one is new and rising fast, Hermes
# pitches the owner a video on it, and "go 3" queues that video first on the channel's own VPS.
# It watches YouTube only, through Google's official YouTube Data API.
TRENDS_HOURS = 48           # how far back a look searches
TRENDS_ASK = 10             # videos asked for per channel and look
TRENDS_KEEP = 5             # the fastest of them kept per channel
TRENDS_MIN_VPH = 1000       # views an hour that make a find "rising", unless the channel's watch says otherwise
TRENDS_UNITS = 101          # one look at one channel: a search (100 quota units) and the videos' numbers (1)
TRENDS_QUIET_HOURS = 20     # a channel that got a pitch this recently is not pitched again
TRENDS_SEEN_DAYS = 7        # a video found once is not news again for this long
TRENDS_PITCH_HOURS = 48     # a pitch nobody answered expires after this long: trends fade
TRENDS_KEEP_DAYS = 30       # answered pitches leave trends.json after this long
TREND_WORDS_MAX = 8
PITCH_TITLE_MAX = 100       # YouTube's limit for a title
PITCH_STATUSES = ("waiting", "go", "dropped", "expired")
WAKE_NOT = '{"wakeAgent": false}'  # the last line of a Hermes cron script that lets the agent sleep
TRENDS_PROMPT = (
    "The trend looker found videos rising fast on YouTube in the niches of the owner's channels; they are listed "
    "above. Follow \"Spot a trend\" in the fleet-ops skill. For each channel, decide whether one of its finds would "
    "make a good video for that channel: a fresh angle on the same subject, never a copy, and nothing close to a "
    "topic already planned or made (`fleet plan show --week all --json`, `fleet jobs --json`). For at most one find "
    "per channel, run `fleet trends pitch \"<channel>\" \"<title>\" --brief \"<two or three sentences>\" --from "
    "<find id>`. Then send the owner the new pitches as `fleet trends` prints them under Pitches, and say how to "
    "answer: \"go 3\" makes that video next on its channel's VPS, \"drop 3\" lets it go. Never say go yourself. If "
    "no find is worth a video, answer with only [SILENT].")


def trends_file(cfg: Config) -> Path:
    return cfg.path.parent / "trends.json"


def trends_key_file(cfg: Config) -> Path:
    return publish_dir(cfg) / "youtube-api-key.json"


def trends_key(cfg: Config) -> str:
    d = read_json(trends_key_file(cfg), {})
    k = d.get("key") if isinstance(d, dict) else ""
    return k.strip() if isinstance(k, str) else ""


def quota_day() -> str:
    """The day YouTube counts its quota in: it starts again at midnight, Pacific time (UTC-8 is near enough)."""
    return (datetime.now(timezone.utc) - timedelta(hours=8)).strftime("%Y-%m-%d")


def load_trends(cfg: Config) -> dict:
    """What the trend looker keeps in trends.json next to fleet.ini: each channel's watch, the last
    looks and finds, the videos already seen, the day's quota, and the pitches."""
    p, d = trends_file(cfg), {}
    if p.exists():
        try:
            d = json.loads(p.read_text(encoding="utf-8-sig"))
        except (OSError, ValueError) as e:
            raise FleetError(f"{p}: {e}. Fix it, or move it away to start the trend looker afresh") from None
        if not isinstance(d, dict):
            raise FleetError(f"{p} should hold one JSON object; move it away to start the trend looker afresh")
    part = lambda k, kind: d.get(k) if isinstance(d.get(k), kind) else kind()  # noqa: E731
    q = part("quota", dict)
    pitches = [x for x in part("pitches", list) if isinstance(x, dict) and isinstance(x.get("n"), int)
               and isinstance(x.get("channel"), str) and isinstance(x.get("title"), str)]
    now = time.time()
    for x in pitches:
        if x.get("status") not in PITCH_STATUSES:
            x["status"] = "waiting"
        at = parse_stamp(x.get("at")) or now
        if x["status"] == "waiting" and now - at > TRENDS_PITCH_HOURS * 3600:
            x.update(status="expired", answered_at=datetime.fromtimestamp(at + TRENDS_PITCH_HOURS * 3600, timezone.utc)
                     .strftime("%Y-%m-%dT%H:%M:%SZ"))
    return {
        "version": 1,
        "watch": {k: v for k, v in part("watch", dict).items() if isinstance(v, dict)},
        "looks": [x for x in part("looks", list) if isinstance(x, dict)][-30:],
        "quota": {"day": str(q.get("day") or ""), "units": int(number(q.get("units"), 0))},
        "finds": {k: [f for f in v if isinstance(f, dict) and f.get("id")]
                  for k, v in part("finds", dict).items() if isinstance(v, list)},
        "seen": {k: v for k, v in part("seen", dict).items() if isinstance(v, (int, float)) and not isinstance(v, bool)},
        "pitches": pitches,
        "next": max([int(number(d.get("next"), 1))] + [x["n"] + 1 for x in pitches]),
    }


def save_trends(cfg: Config, d: dict) -> None:
    now = time.time()
    d["seen"] = {k: v for k, v in d["seen"].items() if now - v < TRENDS_SEEN_DAYS * 86400}
    d["pitches"] = [x for x in d["pitches"] if x["status"] == "waiting" or
                    now - (parse_stamp(x.get("answered_at") or x.get("at")) or now) < TRENDS_KEEP_DAYS * 86400]
    p = trends_file(cfg)
    tmp = p.with_name(p.name + ".tmp")
    write_file(tmp, json.dumps(d, indent=2, ensure_ascii=False) + "\n")
    os.replace(tmp, p)


def trends_locked(cfg: Config):
    return file_lock(trends_file(cfg).with_name("trends.lock"), "the trend looker")


def trend_watch(cfg: Config, d: dict, channel: str) -> dict:
    """What the looker searches for one channel: the words the owner gave it, or else the first
    sentence of the channel's ideas for the week plan, or else the channel's name."""
    w = d["watch"].get(channel_key(channel)) or {}
    words = [" ".join(str(x).split()) for x in w.get("words") or [] if str(x).strip()][:TREND_WORDS_MAX]
    own = bool(words)
    if not words:
        try:
            ideas = channel_schedule(cfg, channel)[2]
        except FleetError:
            ideas = ""
        first = re.split(r"[.!?\n]", ideas or "", maxsplit=1)[0]
        words = [x.strip(" -'\"") for x in re.split(r",|;|/|&|\band\b|\bor\b", first, flags=re.I)]
        words = [x for x in words if 2 <= len(x) <= 40][:5] or [channel]
    return {"channel": channel, "words": words, "own_words": own, "region": str(w.get("region") or ""),
            "language": str(w.get("language") or ""), "min_vph": int(number(w.get("min_vph"), TRENDS_MIN_VPH)),
            "off": bool(w.get("off"))}


def trend_channels(cfg: Config, d: dict) -> list:
    return [trend_watch(cfg, d, c) for c in plan_channels(cfg)]


def made_on(cfg: Config, channel: str) -> str:
    nodes = channel_home([n for n in cfg.nodes.values() if n.enabled], channel)[0]
    return ", ".join(n.name for n in nodes) or "no VPS yet"


def youtube_data(key: str, what: str, **params) -> dict:
    """GET from the YouTube Data API with the owner's API key (public data only)."""
    url = f"{api('youtube_data')}/{what}?" + urlencode(dict(params, key=key))
    _, _, body = http_call("GET", url, timeout=30)  # its errors name the address without the key
    try:
        d = json.loads(body)
    except ValueError:
        raise FleetError(f"YouTube {what}: the answer was not JSON") from None
    return d if isinstance(d, dict) else {}


def rising_now(key: str, w: dict) -> list:
    """The videos of the last TRENDS_HOURS in one channel's niche, the fastest risers first:
    one search, then the videos' numbers (TRENDS_UNITS of the day's YouTube quota)."""
    from html import unescape
    now = time.time()
    since = datetime.fromtimestamp(now - TRENDS_HOURS * 3600, timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    q = {"part": "snippet", "type": "video", "order": "viewCount", "publishedAfter": since,
         "maxResults": TRENDS_ASK, "q": "|".join(w["words"])}
    if w["region"]:
        q["regionCode"] = w["region"]
    if w["language"]:
        q["relevanceLanguage"] = w["language"]
    ids = []
    for i in youtube_data(key, "search", **q).get("items") or []:
        v = i.get("id") if isinstance(i, dict) else None
        if isinstance(v, dict) and isinstance(v.get("videoId"), str) and v["videoId"] not in ids:
            ids.append(v["videoId"])
    if not ids:
        return []
    out = []
    for v in youtube_data(key, "videos", part="snippet,statistics", id=",".join(ids)).get("items") or []:
        if not (isinstance(v, dict) and isinstance(v.get("id"), str)):
            continue
        sn = v.get("snippet") if isinstance(v.get("snippet"), dict) else {}
        st = v.get("statistics") if isinstance(v.get("statistics"), dict) else {}
        m = re.match(r"\d{4}-\d\d-\d\dT\d\d:\d\d:\d\d", str(sn.get("publishedAt") or ""))
        t = parse_stamp(m.group(0) + "Z") if m else None
        hours = round(max(1.0, (now - t) / 3600), 1) if t else float(TRENDS_HOURS)
        views = int(number(st.get("viewCount"), 0))
        out.append({"id": "yt:" + v["id"], "title": unescape(str(sn.get("title") or v["id"]))[:200],
                    "by": unescape(str(sn.get("channelTitle") or "someone"))[:100], "views": views,
                    "hours": hours, "vph": int(views / hours), "published": str(sn.get("publishedAt") or ""),
                    "url": f"https://www.youtube.com/watch?v={v['id']}"})
    out.sort(key=lambda f: -f["vph"])
    return out[:TRENDS_KEEP]


def find_line(f: dict) -> str:
    return (f"{f['id']}  \"{f['title']}\" by {f['by']}: {int(f['views']):,} views in {f['hours']:g} h, "
            f"{int(f['vph']):,} an hour")


def watch_line(cfg: Config, w: dict) -> str:
    where = [f"in {w['region']}"] if w["region"] else []
    where += [f"in the language {w['language']}"] if w["language"] else []
    return (f"{w['channel']} (made on {made_on(cfg, w['channel'])}): " + ("OFF, " if w["off"] else "")
            + "looking for " + " | ".join(w["words"]) + ("" if w["own_words"] else " (from its week plan ideas)")
            + (" " + " ".join(where) if where else "") + f", rising from {w['min_vph']:,} views an hour")


def pitch_line(x: dict) -> str:
    s = f"{x['n']}. {x['channel']}: \"{x['title']}\""
    if x["status"] == "waiting":
        return s + f" ({x.get('brief', '')}) Answer \"go {x['n']}\" or \"drop {x['n']}\"."
    if x["status"] == "go":
        return s + f", queued on {x.get('node')} as {x.get('job_id')}"
    return s + f", {x['status']}"


def channel_quiet(d: dict, channel: str, now: float) -> bool:
    """A channel is not pitched again while its pitch waits, nor for TRENDS_QUIET_HOURS after one."""
    return any(x["channel"] == channel and (x["status"] == "waiting" or
                                            now - (parse_stamp(x.get("at")) or 0) < TRENDS_QUIET_HOURS * 3600)
               for x in d["pitches"])


def trends_look(cfg: Config, a) -> int:
    """Look once at every channel's niche. With --wake (Hermes' fleet-trends job) it prints only
    what is new and rising, for Hermes to pitch, or else the line that lets Hermes sleep: nothing
    to pitch, no key yet, or a problem, which the daily report and the studio tell the owner."""
    if not a.wake:
        return look_once(cfg, a)
    try:
        return look_once(cfg, a)
    except FleetError as e:
        print(f"fleet: trend looker: {e}", file=sys.stderr)
        print(WAKE_NOT)
        return 0


def look_once(cfg: Config, a) -> int:
    key = trends_key(cfg)
    if not key:
        if a.wake:
            print(WAKE_NOT)
            return 0
        raise FleetError("no YouTube API key yet. Make one in Google Cloud (docs/operations/trends.md), "
                         "then run: fleet trends key")
    look = {"at": now_iso(), "units": 0, "rising": 0, "errors": []}
    with trends_locked(cfg):  # the units are counted before the calls, so two looks at once cannot overspend
        d = load_trends(cfg)
        if d["quota"]["day"] != quota_day():
            d["quota"] = {"day": quota_day(), "units": 0}
        todo = []
        for w in trend_channels(cfg, d):
            if w["off"]:
                continue
            if d["quota"]["units"] + TRENDS_UNITS > cfg.trends_budget:
                look["errors"].append(f"{w['channel']}: not looked at: the trend looker has used today's YouTube "
                                      f"budget ({d['quota']['units']:,} of {cfg.trends_budget:,} units, trends_budget "
                                      "in fleet.ini)")
                continue
            d["quota"]["units"] += TRENDS_UNITS
            todo.append(w)
        day = d["quota"]["day"]
        save_trends(cfg, d)
    found, unused = {}, 0
    for i, w in enumerate(todo):  # no lock while Google answers: "go 3" from Telegram need not wait
        try:
            found[w["channel"]] = rising_now(key, w)
            look["units"] += TRENDS_UNITS
        except FleetError as e:
            look["errors"].append(f"{w['channel']}: {e}")
            look["units"] += TRENDS_UNITS  # a call that fails can still cost quota: count it
            if re.search(r"HTTP 403|HTTP 400: .*\bkey\b", str(e), re.I):
                unused = len(todo) - i - 1  # the API not on, the quota spent, or a bad key: the rest would fail too
                break
    news = []
    with trends_locked(cfg):
        d = load_trends(cfg)
        if unused and d["quota"]["day"] == day:
            d["quota"]["units"] = max(0, d["quota"]["units"] - unused * TRENDS_UNITS)
        now = time.time()
        for w in todo:
            if w["channel"] not in found:
                continue
            ck, finds = channel_key(w["channel"]), found[w["channel"]]
            before = {f["id"]: f for f in d["finds"].get(ck, [])}
            quiet, fresh = channel_quiet(d, w["channel"], now), []
            for f in finds:
                f["first_seen"] = before.get(f["id"], {}).get("first_seen") or look["at"]
                rising = f["vph"] >= w["min_vph"]
                look["rising"] += rising
                if rising and f"{ck}:{f['id']}" not in d["seen"]:
                    fresh.append(f)
            d["finds"][ck] = finds
            if fresh and not quiet:  # what a quiet channel finds can still be news when it is quiet no more
                for f in fresh[:3]:
                    d["seen"][f"{ck}:{f['id']}"] = now
                news.append((w, fresh[:3]))
        d["looks"].append(look)
        save_trends(cfg, d)
    if a.json:
        print(json.dumps({"look": look, "new": [dict(f, channel=w["channel"]) for w, fs in news for f in fs],
                          "finds": d["finds"]}, indent=2, ensure_ascii=False))
    elif a.wake:
        if not news:
            print(WAKE_NOT)
            return 0
        lines = [f"New videos rising fast on YouTube in your channels' niches (published in the last "
                 f"{TRENDS_HOURS} hours):"]
        for w, fs in news:
            lines.append(watch_line(cfg, w))
            lines += [f"  {find_line(f)}. {f['url']}" for f in fs]
        print("\n".join(lines))
        return 0
    else:
        print(trends_text(cfg, d))
    for e in look["errors"]:
        print(f"fleet: trend looker: {e}", file=sys.stderr)
    return 1 if look["errors"] else 0


def trends_text(cfg: Config, d: dict) -> str:
    lines = [] if trends_key(cfg) else ["No YouTube API key yet: make one in Google Cloud (docs/operations/trends.md), "
                                        "then run: fleet trends key"]
    last = d["looks"][-1] if d["looks"] else None
    used = d["quota"]["units"] if d["quota"]["day"] == quota_day() else 0
    lines.append((f"Last look: {short_time(parse_stamp(last['at']))}" if last else "No look yet (fleet trends look)")
                 + f". YouTube quota used today by the trend looker: {used:,} of {cfg.trends_budget:,} units.")
    for w in trend_channels(cfg, d):
        lines.append(watch_line(cfg, w))
        finds = d["finds"].get(channel_key(w["channel"])) or []
        lines += [f"  {find_line(f)}" + ("  RISING" if f["vph"] >= w["min_vph"] else "") for f in finds[:3]]
        if last and not finds and not w["off"]:
            lines.append("  nothing found in the last look")
    waiting = [x for x in d["pitches"] if x["status"] == "waiting"]
    answered = [x for x in reversed(d["pitches"]) if x["status"] != "waiting"][:5]
    if waiting or answered:
        lines.append("Pitches:")
        lines += [f"  {pitch_line(x)}" for x in waiting + answered]
    if last and last.get("errors"):
        lines.append("The last look had problems:")
        lines += [f"  {e}" for e in last["errors"][:5]]
    return "\n".join(lines)


def trends_show(cfg: Config, a) -> int:
    if a.json:
        print(json.dumps(studio_trends(cfg)["trends"], indent=2, ensure_ascii=False))
    else:
        print(trends_text(cfg, load_trends(cfg)))
    return 0


def pitch_channel(cfg: Config, name: str) -> str:
    known = {channel_key(c): c for c in plan_channels(cfg)}
    if channel_key(name) not in known:
        raise FleetError(f"no VPS makes videos for channel {name!r} (the channels: "
                         f"{', '.join(known.values()) or 'none yet'})")
    return known[channel_key(name)]


def pitch_number(args: list) -> int:
    if len(args) != 1 or not re.fullmatch(r"#?\d+", str(args[0]).strip()):
        raise FleetError("give one pitch number, like 3 (fleet trends shows them)")
    return int(str(args[0]).strip().lstrip("#"))


def find_pitch(d: dict, n: int) -> dict:
    x = next((p for p in d["pitches"] if p["n"] == n), None)
    if not x:
        raise FleetError(f"there is no pitch {n} (fleet trends shows them)")
    return x


def trends_pitch(cfg: Config, a) -> int:
    if len(a.args) != 2:
        raise FleetError("fleet trends pitch \"<channel>\" \"<title>\" --brief \"...\" [--from yt:...]")
    ch, title = pitch_channel(cfg, a.args[0]), " ".join(str(a.args[1]).split())
    brief = " ".join((a.brief or "").split())
    if not title or len(title) > PITCH_TITLE_MAX:
        raise FleetError(f"a pitch needs a title of at most {PITCH_TITLE_MAX} characters (YouTube's limit)")
    if not 20 <= len(brief) <= 1500:
        raise FleetError("a pitch needs a --brief of two or three sentences (20 to 1500 characters) that says what "
                         "the video shows")
    with trends_locked(cfg):
        d = load_trends(cfg)
        src = None
        if a.source:
            src = next((f for f in d["finds"].get(channel_key(ch), []) if f["id"] == a.source.strip()), None)
            if not src:
                raise FleetError(f"{a.source} is not among the finds for {ch} (fleet trends lists them)")
        waiting = [x for x in d["pitches"] if x["channel"] == ch and x["status"] == "waiting"]
        if waiting:
            raise FleetError(f"pitch {waiting[0]['n']} for {ch} still waits for an answer: one at a time for a channel")
        x = {"n": d["next"], "channel": ch, "title": title, "brief": brief, "status": "waiting", "at": now_iso()}
        if src:
            x["source"] = {k: src.get(k) for k in ("id", "title", "by", "url", "views", "hours", "vph")}
        d["pitches"].append(x)
        d["next"] += 1
        save_trends(cfg, d)
    print(f"pitch {x['n']} for {ch}: \"{title}\". Answer \"go {x['n']}\" to make it next on {made_on(cfg, ch)}, "
          f"or \"drop {x['n']}\".")
    return 0


def trend_job(cfg: Config, x: dict) -> dict:
    """The job for a pitch: the channel's own job file, like a week plan topic, with why it is
    made now in topic.md."""
    src = x.get("source") or {}
    why = (f"Why now: a video on this subject is rising fast on YouTube: \"{src.get('title')}\" by {src.get('by')}, "
           f"{int(number(src.get('views'), 0)):,} views in {number(src.get('hours'), 0):g} hours ({src.get('url')}). "
           "Make our own video with a fresh angle; do not copy theirs.") if src else ""
    job = topic_job(cfg, x["channel"], x["title"], x.get("brief") or "", datetime.now().date().isoformat(), why)
    job.update(trend_pitch=x["n"], id=x["job_id"])
    return validate_job(job, f"pitch {x['n']} ({channels_dir(cfg) / (channel_key(x['channel']) + '.json')})")


def trends_go(cfg: Config, a) -> int:
    n = pitch_number(a.args)
    with trends_locked(cfg):
        d = load_trends(cfg)
        x = find_pitch(d, n)
        if x["status"] == "go":
            print(f"pitch {n} is already queued on {x.get('node')} as {x.get('job_id')}")
            return 0
        x.setdefault("job_id", make_job_id(x["channel"]))
        save_trends(cfg, d)  # the job id first: a go that stops half way cannot queue the video twice
        job = trend_job(cfg, x)
        out, err = io.StringIO(), io.StringIO()
        with contextlib.redirect_stdout(out), contextlib.redirect_stderr(err):
            dispatch_jobs(cfg, [job], "auto", False, True, first=True)
        q = {j["id"]: j for j in last_json(out.getvalue().encode("utf-8"), [])}.get(job["id"])
        said = [s.strip() for s in err.getvalue().splitlines() if s.strip()]
        again = re.search(rf"job id {re.escape(job['id'])} already exists on ([a-z0-9-]+)", " ".join(said))
        if not q and again:  # an earlier go sent it, then stopped before it could say so
            q, said = {"id": job["id"], "node": again.group(1)}, []
        if not q:
            x["error"] = ("; ".join(re.sub(r"^fleet: ", "", s) for s in said) or "it was not queued")[:300]
            save_trends(cfg, d)
            raise FleetError(f"pitch {n} was not queued: {x['error']}. Try again later with: fleet trends go {n}")
        x.update(status="go", node=q["node"], job_id=q["id"], answered_at=now_iso())
        x.pop("error", None)
        save_trends(cfg, d)
    notes = [re.sub(r"^(warning|note): ", "", s) for s in said]
    print(f"queued pitch {n} \"{x['title']}\" on {q['node']} as {q['id']}, first in its queue"
          + (f" ({'; '.join(notes)})" if notes else ""))
    return 0


def trends_drop(cfg: Config, a) -> int:
    n = pitch_number(a.args)
    with trends_locked(cfg):
        d = load_trends(cfg)
        x = find_pitch(d, n)
        if x["status"] == "go":
            raise FleetError(f"pitch {n} is already queued on {x.get('node')} as {x.get('job_id')}; to stop it: "
                             f"fleet cancel {x.get('node')} {x.get('job_id')}")
        x.update(status="dropped", answered_at=now_iso())
        save_trends(cfg, d)
    print(f"dropped pitch {n} ({x['channel']}: \"{x['title']}\")")
    return 0


def trends_watch(cfg: Config, a) -> int:
    if len(a.args) != 1:
        raise FleetError("fleet trends watch \"<channel>\" [--words \"a, b\"] [--region US] [--language en] "
                         "[--min 1000] [--off | --on]")
    if a.off and a.on:
        raise FleetError("--off or --on, not both")
    ch = pitch_channel(cfg, a.args[0])
    with trends_locked(cfg):
        d = load_trends(cfg)
        w = d["watch"].setdefault(channel_key(ch), {})
        w["channel"] = ch
        if a.words is not None:
            words = [" ".join(x.split()) for x in re.split(r"[,|\n]", a.words) if x.strip()]
            if len(words) > TREND_WORDS_MAX or any(len(x) > 40 for x in words):
                raise FleetError(f"at most {TREND_WORDS_MAX} words or short phrases (40 characters each), "
                                 "separated by commas")
            if words:
                w["words"] = words
            else:
                w.pop("words", None)
        if a.region is not None:
            r = a.region.strip().upper()
            if r and not re.fullmatch(r"[A-Z]{2}", r):
                raise FleetError("--region is a two-letter country code, like US or FR (\"\" for anywhere)")
            w["region"] = r
        if a.language is not None:
            lang = a.language.strip().lower()
            if lang and not re.fullmatch(r"[a-z]{2,3}(-[a-z0-9]{2,8})?", lang):
                raise FleetError("--language is a language code, like en or fr (\"\" for any)")
            w["language"] = lang
        if a.min is not None:
            if a.min < 1:
                raise FleetError("--min is the views an hour that count as rising: 1 or more")
            w["min_vph"] = a.min
        if a.off:
            w["off"] = True
        if a.on:
            w.pop("off", None)
        save_trends(cfg, d)
        w = trend_watch(cfg, d, ch)
    print(watch_line(cfg, w))
    return 0


def trends_set_key(cfg: Config, a) -> int:
    import getpass
    print("Paste your YouTube Data API key (it stays hidden while you paste), then press Enter.")
    k = getpass.getpass("YouTube API key: ").strip()
    if not k or re.search(r"\s", k) or len(k) > 200:
        raise FleetError("that does not look like an API key; nothing was saved")
    try:
        youtube_data(k, "videoCategories", part="id", regionCode="US")  # 1 quota unit: does Google take the key?
    except FleetError as e:
        raise FleetError(f"Google did not take the key, so nothing was saved: {e}") from None
    save_private(cfg, trends_key_file(cfg), {"key": k})
    print(f"saved in {trends_key_file(cfg)}. Look now with: fleet trends look. Hermes looks three times a day once "
          "its fleet-trends job exists (fleet hermes-cron).")
    return 0


def cmd_trends(cfg: Config, a) -> int:
    return {"show": trends_show, "look": trends_look, "pitch": trends_pitch, "go": trends_go, "drop": trends_drop,
            "watch": trends_watch, "key": trends_set_key}[a.action](cfg, a)


def studio_trends(cfg: Config) -> dict:
    """The trend looker as the studio's zeppelin shows it, or what is wrong with trends.json."""
    try:
        d = load_trends(cfg)
    except FleetError as e:
        return {"trends": {"error": str(e)[:300]}}
    last = d["looks"][-1] if d["looks"] else {}
    chans = [{"channel": w["channel"], "words": w["words"], "off": w["off"], "min_vph": w["min_vph"],
              "on": made_on(cfg, w["channel"]),
              "finds": [{k: f.get(k) for k in ("id", "title", "by", "views", "hours", "vph", "url")}
                        for f in d["finds"].get(channel_key(w["channel"]), [])[:3]]} for w in trend_channels(cfg, d)]
    shown = [x for x in d["pitches"] if x["status"] == "waiting"] + \
        [x for x in reversed(d["pitches"]) if x["status"] != "waiting"][:4]
    return {"trends": {
        "key": bool(trends_key(cfg)), "last_look": last.get("at"), "errors": (last.get("errors") or [])[:3],
        "quota": {"used": d["quota"]["units"] if d["quota"]["day"] == quota_day() else 0, "budget": cfg.trends_budget},
        "channels": chans,
        "pitches": [{k: x.get(k) for k in ("n", "channel", "title", "brief", "status", "at", "node", "job_id")}
                    for x in shown]}}


def trends_summary(cfg: Config, since: float) -> dict:
    """The trend looker's part of the daily report."""
    try:
        d = load_trends(cfg)
    except FleetError as e:
        return {"error": str(e)}
    at = lambda x, k: parse_stamp(x.get(k)) or 0  # noqa: E731
    looks = [x for x in d["looks"] if at(x, "at") >= since]
    return {"key": bool(trends_key(cfg)), "looks": len(looks),
            "pitched": sum(1 for x in d["pitches"] if at(x, "at") >= since),
            "went": sum(1 for x in d["pitches"] if x["status"] == "go" and at(x, "answered_at") >= since),
            "waiting": [x for x in d["pitches"] if x["status"] == "waiting"],
            "problems": [str(e) for e in looks[-1].get("errors") or []][:2] if looks else []}


# --------------------------------------------------------------------------- maintenance

def cmd_list(cfg: Config, a) -> int:
    rows = [("NODE", "HOST", "PUBLIC IP", "ACCOUNT", "PROVIDERS", "SESSIONS", "CHANNELS", "ENABLED")]
    for n in cfg.nodes.values():
        rows.append((n.name, n.host, n.public_ip or "-", n.hostinger_account or "-", ",".join(n.providers),
                     n.sessions, n.channels, "yes" if n.enabled else "no"))
    print_table(rows)
    return 0


def cmd_ping(cfg: Config, a) -> int:
    nodes = resolve_targets(cfg, a.targets)

    def one(n):
        t0 = time.time()
        r = remote(cfg, n, "echo ok", timeout=cfg.connect_timeout + 15)
        return r.returncode == 0 and text(r.stdout).endswith("ok"), int((time.time() - t0) * 1000), text(r.stderr)

    bad = 0
    for name, res in parallel(nodes, one).items():
        if isinstance(res, Exception):
            print(f"{name:8} ERROR {res}")
            bad += 1
            continue
        ok, ms, err = res
        print(f"{name:8} {'ok' if ok else 'UNREACHABLE'} {ms} ms {'' if ok else err[-200:]}")
        bad += 0 if ok else 1
    return 1 if bad else 0


def cmd_exec(cfg: Config, a) -> int:
    nodes = resolve_targets(cfg, a.targets)
    command = " ".join(a.command)
    if not command:
        raise FleetError("nothing to run: fleet exec TARGETS -- CMD")
    user = "root" if a.root else None
    res = parallel(nodes, lambda n: remote(cfg, n, command, user=user, timeout=a.timeout))
    rc = 0
    for name, r in res.items():
        if isinstance(r, Exception):
            print(f"--- {name}: ERROR {r}")
            rc = 1
            continue
        print(f"--- {name} (exit {r.returncode})")
        if r.stdout:
            print(text(r.stdout))
        if r.stderr and r.returncode != 0:
            print(text(r.stderr), file=sys.stderr)
        rc = rc or r.returncode
    return rc


def push_code(cfg: Config, n: Node) -> str:
    root = shlex.quote(root_of(cfg, n))
    cmd = (f"set -e; mkdir -p {root}; cd {root}; rm -rf app.new; mkdir app.new\n"
           f"tar -xzf - -C app.new\n"
           f"rm -rf app.old; if [ -d app ]; then mv app app.old; fi; mv app.new app\n"
           f"sudo -n systemctl restart fleet-worker >/dev/null 2>&1 || true\n"
           f"echo \"synced worker $(app/worker/fleet-worker version)\"\n")
    r = remote(cfg, n, cmd, stdin=tar_dir(REPO_ROOT / "vps"), timeout=300)
    if r.returncode != 0:
        raise FleetError(text(r.stderr)[-300:] or f"exit {r.returncode}")
    return text(r.stdout)


def cmd_sync(cfg: Config, a) -> int:
    rc = 0
    for name, r in parallel(resolve_targets(cfg, a.targets), lambda n: push_code(cfg, n)).items():
        print(f"{name}: {r}")
        rc = rc or (1 if isinstance(r, Exception) else 0)
    return rc


def cmd_restart(cfg: Config, a) -> int:
    nodes = resolve_targets(cfg, a.targets)
    res = parallel(nodes, lambda n: remote(cfg, n, "sudo -n systemctl restart fleet-worker && systemctl is-active fleet-worker"))
    rc = 0
    for name, r in res.items():
        ok = not isinstance(r, Exception) and r.returncode == 0
        print(f"{name}: {'restarted' if ok else 'FAILED ' + (str(r) if isinstance(r, Exception) else text(r.stderr))}")
        rc = rc or (0 if ok else 1)
    return rc


def cmd_reboot(cfg: Config, a) -> int:
    n = one_node(cfg, a.node)
    st = fetch_status(cfg, n)
    if st.get("reachable") and st["queue"]["running"] and not a.force:
        raise FleetError(f"{n.name} is running {st['queue']['running']} job(s); wait, or add --force "
                         "(running jobs are retried after the reboot)")
    remote(cfg, n, "systemctl reboot", user="root", timeout=30)
    print(f"{n.name}: reboot requested; it is usually back in about a minute (fleet ping {n.name})")
    return 0


def read_env_file(path: Path) -> dict:
    out = {}
    for line in path.read_text(encoding="utf-8-sig").splitlines():
        line = line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        k, v = line.split("=", 1)
        k = k.strip()
        if k.startswith("export "):
            k = k[len("export "):].strip()
        out[k] = v.strip().strip('"').strip("'")
    return out


def secret_file(cfg: Config, node: Node, name: str):
    for p in (cfg.secrets_dir / node.name / f"{name}.env", cfg.secrets_dir / f"{name}.env"):
        if p.exists():
            if not private_file(p):
                raise FleetError(f"{p} is readable by other users; run: chmod 600 {p}")
            return p
    return None


def cmd_secrets(cfg: Config, a) -> int:
    if not NAME_RE.match(a.name):
        raise FleetError("invalid secret name")
    rc = 0
    for n in resolve_targets(cfg, a.targets):
        src = secret_file(cfg, n, a.name)
        if not src:
            print(f"{n.name}: no {cfg.secrets_dir / n.name / (a.name + '.env')} (or shared {a.name}.env); skipped")
            rc = 1
            continue
        values = {k: v for k, v in read_env_file(src).items() if v}
        bad_keys = [k for k in values if not ENV_KEY_RE.match(k)]
        if bad_keys:
            raise FleetError(f"{src}: not a valid variable name: {', '.join(bad_keys)} (use NAME=value lines)")
        if not values:
            print(f"{n.name}: {src} has no values filled in; skipped")
            rc = 1
            continue
        body = "".join(f"{k}={shlex.quote(v)}\n" for k, v in values.items()).encode("utf-8")
        cmd = (f"set -e; umask 077; mkdir -p ~/.config/fleet/providers\n"
               f"cat > ~/.config/fleet/providers/.{a.name}.env.tmp\n"
               f"mv ~/.config/fleet/providers/.{a.name}.env.tmp ~/.config/fleet/providers/{a.name}.env\n"
               f"date +%s > ~/.config/fleet/providers/.{a.name}.pushed\n")
        r = remote(cfg, n, cmd, stdin=body)
        print(f"{n.name}: {'pushed ' + ', '.join(values) if r.returncode == 0 else 'FAILED ' + text(r.stderr)}")
        rc = rc or r.returncode
    return rc


def cmd_bootstrap(cfg: Config, a) -> int:
    n = one_node(cfg, a.node)
    if a.public and not n.public_ip:
        raise FleetError(f"set public_ip for [{n.name}] in {cfg.path} (hPanel > VPS > Overview)")
    host = n.public_ip if a.public else n.host
    pub = Path(str(cfg.ssh_key) + ".pub")
    if not pub.exists():
        raise FleetError(f"missing {pub}; run `fleet init` first")
    env = {"FLEET_NODE": n.name, "FLEET_PUBKEY": pub.read_text(encoding="utf-8").strip(),
           "MAX_PARALLEL": str(n.sessions), "FLEET_TZ": a.tz}
    if a.skip_upgrade:
        env["SKIP_UPGRADE"] = "1"
    ts = secret_file(cfg, n, "tailscale")
    if ts and read_env_file(ts).get("TS_AUTHKEY"):
        env["TS_AUTHKEY"] = read_env_file(ts)["TS_AUTHKEY"]
    else:
        print(f"warning: no TS_AUTHKEY in {cfg.secrets_dir / 'tailscale.env'}; the node will not join Tailscale",
              file=sys.stderr)
    print(f"==> uploading the bootstrap bundle to root@{host}")
    r = remote(cfg, n, "rm -rf /root/fleet-bootstrap && mkdir -p /root/fleet-bootstrap && "
                       "tar -xzf - -C /root/fleet-bootstrap", stdin=tar_dir(REPO_ROOT / "vps"),
               user="root", host=host, timeout=300)
    if r.returncode != 0:
        raise FleetError(f"could not reach root@{host}: {text(r.stderr)[-400:]}\n"
                         f"Is the fleet key on the VPS? See docs/vps/provisioning.md (step 1).")
    print(f"==> running bootstrap.sh on {n.name} (a few minutes)")
    envtext = "".join(f"export {k}={shlex.quote(v)}\n" for k, v in env.items()).encode("utf-8")
    cmd = ("umask 077; cat > /root/fleet-bootstrap/.boot.env; . /root/fleet-bootstrap/.boot.env; "
           "rm -f /root/fleet-bootstrap/.boot.env; bash /root/fleet-bootstrap/bootstrap.sh")
    r = remote(cfg, n, cmd, stdin=envtext, user="root", host=host, timeout=3600, capture=False)
    if r.returncode == 0:
        print(f"\nBootstrap finished. Next: fleet ping {n.name}   (over Tailscale, host '{n.host}')")
    return r.returncode


def cmd_lockdown(cfg: Config, a) -> int:
    n = one_node(cfg, a.node)
    flag = " --undo" if a.undo else ""
    return remote(cfg, n, f"bash {shlex.quote(root_of(cfg, n))}/app/lockdown.sh{flag}", user="root",
                  capture=False).returncode


def cmd_provider(cfg: Config, a) -> int:
    if not NAME_RE.match(a.name) or not (REPO_ROOT / "vps" / "providers" / a.name).is_dir():
        raise FleetError(f"unknown provider '{a.name}' (see vps/providers/)")
    nodes = resolve_targets(cfg, a.targets)
    pdir = lambda n: shlex.quote(f"{root_of(cfg, n)}/app/providers/{a.name}")  # noqa: E731
    if a.action == "install":
        for name, r in parallel(nodes, lambda n: push_code(cfg, n)).items():
            if isinstance(r, Exception):
                print(f"{name}: sync failed: {r}")
                return 1
        ver = f" {shlex.quote(a.version)}" if a.version else ""
        res = parallel(nodes, lambda n: remote(cfg, n, f"bash {pdir(n)}/install.sh{ver}", timeout=900))
    else:
        flags = " --smoke" if a.smoke else ""
        res = parallel(nodes, lambda n: remote(cfg, n, f"bash {pdir(n)}/check.sh{flags}", timeout=300))
    rc = 0
    for name, r in res.items():
        if isinstance(r, Exception):
            print(f"--- {name}: ERROR {r}")
            rc = 1
            continue
        print(f"--- {name} (exit {r.returncode})\n{text(r.stdout)}")
        if r.returncode:
            print(text(r.stderr)[-1500:], file=sys.stderr)
            rc = 1
    return rc


def ssh_config_text(cfg: Config) -> str:
    out = ["# hermes-fleet nodes, written by `fleet init` / `fleet ssh-config`. Edit fleet.ini instead."]
    for n in cfg.nodes.values():
        out.append(f"Host {n.name}\n  HostName {n.host}\n  User {n.user}\n  Port {n.port}\n"
                   f"  IdentityFile {cfg.ssh_key.as_posix()}\n  IdentitiesOnly yes\n  ServerAliveInterval 30\n")
    return "\n".join(out)


def cmd_ssh_config(cfg: Config, a) -> int:
    print(ssh_config_text(cfg))
    return 0


def cmd_forget_host(cfg: Config, a) -> int:
    n = one_node(cfg, a.node)
    keygen = shutil.which("ssh-keygen") or "ssh-keygen"
    for h in filter(None, {n.host, n.public_ip, n.name}):
        target = h if n.port == 22 else f"[{h}]:{n.port}"
        subprocess.run([keygen, "-R", target], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        print(f"forgot host key for {target}")
    return 0


# --------------------------------------------------------------------------- home setup

def find_hermes():
    exe = shutil.which("hermes")
    if not exe and IS_WINDOWS:
        cand = Path(os.environ.get("LOCALAPPDATA", "")) / "hermes" / "bin" / "hermes.exe"
        exe = str(cand) if cand.exists() else None
    if not exe:
        cand = HOME / ".local" / "bin" / "hermes"
        exe = str(cand) if cand.exists() else None
    return exe


def hermes_home() -> Path:
    if os.environ.get("HERMES_HOME"):
        return Path(os.environ["HERMES_HOME"]).expanduser()
    if IS_WINDOWS:
        return Path(os.environ.get("LOCALAPPDATA", str(HOME / "AppData" / "Local"))) / "hermes"
    return HOME / ".hermes"


def restrict_dir(path: Path) -> None:
    if IS_WINDOWS:
        user = os.environ.get("USERNAME", "")
        dom = os.environ.get("USERDOMAIN", "")
        who = f"{dom}\\{user}" if dom and user else user
        if who:
            subprocess.run(["icacls", str(path), "/inheritance:r", "/grant:r", f"{who}:(OI)(CI)F",
                            "/grant:r", "SYSTEM:(OI)(CI)F", "/T", "/Q"],
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        return
    os.chmod(path, 0o700)
    for p in path.rglob("*"):
        os.chmod(p, 0o700 if p.is_dir() else 0o600)


def write_file(path: Path, content: str, newline: str = "\n") -> None:
    """Write UTF-8 text with fixed line endings (Path.write_text has no newline= before Python 3.10)."""
    with open(path, "w", encoding="utf-8", newline=newline) as fh:
        fh.write(content)


def write_if_missing(path: Path, content: str) -> bool:
    if path.exists():
        return False
    path.parent.mkdir(parents=True, exist_ok=True)
    write_file(path, content)
    return True


CRON_SCRIPT = '''#!/usr/bin/env python3
# Written by `fleet init`. Hermes runs this for a cron job. For a no-agent job, whatever
# it prints is sent to you and printing nothing means "all quiet". For an agent job,
# what it prints is the agent's starting point, and a last line of {{"wakeAgent": false}}
# lets the agent sleep.
import os, runpy, sys
os.environ.setdefault("FLEET_CONFIG", {config!r})
sys.argv = ["fleet"] + {args!r}
try:
    runpy.run_path({cli!r}, run_name="__main__")
except SystemExit as exc:
    code = exc.code if isinstance(exc.code, int) else (0 if exc.code is None else 1)
    sys.exit(0 if code in (0, 2) else code)
'''


CRON_SCRIPTS = {  # the no-agent scripts in the director profile's scripts/ folder, and what each runs
    "fleet_health.py": ["health", "--changes-only"],
    "fleet_pull.py": ["pull", "--quiet"],
    "fleet_report.py": ["report"],
    "fleet_plan.py": ["plan", "run", "--quiet"],
    "fleet_trends.py": ["trends", "look", "--wake"],  # before the fleet-trends agent job: what to pitch
}
WEEK_PLAN_PROMPT = (
    "Plan next week's videos for the owner to approve. Follow \"Plan a week ahead\" in the fleet-ops skill: run "
    "`fleet plan slots --week next --json`, give each open slot a new topic that suits its channel (a title and a "
    "brief of two or three sentences; `fleet plan show --week all --json` lists the topics already planned, so none "
    "repeats), write them as a JSON list to ~/fleet-plan-next.json and run `fleet plan import ~/fleet-plan-next.json`. "
    "Then send the owner the plan as `fleet plan show --week next` prints it, and say how to answer: \"approve all\", "
    "\"approve 3-5\", \"reject 4\", or a change such as \"4: make it about Jupiter\". Do not approve anything "
    "yourself. If there is no open slot, say so in one line.")
REPLACED_CRON_JOBS = {"fleet-daily-report": "fleet-report"}  # older fleet versions made these


def write_cron_scripts(profile_home: Path, cfg_path: Path) -> list:
    scripts = profile_home / "scripts"
    scripts.mkdir(parents=True, exist_ok=True)
    cli = str(REPO_ROOT / "home" / "bin" / "fleet")
    for name, args in CRON_SCRIPTS.items():
        write_file(scripts / name, CRON_SCRIPT.format(config=str(cfg_path), args=args, cli=cli))
    return [scripts / name for name in CRON_SCRIPTS]


def hermes_cmd(exe: str, *args: str, profile: str = HERMES_PROFILE, timeout: int = 120) -> subprocess.CompletedProcess:
    """Run a Hermes command for the director profile (profile="" for Hermes' default profile)."""
    env = dict(os.environ, HERMES_NONINTERACTIVE="1")
    argv = [exe, *(["-p", profile] if profile else []), *args]
    return subprocess.run(argv, capture_output=True, stdin=subprocess.DEVNULL, timeout=timeout, env=env)


def director_home(exe: str):
    """The director profile's folder, or None while the profile does not exist."""
    r = hermes_cmd(exe, "profile", "show", HERMES_PROFILE, profile="")
    if r.returncode != 0:
        return None
    m = re.search(r"(?im)^\s*path:\s*(\S.*?)\s*$", text(r.stdout))
    home = Path(os.path.expanduser(m.group(1))) if m else hermes_home() / "profiles" / HERMES_PROFILE
    return home if home.is_dir() else None


def ensure_director(exe: str):
    """Create the director profile when it is missing: (its folder or None, report lines).
    It starts without Hermes' bundled skills, so it does only fleet work, with the
    fleet skills from this repository."""
    home = director_home(exe)
    if home:
        return home, [f"  = profile {HERMES_PROFILE}: {home}"]
    r = hermes_cmd(exe, "profile", "create", HERMES_PROFILE, "--no-skills", "--description",
                   "Fleet director: plans the videos and runs the VPS fleet with the fleet command", profile="")
    home = director_home(exe)
    if not home:
        why = (text(r.stderr) or text(r.stdout))[-300:] or f"exit {r.returncode}"
        return None, [f"  !! could not create the Hermes profile '{HERMES_PROFILE}': {why}",
                      "     Update Hermes (`hermes update`), then run `fleet init` again."]
    return home, [f"  + profile {HERMES_PROFILE}: {home}"]


def hermes_model(exe: str) -> str:
    """Hermes' chosen provider and model as "provider / model", or "" when none is set."""
    model = hermes_get(exe, "model.default")
    if not model or not isinstance(model, str):
        return ""
    provider = hermes_get(exe, "model.provider")
    return f"{provider} / {model}" if provider and isinstance(provider, str) else model


def hermes_get(exe: str, key: str):
    r = hermes_cmd(exe, "config", "get", key, "--json")
    if r.returncode != 0:
        return None
    try:
        return json.loads(text(r.stdout) or "null")
    except ValueError:
        return text(r.stdout) or None


def apply_hermes_settings(exe: str, repo: str) -> list:
    """Apply the director's settings through `hermes -p director config set`, so
    Hermes validates and writes them itself. Lists are merged, never replaced. The
    model is left alone: the owner picks it with `hermes -p director model`."""
    skills_dir = (REPO_ROOT / "home" / "hermes" / "skills").as_posix()
    wanted = [
        ("terminal.cwd", repo, "set"),
        ("terminal.timeout", 900, "min"),
        ("skills.external_dirs", [skills_dir], "union"),
        ("skills.auto_load", ["fleet-ops"], "union"),
        ("approvals.deny", ["fleet exec all*rm -rf*", "*.config?fleet?secrets*", "*hermes?.env*",
                            f"*{HERMES_PROFILE}?.env*"], "union"),
    ]
    report = []
    for key, value, mode in wanted:
        cur = hermes_get(exe, key)
        if mode == "union":
            base = cur if isinstance(cur, list) else []
            new = base + [v for v in value if v not in base]
        elif mode == "min":
            new = value if not isinstance(cur, (int, float)) or cur < value else cur
        else:
            new = value
        if new == cur:
            report.append(f"  = {key} already {json.dumps(new)}")
            continue
        literal = json.dumps(new) if isinstance(new, (list, dict)) else str(new)
        r = hermes_cmd(exe, "config", "set", key, literal)
        if r.returncode != 0:
            report.append(f"  !! could not set {key}: {text(r.stderr)[-200:]}  (set it with: hermes config edit)")
            continue
        after = hermes_get(exe, key)
        if isinstance(new, list) and not isinstance(after, list):
            report.append(f"  !! {key} was stored as text, not a list. Fix with `hermes config edit`:\n"
                          f"       {key}: {json.dumps(new)}")
            continue
        report.append(f"  + {key} = {json.dumps(new)}" + (f"   (was {json.dumps(cur)})" if cur not in (None, "") else ""))
    return report


def install_shims(bin_dir: Path) -> list:
    bin_dir.mkdir(parents=True, exist_ok=True)
    cli = REPO_ROOT / "home" / "bin" / "fleet"
    made = []
    if IS_WINDOWS:
        py = Path(sys.executable)
        if py.name.lower() == "pythonw.exe":
            py = py.with_name("python.exe")
        sh = bin_dir / "fleet"           # for Git Bash, which Hermes uses for its terminal
        write_file(sh, f'#!/bin/sh\nexec "{py.as_posix()}" "{cli.as_posix()}" "$@"\n')
        cmd = bin_dir / "fleet.cmd"      # for cmd.exe and PowerShell
        write_file(cmd, f'@echo off\r\n"{py}" "{cli}" %*\r\n', newline="")
        made += [str(sh), str(cmd)]
    else:
        link = bin_dir / "fleet"
        if link.is_symlink() or link.exists():
            link.unlink()
        link.symlink_to(cli)
        os.chmod(cli, 0o755)
        made.append(f"{link} -> {cli}")
    return made


def cmd_init(cfg_path: Path, a) -> int:
    cfg_dir = cfg_path.parent
    secrets = cfg_dir / "secrets"
    for d in (cfg_dir, secrets, STATE_DIR):
        d.mkdir(parents=True, exist_ok=True)
    print("==> Fleet inventory and secrets (existing files are never overwritten)")
    if write_if_missing(cfg_path, (REPO_ROOT / "home" / "fleet.ini.example").read_text(encoding="utf-8")):
        print(f"  + {cfg_path}  (fill in each public_ip later)")
    else:
        print(f"  = kept {cfg_path}")
    cfg = load_config(cfg_path)
    claude_tpl = (REPO_ROOT / "home" / "secrets.example" / "claude.env.example").read_text(encoding="utf-8")
    ts_tpl = (REPO_ROOT / "home" / "secrets.example" / "tailscale.env.example").read_text(encoding="utf-8")
    for n in cfg.nodes.values():
        if write_if_missing(cfg.secrets_dir / n.name / "claude.env", claude_tpl):
            print(f"  + {cfg.secrets_dir / n.name / 'claude.env'}")
    if write_if_missing(cfg.secrets_dir / "tailscale.env", ts_tpl):
        print(f"  + {cfg.secrets_dir / 'tailscale.env'}")
    restrict_dir(cfg.secrets_dir)
    print(f"  secrets folder is private to your user: {cfg.secrets_dir}")

    print("==> SSH key for the fleet")
    if not cfg.ssh_key.exists():
        cfg.ssh_key.parent.mkdir(parents=True, exist_ok=True)
        keygen = shutil.which("ssh-keygen")
        if not keygen:
            raise FleetError("ssh-keygen not found (install the OpenSSH client)")
        # No passphrase: scheduled checks must use it unattended. It opens only the
        # fleet VPSs, and only over Tailscale once they are locked down.
        subprocess.run([keygen, "-q", "-t", "ed25519", "-N", "", "-C", f"hermes-fleet@{socket.gethostname()}",
                        "-f", str(cfg.ssh_key)], check=True)
        print(f"  + {cfg.ssh_key}")
    else:
        print(f"  = kept {cfg.ssh_key}")
    pub = Path(str(cfg.ssh_key) + ".pub").read_text(encoding="utf-8").strip()

    ssh_dir = HOME / ".ssh"
    (ssh_dir / "config.d").mkdir(parents=True, exist_ok=True)
    write_file(ssh_dir / "config.d" / "fleet", ssh_config_text(cfg) + "\n")
    main_cfg = ssh_dir / "config"
    existing = main_cfg.read_text(encoding="utf-8") if main_cfg.exists() else ""
    if not re.search(r"(?im)^\s*Include\s+\S*config\.d/\*", existing):
        if existing:
            shutil.copy2(main_cfg, ssh_dir / f"config.bak-{int(time.time())}")
        write_file(main_cfg, "Include config.d/*\n\n" + existing)
    if not IS_WINDOWS:
        os.chmod(main_cfg, 0o600)
    print("  ssh config written: you can type `ssh vps1` once a VPS is up")

    print("==> fleet command")
    for s in install_shims(HOME / ".local" / "bin"):
        print(f"  + {s}")

    if a.no_hermes:
        print("==> Hermes: skipped (--no-hermes)")
    else:
        exe = find_hermes()
        hh = None
        if not exe:
            print("==> Hermes: not found yet. Install it, then run `fleet init` again.")
        else:
            print(f"==> Hermes ({exe}): the '{HERMES_PROFILE}' profile directs the fleet")
            hh, lines = ensure_director(exe)
            print("\n".join(lines))
        if hh:
            stamp = time.strftime("%Y%m%d-%H%M%S")
            if (hh / "config.yaml").exists():
                shutil.copy2(hh / "config.yaml", hh / f"config.yaml.bak-{stamp}")
            soul_src = REPO_ROOT / "home" / "hermes" / "SOUL.md"
            soul = hh / "SOUL.md"
            if soul.exists() and soul.read_bytes() != soul_src.read_bytes():
                shutil.copy2(soul, hh / f"SOUL.md.bak-{stamp}")
            shutil.copy2(soul_src, soul)
            print(f"  + {soul}")
            for script in write_cron_scripts(hh, cfg_path):
                print(f"  + {script}")
            for line in apply_hermes_settings(exe, REPO_ROOT.as_posix()):
                print(line)
            model = hermes_model(exe)
            print(f"  = model: {model}  (change it with `hermes -p {HERMES_PROFILE} model`)" if model else
                  f"  !! no model chosen yet: run `hermes -p {HERMES_PROFILE} model` to pick a provider and model")
            if (hermes_home() / "scripts" / "fleet_health.py").exists():
                print("  !! An older fleet setup used Hermes' default profile. See \"Upgrading to the director\n"
                      "     profile\" in docs/operations/updates.md, so reports do not come twice.")
    print("\n==> Your fleet public key (add it in hPanel > VPS > Settings > SSH keys on each Hostinger account):")
    print(f"  {pub}")
    print(f"\nNext: choose the director's model with `hermes -p {HERMES_PROFILE} model` and connect Telegram (steps\n"
          "4 and 5 of docs/home/windows.md or docs/home/linux-macos.md). The secrets files are filled in later,\n"
          "while you set up Tailscale and the VPSs.")
    return 0


def cmd_hermes_cron(cfg: Config, a) -> int:
    exe = find_hermes()
    if not exe:
        raise FleetError("hermes not found")
    hh = director_home(exe)
    if not hh:
        raise FleetError(f"the Hermes profile '{HERMES_PROFILE}' does not exist yet: run `fleet init` first")
    write_cron_scripts(hh, cfg.path)  # a fleet init from an older version wrote fewer of them
    listing = text(hermes_cmd(exe, "cron", "list").stdout)
    jobs = [
        ("fleet-health", ["every 10m", "--no-agent", "--script", "fleet_health.py"]),
        ("fleet-pull", ["every 30m", "--no-agent", "--script", "fleet_pull.py"]),
        ("fleet-report", ["0 9 * * *", "--no-agent", "--script", "fleet_report.py"]),
        ("fleet-plan", ["every 1h", "--no-agent", "--script", "fleet_plan.py"]),
        ("fleet-week-plan", ["0 10 * * 0", WEEK_PLAN_PROMPT, "--skill", "fleet-ops", "--workdir", REPO_ROOT.as_posix()]),
        # The trend looker: Hermes only wakes when its script finds something new and rising.
        ("fleet-trends", ["0 8,13,18 * * *", TRENDS_PROMPT, "--script", "fleet_trends.py", "--skill", "fleet-ops",
                          "--workdir", REPO_ROOT.as_posix()]),
    ]
    rc = 0
    for old, new in REPLACED_CRON_JOBS.items():
        if re.search(rf"\b{re.escape(old)}\b", listing):
            r = hermes_cmd(exe, "cron", "remove", old)
            print(f"- {old} (replaced by {new})" if r.returncode == 0 else
                  f"!! {old} is replaced by {new}; remove it by hand: hermes -p {HERMES_PROFILE} cron remove {old}")
    for name, args in jobs:
        if re.search(rf"\b{re.escape(name)}\b", listing):
            print(f"= {name} already exists")
            continue
        r = hermes_cmd(exe, "cron", "create", *args, "--deliver", a.deliver, "--name", name)
        print(f"{'+' if r.returncode == 0 else '!!'} {name}" + ("" if r.returncode == 0 else f": {text(r.stderr)[-300:]}"))
        rc = rc or r.returncode
    print(f"These jobs belong to the '{HERMES_PROFILE}' profile (hermes -p {HERMES_PROFILE} cron list). They run inside\n"
          "the Hermes gateway: keep it running (hermes gateway status). Their times are in the profile's timezone.")
    return rc


def cmd_doctor(cfg_path: Path, a) -> int:
    fails = 0

    def check(label, ok, hint="", warn=False):
        nonlocal fails
        mark = "ok" if ok else ("warn" if warn else "FAIL")
        if not ok and not warn:
            fails += 1
        print(f"[{mark:>4}] {label}" + ("" if ok or not hint else f"\n       -> {hint}"))

    check(f"python {sys.version.split()[0]} ({sys.executable})", sys.version_info >= (3, 9), "Python 3.9 or newer")
    try:
        check(f"ssh client: {ssh_binary()}", True)
    except FleetError as e:
        check("ssh client", False, str(e))
    check("ssh-keygen", shutil.which("ssh-keygen") is not None, "install the OpenSSH client")
    check("git", shutil.which("git") is not None, "Windows: winget install --id Git.Git -e")
    if IS_WINDOWS:
        bash = Path(os.environ.get("ProgramFiles", r"C:\Program Files")) / "Git" / "bin" / "bash.exe"
        check(f"Git Bash (Hermes runs terminal commands with it): {bash}", bash.exists(),
              "winget install --id Git.Git -e")
    exe = find_hermes()
    check(f"hermes: {exe or 'not found'}", exe is not None, "see docs/home for the Hermes install command")
    ts = tailscale_binary()
    if ts:
        r = subprocess.run([ts, "status", "--json"], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
        state = ""
        try:
            state = json.loads(r.stdout or b"{}").get("BackendState", "")
        except ValueError:
            pass
        check(f"tailscale is {state or 'unknown'}", state == "Running", "open Tailscale and sign in", warn=True)
    else:
        check("tailscale installed", False, "https://tailscale.com/download", warn=True)
    on_path = any(Path(p) == HOME / ".local" / "bin" for p in os.environ.get("PATH", "").split(os.pathsep) if p)
    check("~/.local/bin is on PATH (so Hermes can run `fleet`)", on_path,
          "re-run the installer, then open a new terminal and restart the Hermes gateway", warn=True)
    check(f"config {cfg_path}", cfg_path.exists(), "run `fleet init`")
    if cfg_path.exists():
        cfg = load_config(cfg_path)
        check(f"ssh key {cfg.ssh_key}", cfg.ssh_key.exists(), "run `fleet init`")
        check(f"{len(cfg.nodes)} node(s) in the inventory", bool(cfg.nodes))
        for n in cfg.nodes.values():
            if not n.enabled:
                continue
            made = ", ".join("any channel" if channel_key(c) == "all" else c for c in channel_names(n))
            check(f"{n.name}: makes videos for {made or 'no channel yet'}", bool(made),
                  f"set `channels` for [{n.name}] in {cfg_path}: fleet dispatch sends a channel's jobs only "
                  f"to its VPS", warn=True)
            for prov in n.providers:
                p = cfg.secrets_dir / n.name / f"{prov}.env"
                filled = p.exists() and any(read_env_file(p).values())
                check(f"{n.name}: {prov} credentials filled in", filled, f"edit {p}", warn=True)
            try:
                socket.getaddrinfo(n.host, n.port)
                check(f"{n.name}: '{n.host}' resolves", True)
            except OSError:
                check(f"{n.name}: '{n.host}' resolves", False, "not on Tailscale yet (normal before bootstrap)", warn=True)
        tsf = cfg.secrets_dir / "tailscale.env"
        check("Tailscale auth key filled in (needed to bootstrap)", tsf.exists() and bool(read_env_file(tsf).get("TS_AUTHKEY")),
              f"edit {tsf}", warn=True)
    if exe:
        home = director_home(exe)
        check(f"Hermes profile {HERMES_PROFILE}: {home or 'missing'}", home is not None, "run `fleet init`")
    if exe and home:
        cwd = hermes_get(exe, "terminal.cwd")
        check("the director's terminal.cwd points at this repo", str(cwd) == REPO_ROOT.as_posix(), "run `fleet init`",
              warn=True)
        model = hermes_model(exe)
        check(f"the director's model: {model or 'not chosen yet'}", bool(model),
              f"run `hermes -p {HERMES_PROFILE} model` to pick a provider and model", warn=True)
    print("\nAll required checks passed." if not fails else f"\n{fails} required check(s) failed.")
    return 1 if fails else 0


# --------------------------------------------------------------------------- studio

STUDIO_DIR = REPO_ROOT / "home" / "studio"
STUDIO_PAGE = STUDIO_DIR / "studio.html"
STUDIO_PORT = 8740
LOOPBACK_NAMES = {"127.0.0.1", "localhost", "::1"}
# The newest thing a running session did, from the end of its transcript: the last text
# or tool call of an assistant message, cut short so that a big file write stays small.
STUDIO_ACTIVITY_JQ = (
    'fromjson? | select(type == "object" and .type == "assistant") '
    '| [(.message.content | if type == "array" then .[] else empty end) '
    '| select(.type == "text" or .type == "tool_use")] | last | select(. != null) '
    '| if .type == "text" then {kind: "text", text: ((.text // "") | tostring | .[0:300])} '
    'else {kind: "tool", name: (.name // "tool" | tostring), detail: ((.input.description // .input.command '
    '// .input.file_path // .input.path // .input.pattern // .input.url // .input.query // .input.prompt // "") '
    '| tostring | .[0:300])} end')


def studio_script(cfg: Config, n: Node) -> str:
    """One SSH round per VPS: its status, its jobs, and what each running session did last."""
    return (f"r={shlex.quote(root_of(cfg, n))}\n"
            f"{worker(cfg, n)} status --json\n"
            f"{worker(cfg, n)} jobs --json\n"
            "for f in \"$r\"/jobs/running/*.json; do\n"
            "  [ -e \"$f\" ] || continue\n"
            "  id=$(basename \"$f\" .json); t=\"$r/work/$id/logs/transcript.jsonl\"\n"
            "  [ -s \"$t\" ] || continue\n"
            "  m=$(stat -c %Y \"$t\" 2>/dev/null || echo 0)\n"
            f"  tail -c 200000 \"$t\" | jq -cR {shlex.quote(STUDIO_ACTIVITY_JQ)} 2>/dev/null | tail -n 1 \\\n"
            "    | jq -c --arg id \"$id\" --argjson m \"$m\" '. + {id: $id, mtime: $m}' 2>/dev/null\n"
            "done\n")


def parse_studio(out: bytes):
    """The status object, the jobs list and the activity lines of a studio_script run.
    Lines that are not JSON (a login banner, say) are skipped."""
    status, jobs, activity = None, [], {}
    for line in text(out).splitlines():
        line = line.strip()
        if not line.startswith(("{", "[")):
            continue
        try:
            doc = json.loads(line)
        except ValueError:
            continue
        if isinstance(doc, list):
            jobs = [j for j in doc if isinstance(j, dict)]
        elif isinstance(doc, dict) and isinstance(doc.get("queue"), dict):
            status = doc
        elif isinstance(doc, dict) and isinstance(doc.get("id"), str) and doc.get("kind") in ("text", "tool"):
            activity[doc["id"]] = doc
    return status, jobs, activity


def studio_base(n: Node) -> dict:
    return {"name": n.name, "channels": channel_names(n), "sessions": n.sessions}


def studio_node(cfg: Config, n: Node) -> dict:
    r = remote(cfg, n, studio_script(cfg, n), timeout=60)
    status, jobs, activity = parse_studio(r.stdout)
    if status is None:
        why = (text(r.stderr)[-300:] or f"exit {r.returncode}") if r.returncode != 0 else \
            "worker returned no status (run fleet sync)"
        return dict(studio_base(n), reachable=False, error=why)
    status["reachable"] = True
    return dict(studio_base(n), reachable=True, status=status, jobs=jobs, activity=activity)


def studio_snapshot(cfg: Config, every: int) -> dict:
    nodes = [n for n in cfg.nodes.values() if n.enabled]
    res = parallel(nodes, lambda n: studio_node(cfg, n))
    out = [r if isinstance(r, dict) else dict(studio_base(n), reachable=False, error=str(r)[:300])
           for n, r in ((n, res[n.name]) for n in nodes)]
    try:
        screenings = studio_screenings(cfg)
    except OSError:
        screenings = []
    return dict({"generated_at": now_iso(), "every": every, "fleet_version": VERSION, "nodes": out,
                 "screenings": screenings}, **studio_ideas(cfg), **studio_trends(cfg))


# The screening room: the finished videos `fleet pull` collected, which the studio plays from
# results_dir. Only these kinds of file, under a job's output folder, are ever served.
MEDIA_TYPES = {".mp4": "video/mp4", ".m4v": "video/mp4", ".mov": "video/quicktime", ".webm": "video/webm",
               ".png": "image/png", ".jpg": "image/jpeg", ".jpeg": "image/jpeg", ".webp": "image/webp", ".gif": "image/gif"}
VIDEO_TYPES = {".mp4", ".m4v", ".mov", ".webm"}
MEDIA_NAME_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9 ._+()-]{0,150}$")
MEDIA_DEPTH = 3  # output/a/b/file.mp4 at most
_media_seen: dict = {}


def media_files(out: Path) -> list:
    """The videos and pictures in a pulled job's output folder, as (relative path, size), looked
    for once per change of the folder: a render can leave thousands of frames in it."""
    try:
        key = out.stat().st_mtime_ns
    except OSError:
        return []
    seen = _media_seen.get(str(out))
    if seen and seen[0] == key:
        return seen[1]
    found, looked = [], 0
    for top, dirs, names in os.walk(out):
        rel_dir = Path(top).relative_to(out)
        if len(rel_dir.parts) >= MEDIA_DEPTH:
            dirs[:] = []
        dirs[:] = sorted(d for d in dirs if MEDIA_NAME_RE.match(d))
        for name in sorted(names):
            looked += 1
            if Path(name).suffix.lower() in MEDIA_TYPES and MEDIA_NAME_RE.match(name):
                p = Path(top) / name
                if p.is_file() and not p.is_symlink():
                    found.append((rel_dir / name, p.stat().st_size))
        if looked > 5000:
            break
    if len(_media_seen) > 500:
        _media_seen.clear()
    _media_seen[str(out)] = (key, found)
    return found


def studio_screenings(cfg: Config, limit: int = 48) -> list:
    """The newest finished jobs with a video in results_dir, from the end of its index."""
    index = cfg.results_dir / "index.jsonl"
    if not index.exists():
        return []
    with index.open("rb") as fh:
        fh.seek(max(0, index.stat().st_size - 2_000_000))
        lines = fh.read().decode("utf-8", errors="replace").splitlines()
    out, seen = [], set()
    for line in reversed(lines):
        try:
            j = json.loads(line)
        except ValueError:
            continue
        if not isinstance(j, dict):
            continue
        node, jid = str(j.get("node", "")), str(j.get("id", ""))
        if j.get("state") != "done" or j.get("pull_error") or (node, jid) in seen:
            continue
        seen.add((node, jid))
        if not NAME_RE.match(node) or not ID_RE.match(jid):
            continue
        files = media_files(cfg.results_dir / node / jid / "output")
        videos = [(rel, size) for rel, size in files if rel.suffix.lower() in VIDEO_TYPES]
        if not videos:
            continue
        # the video: one named final or video if there is one, else the biggest
        rel, size = max(videos, key=lambda v: (any(w in v[0].stem.lower() for w in ("final", "video")), v[1]))
        posters = [r for r, _ in files if r.suffix.lower() not in VIDEO_TYPES
                   and any(w in r.stem.lower() for w in ("thumb", "cover", "poster"))]
        out.append({"node": node, "id": jid, "channel": j.get("channel"), "title": j.get("title"),
                    "finished_at": j.get("finished_at"), "pulled_at": j.get("pulled_at"),
                    "video": media_url(node, jid, rel), "poster": media_url(node, jid, posters[0]) if posters else None,
                    "bytes": size})
        if len(out) >= limit:
            break
    return out


def media_url(node: str, jid: str, rel: Path) -> str:
    return "media/" + quote(node) + "/" + quote(jid) + "/" + "/".join(quote(p) for p in rel.parts)


def media_path(root: Path, path: str):
    """The file a /media/<vps>/<job>/<file> address names, or None: only a picture or a video,
    inside that job's output folder in results_dir, and no link out of it."""
    parts = [unquote(p) for p in path.split("/")]
    if len(parts) < 3 or len(parts) > 2 + MEDIA_DEPTH:
        return None
    node, jid, rel = parts[0], parts[1], parts[2:]
    if not NAME_RE.match(node) or not ID_RE.match(jid) or not all(MEDIA_NAME_RE.match(p) for p in rel):
        return None
    if Path(rel[-1]).suffix.lower() not in MEDIA_TYPES:
        return None
    base = root / node / jid / "output"
    try:
        real, home = base.joinpath(*rel).resolve(strict=True), base.resolve(strict=True)
    except (OSError, RuntimeError):
        return None
    return real if home in real.parents and real.is_file() else None


def studio_page_html() -> bytes:
    """The board (a page fragment) in a full HTML document."""
    page = STUDIO_PAGE.read_text(encoding="utf-8")
    head = ('<!doctype html>\n<html lang="en">\n<head>\n<meta charset="utf-8">\n'
            '<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">\n'
            '<style>:root{color-scheme:light;padding-top:env(safe-area-inset-top,0px);'
            'padding-bottom:env(safe-area-inset-bottom,0px)}body{margin:0;font:14px system-ui,sans-serif}'
            'img{max-width:100%}[hidden]{display:none!important}</style>\n</head>\n<body>\n')
    return (head + page + "\n</body>\n</html>\n").encode("utf-8")


def studio_files() -> dict:
    """What the studio serves, by path: the board, the pixel lot, and the script they
    share, marked live so that both ask this computer for the fleet instead of showing
    their example lot."""
    html, js = "text/html; charset=utf-8", "text/javascript; charset=utf-8"
    board = studio_page_html()
    data = b"window.FLEET_STUDIO_LIVE = true;\n" + (STUDIO_DIR / "studio-data.js").read_bytes()
    return {"/": (board, html), "/index.html": (board, html),
            "/pixel.html": ((STUDIO_DIR / "pixel.html").read_bytes(), html), "/studio-data.js": (data, js)}


def studio_host_ok(host: str, allowed: set) -> bool:
    """Answer only requests addressed to this computer by a name we know, so that a web
    page somewhere else cannot read the studio through DNS rebinding."""
    h = (host or "").strip().lower()
    if h.startswith("["):
        name = h[1:h.find("]")] if "]" in h else ""
    else:
        name = h.rsplit(":", 1)[0] if h.count(":") == 1 else h
    return bool(name) and name in allowed


def studio_handler(files: dict, state: dict, lock, allowed: set, media_root=None):
    from http.server import BaseHTTPRequestHandler

    class Handler(BaseHTTPRequestHandler):
        server_version = "fleet-studio"

        def log_message(self, fmt, *args):  # the terminal stays quiet
            pass

        def send(self, code: int, body: bytes, ctype: str):
            self.send_response(code)
            self.send_header("Content-Type", ctype)
            self.send_header("Content-Length", str(len(body)))
            self.send_header("Cache-Control", "no-store")
            self.send_header("X-Content-Type-Options", "nosniff")
            self.send_header("Referrer-Policy", "no-referrer")
            self.end_headers()
            if self.command != "HEAD":
                self.wfile.write(body)

        def do_GET(self):
            if not studio_host_ok(self.headers.get("Host", ""), allowed):
                return self.send(403, b"fleet studio answers only to this computer's own names\n",
                                 "text/plain; charset=utf-8")
            path = self.path.split("?", 1)[0]
            if path in files:
                return self.send(200, *files[path])
            if path == "/api/studio":
                with lock:
                    snap = state["snapshot"]
                return self.send(200, json.dumps(snap, default=str).encode("utf-8"), "application/json")
            if path.startswith("/media/") and media_root is not None:
                f = media_path(media_root, path[len("/media/"):])
                if f is not None:
                    return self.media(f)
            return self.send(404, b"not found\n", "text/plain; charset=utf-8")

        def media(self, f: Path):
            """A video or a picture, whole or the part a player asks for (Range)."""
            size = f.stat().st_size
            start, end, code = 0, size - 1, 200
            want = self.headers.get("Range")
            if want:
                m = re.match(r"^bytes=(\d*)-(\d*)$", want.strip())
                if m and m.group(1):
                    start, end = int(m.group(1)), min(size - 1, int(m.group(2)) if m.group(2) else size - 1)
                elif m and m.group(2):
                    start = max(0, size - int(m.group(2)))
                if not m or not (m.group(1) or m.group(2)) or start > end:
                    self.send_response(416)
                    self.send_header("Content-Range", f"bytes */{size}")
                    self.send_header("Content-Length", "0")
                    self.end_headers()
                    return
                code = 206
            self.send_response(code)
            self.send_header("Content-Type", MEDIA_TYPES[f.suffix.lower()])
            self.send_header("Content-Length", str(end - start + 1))
            self.send_header("Accept-Ranges", "bytes")
            if code == 206:
                self.send_header("Content-Range", f"bytes {start}-{end}/{size}")
            self.send_header("Cache-Control", "private, max-age=3600")
            self.send_header("X-Content-Type-Options", "nosniff")
            self.send_header("Referrer-Policy", "no-referrer")
            self.end_headers()
            if self.command == "HEAD":
                return
            try:
                with f.open("rb") as fh:
                    fh.seek(start)
                    left = end - start + 1
                    while left > 0:
                        chunk = fh.read(min(262144, left))
                        if not chunk:
                            break
                        self.wfile.write(chunk)
                        left -= len(chunk)
            except (BrokenPipeError, ConnectionResetError, ConnectionAbortedError):
                pass  # the player stopped reading: it moved on to another part

        do_HEAD = do_GET

    return Handler


def studio_server(host: str, port: int, handler):
    from http.server import ThreadingHTTPServer

    class StudioServer(ThreadingHTTPServer):
        # On Windows this option would let a second program open the same port, so a
        # busy port would be shared instead of refused.
        allow_reuse_address = not IS_WINDOWS
        allow_reuse_port = False
        daemon_threads = True

    return StudioServer((host, port), handler)


def tailscale_binary():
    if shutil.which("tailscale"):
        return shutil.which("tailscale")
    win = Path(r"C:\Program Files\Tailscale\tailscale.exe")
    return str(win) if IS_WINDOWS and win.exists() else None


def tailscale_self():
    """This computer's Tailscale IPv4 address and MagicDNS name."""
    ts = tailscale_binary()
    if not ts:
        raise FleetError("Tailscale is not installed on this computer")
    try:
        r = subprocess.run([ts, "status", "--json"], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, timeout=20)
        me = json.loads(r.stdout or b"{}").get("Self") or {}
    except (OSError, ValueError, subprocess.TimeoutExpired):
        me = {}
    ips = [ip for ip in me.get("TailscaleIPs") or [] if "." in ip]
    if not ips:
        raise FleetError("Tailscale is not connected on this computer: open Tailscale and sign in")
    return ips[0], str(me.get("DNSName") or "").rstrip(".").lower()


def cmd_studio(cfg: Config, a) -> int:
    """Serve the studio page: every VPS as a sound stage, seen from above. It only reads."""
    if a.every < 5:
        raise FleetError("--every must be at least 5 seconds")
    if a.json:
        print(json.dumps(studio_snapshot(cfg, a.every), indent=2, default=str))
        return 0
    if a.tailnet:
        host, dns = tailscale_self()
        allowed = {host, dns, dns.split(".")[0]} - {""}
        shown = dns or host
    else:
        host, allowed, shown = "127.0.0.1", LOOPBACK_NAMES, "127.0.0.1"
    lock, stop = threading.Lock(), threading.Event()
    state = {"snapshot": {"generated_at": None, "every": a.every, "fleet_version": VERSION,
                          "nodes": [dict(studio_base(n), pending=True) for n in cfg.nodes.values() if n.enabled]}}

    def look():
        while not stop.is_set():
            try:
                snap = studio_snapshot(cfg, a.every)
            except Exception as e:  # keep serving the last look
                with lock:
                    state["snapshot"] = dict(state["snapshot"], error=str(e)[:300])
            else:
                with lock:
                    state["snapshot"] = snap
            stop.wait(a.every)

    try:
        srv = studio_server(host, a.port, studio_handler(studio_files(), state, lock, allowed, cfg.results_dir))
    except OSError as e:
        raise FleetError(f"cannot open the studio on {host}:{a.port} ({e.strerror or e}). "
                         f"Another program may use that port: pick another with --port") from None
    threading.Thread(target=look, daemon=True).start()
    url = f"http://{shown}:{srv.server_address[1]}/"
    print(f"Fleet studio: {url}  (pixel lot: {url}pixel.html)\n"
          f"It looks at the VPSs every {a.every} seconds and only watches: it changes nothing.\n"
          "Press Ctrl+C to stop it.", flush=True)
    if not a.no_browser:
        import webbrowser
        opener = threading.Timer(0.5, lambda: webbrowser.open(url))
        opener.daemon = True
        opener.start()
    try:
        srv.serve_forever(poll_interval=0.5)
    except KeyboardInterrupt:
        print("\nFleet studio stopped.")
    finally:
        stop.set()
        srv.server_close()
    return 0


# --------------------------------------------------------------------------- main

