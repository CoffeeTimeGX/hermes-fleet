; Fleet inventory for the home machine.
; `fleet init` copies this to ~/.config/fleet/fleet.ini (it never overwrites it).
; Fill in public_ip for each VPS from Hostinger hPanel > VPS > Overview.
;
; host      the name your PC uses to reach the VPS. With Tailscale this is just the
;           node name (vps1, ...). A 100.x.y.z Tailscale IP works too.
; public_ip only used by `fleet bootstrap <node> --public`, before Tailscale is up.
; hostinger_account
;           a label so you remember which Hostinger login owns this VPS.
; providers which LLM tools this VPS runs (comma separated). Today: claude.
; sessions  how many Claude sessions run at the same time on this VPS. Start with 1;
;           video work is heavy (KVM 2: 1, KVM 4: 2, KVM 8: 3 or 4).
; channels  the channel this VPS makes videos for, such as Space Facts. `fleet dispatch`
;           sends a channel's jobs only to its VPS, and they wait there when it is
;           busy or at its usage limit (`fleet handover` moves them when you say so).
;           Several channels: Space Facts, History. `all`: any channel that no other
;           VPS names. Empty: only jobs sent with --to.
; enabled   false takes the VPS out of dispatching without deleting it.

[defaults]
user = fleet
remote_root = /home/fleet/fleet
results_dir = ~/fleet-results
secrets_dir = ~/.config/fleet/secrets
ssh_key = ~/.ssh/fleet_ed25519
connect_timeout = 10
; The time zone of the hours you give `fleet schedule`, such as Europe/Paris. Empty:
; your PC's. Set it on Windows, where the fleet only knows your PC's offset from UTC.
timezone =
; The YouTube quota units a day the trend looker may use (fleet trends). Google gives
; each Cloud project 10,000; one look at one channel uses 101.
trends_budget = 2000

[vps1]
host = vps1
public_ip =
hostinger_account = hostinger-account-1
providers = claude
sessions = 1
channels =
enabled = true

[vps2]
host = vps2
public_ip =
hostinger_account = hostinger-account-2
providers = claude
sessions = 1
channels =
enabled = true

[vps3]
host = vps3
public_ip =
hostinger_account = hostinger-account-3
providers = claude
sessions = 1
channels =
enabled = true

[vps4]
host = vps4
public_ip =
hostinger_account = hostinger-account-4
providers = claude
sessions = 1
channels =
enabled = true

[vps5]
host = vps5
public_ip =
hostinger_account = hostinger-account-5
providers = claude
sessions = 1
channels =
enabled = true
