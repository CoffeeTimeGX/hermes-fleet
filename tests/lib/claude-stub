#!/usr/bin/env bash
# Test stand-in for Claude Code. It understands the flags the fleet uses and
# answers like `claude -p --output-format stream-json` (or `json` for the smoke
# test), without any network access. Magic words in the prompt:
#   FAIL      the session reports an error and exits 1
#   SLEEP     the session takes 2 minutes (for cancel tests), after one tool call
#   LIST      the session writes the workspace file list to output/files.txt
#   LIMIT<n>  the account hits its usage limit, which resets in n seconds
#             (the way Claude Code 2.1.30x reports it); a --resume run succeeds
if [[ "${1:-}" == "--version" ]]; then echo "9.9.9 (Claude Code test stub)"; exit 0; fi
prompt="" format="text" resume="" args=("$@")
while [[ $# -gt 0 ]]; do
  case "$1" in
    -p) prompt="$2"; shift ;;
    --output-format) format="$2"; shift ;;
    --resume) resume="$2"; shift ;;
  esac
  shift
done
if [[ "$format" == "json" ]]; then
  jq -nc '{type:"result", subtype:"success", is_error:false, result:"OK"}'
  exit 0
fi
n=1
while [[ -e "logs/stub-args.$n.txt" ]]; do n=$((n + 1)); done
printf '%s\n' "${args[@]}" >"logs/stub-args.$n.txt"
cp "logs/stub-args.$n.txt" logs/stub-args.txt
session="${resume:-stub-$(date +%s)-$$}"
mkdir -p "$HOME/.claude/projects/stub"
echo '{"type":"user"}' >>"$HOME/.claude/projects/stub/$session.jsonl"
jq -nc --arg s "$session" '{type:"system", subtype:"init", session_id:$s}'
if [[ "$prompt" == *SLEEP* ]]; then
  # what fleet studio shows as the session's latest step
  jq -nc '{type:"assistant", message:{content:[{type:"text", text:"Rendering"},
    {type:"tool_use", name:"Bash", input:{command:"sleep 120", description:"Render the test video"}}]}}'
  sleep 120
fi
if [[ "$prompt" == *FAIL* ]]; then
  echo "stub: failing on purpose" >&2
  echo '{"type":"result","subtype":"error_during_execution","is_error":true,"result":"failed on purpose"}'
  exit 1
fi
if [[ -z "$resume" && "$prompt" =~ LIMIT([0-9]+) ]]; then
  reset=$(( $(date +%s) + BASH_REMATCH[1] ))
  msg="You've hit your session limit · resets 9pm (UTC)"
  jq -nc --argjson r "$reset" '{type:"rate_limit_event", rate_limit_info:{status:"rejected", resetsAt:$r,
    rateLimitType:"five_hour", overageStatus:"rejected", overageDisabledReason:"org_level_disabled", isUsingOverage:false}}'
  jq -nc --arg m "$msg" '{type:"assistant", error:"rate_limit", api_error:"usage_limit_reached",
    message:{content:[{type:"text", text:$m}]}}'
  jq -nc --arg m "$msg" '{type:"result", subtype:"success", is_error:true, api_error:"usage_limit_reached",
    result:$m, terminal_reason:"api_error"}'
  exit 1
fi
mkdir -p output
echo "video for: $prompt" >output/video.txt
if [[ "$prompt" == *LIST* ]]; then
  find . -path ./logs -prune -o -type f -print | sort >output/files.txt
fi
echo 'not json: the parser must skip this line'
jq -nc --arg r "Rendered 1 video for: $prompt${resume:+ (resumed $resume)}" \
  '{type:"result", subtype:"success", is_error:false, result:$r, num_turns:3, duration_ms:1200, total_cost_usd:0.42}'
